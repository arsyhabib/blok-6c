    }

    registerWatcher(statePropertyTarget, stateChangeCallbackHandler) {
      if (!this._stateChangeWatchersMap.has(statePropertyTarget)) {
        this._stateChangeWatchersMap.set(statePropertyTarget, []);
      }
      this._stateChangeWatchersMap.get(statePropertyTarget).push(stateChangeCallbackHandler);
    }

    commitStateUpdate(stateKeyProperty, targetNewValue) {
      if (!(stateKeyProperty in this._state)) {
        throw new Error("Execution Exception: State Property target key \"" + stateKeyProperty + "\" not mapped.");
      }
      var legacyPreviousValue = this._state[stateKeyProperty];
      this._state[stateKeyProperty] = targetNewValue;
      if (this._stateChangeWatchersMap.has(stateKeyProperty)) {
        this._stateChangeWatchersMap.get(stateKeyProperty).forEach(function(callback){
          setTimeout(function(){ callback(targetNewValue, legacyPreviousValue); }, 0);
        });
      }
      this.writeStateToLocalStorageCache();
    }

    initLocalStoragePersistor() {
      var historicalCacheData = localStorage.getItem("SAPIENT_ENGINE_STATE_CACHE");
      if (historicalCacheData) {
        try {
          var parsedCacheObject = JSON.parse(historicalCacheData);
          Object.keys(parsedCacheObject).forEach((key) => {
            if (key in this._state) this._state[key] = parsedCacheObject[key];
          });
        } catch (e) {
          console.error("Cache System Alert: Local Storage cache corrupted. Re-initializing matrix.", e);
        }
      }
    }

    writeStateToLocalStorageCache() {
      localStorage.setItem("SAPIENT_ENGINE_STATE_CACHE", JSON.stringify(this._state));
    }
  }

  class SAPIENTCrossModuleEventBroker {
    constructor() {
      this._eventRegistryMap = new Map();
    }

    subscribe(eventNameTarget, handlerCallbackFunction) {
      if (!this._eventRegistryMap.has(eventNameTarget)) {
        this._eventRegistryMap.set(eventNameTarget, []);
      }
      this._eventRegistryMap.get(eventNameTarget).push(handlerCallbackFunction);
    }

    publish(eventNameTarget, communicationPayload) {
      if (!this._eventRegistryMap.has(eventNameTarget)) return;
      this._eventRegistryMap.get(eventNameTarget).forEach(function(handler){
        try {
          handler(communicationPayload);
        } catch (executionException) {
          console.error("Module Communication Loop Exception inside event handler for \"" + eventNameTarget + "\":", executionException);
        }
      });
    }
  }

