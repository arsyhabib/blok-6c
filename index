/**
 * Builds multiple expandable cards from an array.
 * @param {Array} cardsArray - Array of card data
 * @param {string} slideId - Parent slide id
 * @returns {Array<HTMLElement>|null}
 */
function buildCards(cardsArray, slideId) {
  if (!cardsArray || cardsArray.length === 0) return null;
