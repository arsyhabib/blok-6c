/* ===== LIQUID GLASS — Fisik Kaca Tebal + Non-Blur Bening Jernih ===== */

/* Base: thick glass with strong blur and physical depth */
.liquid-glass {
  background: linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.04));
  background-blend-mode: luminosity;
  backdrop-filter: blur(40px) saturate(150%);
  -webkit-backdrop-filter: blur(40px) saturate(150%);
  border: 1px solid rgba(255,255,255,0.18);
  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.15),
    inset 0 -1px 1px rgba(0,0,0,0.05),
    0 8px 32px rgba(0,0,0,0.15),
    0 2px 8px rgba(0,0,0,0.1);
  position: relative;
  overflow: hidden;
}
.liquid-glass::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1.4px;
  background: linear-gradient(180deg,
    rgba(255,255,255,0.5) 0%,
    rgba(255,255,255,0.15) 20%,
    rgba(255,255,255,0) 40%,
    rgba(255,255,255,0) 60%,
    rgba(255,255,255,0.15) 80%,
    rgba(255,255,255,0.5) 100%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  mix-blend-mode: screen;
  opacity: 0.25;
}
.liquid-glass::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background:
    radial-gradient(ellipse 90% 40% at 50% 0%, rgba(255,255,255,0.18) 0%, transparent 55%),
    radial-gradient(ellipse 60% 35% at 65% 10%, rgba(0,201,255,0.06) 0%, transparent 50%);
  mix-blend-mode: overlay;
  pointer-events: none;
}

/* Non-blur variant: crystal clear with shape distortion and color refraction */
.liquid-glass-clear {
  background: linear-gradient(135deg,
    rgba(255,255,255,0.22) 0%,
    rgba(255,255,255,0.08) 40%,
    rgba(0,201,255,0.04) 60%,
    rgba(255,255,255,0.15) 100%);
  background-blend-mode: luminosity;
  backdrop-filter: blur(2px) saturate(180%) brightness(1.05);
  -webkit-backdrop-filter: blur(2px) saturate(180%) brightness(1.05);
  border: 1px solid rgba(255,255,255,0.25);
  box-shadow:
    inset 0 1px 2px rgba(255,255,255,0.25),
    inset 0 -1px 2px rgba(0,0,0,0.08),
    0 12px 40px rgba(0,0,0,0.12),
    0 4px 12px rgba(0,0,0,0.08);
  position: relative;
  overflow: hidden;
}
.liquid-glass-clear::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1.6px;
  background: linear-gradient(180deg,
    rgba(255,255,255,0.6) 0%,
    rgba(255,255,255,0.2) 15%,
    rgba(255,255,255,0) 35%,
    rgba(0,229,255,0.06) 50%,
    rgba(255,255,255,0) 65%,
    rgba(255,255,255,0.2) 85%,
    rgba(255,255,255,0.6) 100%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  mix-blend-mode: screen;
  opacity: 0.35;
}
.liquid-glass-clear::after {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  background:
    radial-gradient(ellipse 120% 50% at 30% 0%, rgba(255,255,255,0.28) 0%, transparent 50%),
    radial-gradient(ellipse 80% 45% at 70% 5%, rgba(0,229,255,0.1) 0%, transparent 45%),
    radial-gradient(ellipse 100% 40% at 50% 100%, rgba(255,255,255,0.08) 0%, transparent 40%);
  mix-blend-mode: overlay;
  pointer-events: none;
}

/* Distortion refraction effect on hover */
.liquid-glass-clear:hover::after {
  background:
    radial-gradient(ellipse 140% 55% at 35% 0%, rgba(255,255,255,0.35) 0%, transparent 50%),
    radial-gradient(ellipse 90% 50% at 65% 8%, rgba(0,229,255,0.14) 0%, transparent 45%),
    radial-gradient(ellipse 110% 45% at 50% 100%, rgba(255,255,255,0.12) 0%, transparent 40%);
  transition: background 0.4s ease;
}

/* Chromatic aberration edge — color distortion at borders */
.liquid-glass-clear .lg-edge {
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  padding: 1px;
  background: conic-gradient(
    from 0deg at 50% 50%,
    rgba(0,201,255,0.15) 0deg,
    rgba(167,139,250,0.1) 90deg,
    rgba(0,201,255,0.08) 180deg,
    rgba(52,211,153,0.1) 270deg,
    rgba(0,201,255,0.15) 360deg
  );
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  opacity: 0.4;
}

/* Light mode adjustments */
[data-theme="light"] .liquid-glass {
  background: linear-gradient(135deg, rgba(255,255,255,0.7), rgba(255,255,255,0.4));
  border-color: rgba(0,0,0,0.08);
  box-shadow:
    inset 0 1px 2px rgba(255,255,255,0.8),
    inset 0 -1px 1px rgba(0,0,0,0.03),
    0 8px 32px rgba(0,0,0,0.08),
    0 2px 8px rgba(0,0,0,0.04);
}
[data-theme="light"] .liquid-glass-clear {
  background: linear-gradient(135deg,
    rgba(255,255,255,0.85) 0%,
    rgba(255,255,255,0.6) 40%,
    rgba(0,201,255,0.06) 60%,
    rgba(255,255,255,0.7) 100%);
  border-color: rgba(0,0,0,0.1);
  box-shadow:
    inset 0 1px 3px rgba(255,255,255,0.9),
    inset 0 -1px 2px rgba(0,0,0,0.04),
    0 12px 40px rgba(0,0,0,0.08),
    0 4px 12px rgba(0,0,0,0.04);
}

