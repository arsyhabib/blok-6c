  if (current < total - 1) {
    html += '<button class="welcome-btn" onclick="nextKuisSlide()" style="padding:10px 20px;font-size:0.85rem">Berikutnya →</button>';
  } else {
    html += '<button class="welcome-btn" onclick="selesaiKuisSlide()" style="padding:10px 20px;font-size:0.85rem;background:linear-gradient(135deg,var(--accent-emerald),var(--accent-teal))">✓ Selesai</button>';
  }

  html += '</div>';

  // Review buttons (only show if there are answered questions)
  var answeredCount = Object.keys(kuisSlideState.jawaban).length;
  if (answeredCount > 0) {
    var wrongCount = 0;
    for (var k in kuisSlideState.jawaban) {
      if (kuisSlideState.jawaban[k] !== kuisSlideState.soal[k].correct) wrongCount++;
    }
    html += '<div style="display:flex;gap:10px;justify-content:center;margin-top:12px">';
    if (wrongCount > 0) {
      html += '<button class="flash-btn" onclick="reviewWrongKuisSlide()" style="background:var(--accent-rose);color:#fff">🔁 Review Salah (' + wrongCount + ')</button>';
    }
    html += '<button class="flash-btn" onclick="reviewMarkedKuisSlide()">🔖 Review Tandai</button>';
    html += '</div>';
  }

  html += '</div>';

  document.getElementById('kuisSlideBody').innerHTML = html;
}

function jawabKuisSlide(pilihanIdx) {
  var current = kuisSlideState.aktif;
  if (kuisSlideState.jawaban[current] !== undefined) return; // Sudah dijawab

  kuisSlideState.jawaban[current] = pilihanIdx;

  var soal = kuisSlideState.soal[current];
  var benar = pilihanIdx === soal.correct;

  if (benar) {
    showToast('✓ Benar!');
  } else {
    showToast('✗ Salah. Kunci: ' + String.fromCharCode(65 + soal.correct));
  }

  // Simpan skor
  var qid = kuisSlideState.slideIndex + '-' + current;
  App.skorKuis[qid] = benar ? 1 : 0;
  try { localStorage.setItem('atlas-kuis', JSON.stringify(App.skorKuis)); } catch(e){}

  renderKuisSlideSoal();
  updateDashboard();
}

function navKuisSlide(idx) {
  kuisSlideState.aktif = idx;
  renderKuisSlideSoal();
}

function nextKuisSlide() {
  if (kuisSlideState.aktif < kuisSlideState.soal.length - 1) {
    kuisSlideState.aktif++;
    renderKuisSlideSoal();
  }
}

function prevKuisSlide() {
  if (kuisSlideState.aktif > 0) {
    kuisSlideState.aktif--;
    renderKuisSlideSoal();
  }
}

function toggleMarkKuisSlide() {
  var current = kuisSlideState.aktif;
  if (kuisSlideState.marked[current]) {
    delete kuisSlideState.marked[current];
    showToast('Tanda dihapus');
  } else {
    kuisSlideState.marked[current] = true;
    showToast('Soal ditandai');
  }
  renderKuisSlideSoal();
}

function reviewWrongKuisSlide() {
  var wrongIndices = [];
  for (var k in kuisSlideState.jawaban) {
    if (kuisSlideState.jawaban[k] !== kuisSlideState.soal[k].correct) {
      wrongIndices.push(parseInt(k));
    }
  }
  if (wrongIndices.length === 0) {
    showToast('Tidak ada jawaban salah');
    return;
  }
  kuisSlideState._reviewWrong = wrongIndices;
  kuisSlideState._reviewIndex = 0;
  kuisSlideState._reviewMode = 'wrong';
  navKuisSlide(wrongIndices[0]);
}

function reviewMarkedKuisSlide() {
  var markedIndices = Object.keys(kuisSlideState.marked).map(Number);
  if (markedIndices.length === 0) {
    showToast('Tidak ada soal yang ditandai');
    return;
  }
  kuisSlideState._reviewMarked = markedIndices;
  kuisSlideState._reviewIndex = 0;
  kuisSlideState._reviewMode = 'marked';
  navKuisSlide(markedIndices[0]);
}

function selesaiKuisSlide() {
  stopKuisSlideTimer();
  kuisSlideState.sedangBerjalan = false;

  var total = kuisSlideState.soal.length;
  var benar = 0;
  var salah = 0;
  var kosong = 0;

  for (var i = 0; i < total; i++) {
    if (kuisSlideState.jawaban[i] === undefined) {
      kosong++;
    } else if (kuisSlideState.jawaban[i] === kuisSlideState.soal[i].correct) {
      benar++;
    } else {
      salah++;
    }
  }

  var pct = total > 0 ? Math.round(benar / total * 100) : 0;
  var grade = pct >= 90 ? 'A' : pct >= 80 ? 'B' : pct >= 70 ? 'C' : pct >= 60 ? 'D' : 'E';
  var gradeColor = pct >= 80 ? 'var(--accent-emerald)' : pct >= 60 ? 'var(--accent-amber)' : 'var(--accent-rose)';
  var pesan = pct >= 90 ? '🌟 Luar biasa! Penguasaan sempurna!' : pct >= 80 ? '👍 Bagus! Pemahaman sudah baik.' : pct >= 60 ? '💪 Cukup baik, perlu latihan lagi.' : '📚 Perlu belajar lebih giat lagi.';

  // Build result map dots
  var mapHtml = '<div style="display:flex;flex-wrap:wrap;gap:6px;justify-content:center;margin:16px 0">';
  for (var i = 0; i < total; i++) {
    var ans = kuisSlideState.jawaban[i];
    var correct = kuisSlideState.soal[i].correct;
    var dotClass = 'kuis-map-dot';
    if (ans === undefined) dotClass += ' kuis-map-unanswered';
    else if (ans === correct) dotClass += ' kuis-map-correct';
    else dotClass += ' kuis-map-wrong';
    mapHtml += '<div class="' + dotClass + '" title="Soal ' + (i + 1) + '" onclick="navKuisSlide(' + i + ');renderKuisSlideSoal();" style="cursor:pointer">' + (i + 1) + '</div>';
  }
  mapHtml += '</div>';

  var html = '<div style="text-align:center;padding:20px 10px">' +
    '<div style="font-size:4rem;font-weight:900;background:linear-gradient(135deg,var(--accent-teal),var(--accent-cyan),var(--accent-violet));-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1;margin-bottom:4px">' + grade + '</div>' +
    '<div style="font-size:2.2rem;font-weight:800;color:' + gradeColor + ';margin-bottom:4px">' + pct + '%</div>' +
    '<div style="font-size:0.95rem;color:var(--text-secondary);margin-bottom:8px">' + benar + ' benar / ' + salah + ' salah / ' + kosong + ' kosong dari ' + total + ' soal</div>' +
    '<div style="font-size:0.88rem;color:var(--text-muted);margin-bottom:16px">' + pesan + '</div>' +
    mapHtml +
    '<div style="display:flex;gap:10px;justify-content:center;margin-top:20px;flex-wrap:wrap">' +
    '<button class="welcome-btn" onclick="mulaiKuisSlide()" style="padding:10px 24px;font-size:0.9rem">🔄 Ulangi Kuis</button>' +
    '<button class="welcome-btn" onclick="tutupKuisSlide()" style="padding:10px 24px;font-size:0.9rem;background:var(--bg-elevated);color:var(--text-primary)">✕ Tutup</button>' +
    '</div>' +
    '</div>';

  document.getElementById('kuisSlideBody').innerHTML = html;

  // Hide timer
  var timerEl = document.getElementById('kuisSlideTimer');
  if (timerEl) timerEl.style.display = 'none';

  // Save to dashboard
  updateDashboard();
}

