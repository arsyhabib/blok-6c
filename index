// Add close button to QRP if not present
function _ensureQRPClose() {
  var qrp = document.getElementById('qrpOverlay');
  if (qrp && !qrp.querySelector('.qrp-close-x')) {
    var btn = document.createElement('button');
    btn.className = 'qrp-close-x';
    btn.innerHTML = '✕';
    btn.setAttribute('aria-label', 'Tutup');
    btn.onclick = function() { qrp.classList.remove('open'); };
    qrp.insertBefore(btn, qrp.firstChild);
  }
}


function buildSlideHeadbars() {
  var slides = document.querySelectorAll('.slide-section');
  var totalSlides = slides.length;
  slides.forEach(function(slide, idx) {
    // Skip if already built
    if (slide.querySelector('.slide-headbar')) return;
    var title = slide.getAttribute('data-title') || 'Slide';
    // Try to get subtitle from existing .slide-subtitle child
    var subEl = slide.querySelector('.slide-subtitle');
    var desc = subEl ? subEl.textContent.trim() : '';
    // For slide-0 (home), use different label
    var numStr;
    var isHome = (slide.id === 'slide-0');
    if (isHome) {
      numStr = '🏠';
    } else {
      numStr = (idx < 10 ? '0' + idx : '' + idx);
    }
    
    var headbar = document.createElement('div');
    headbar.className = 'slide-headbar';
    headbar.innerHTML =
      '<div class="slide-headbar-num' + (isHome ? ' home' : '') + '">' + numStr + '</div>' +
      '<div class="slide-headbar-text">' +
        '<div class="slide-headbar-title">' + escapeHtml(title) + '</div>' +
        (desc ? '<div class="slide-headbar-desc">' + escapeHtml(desc) + '</div>' : '') +
      '</div>' +
      '<div class="slide-headbar-progress">' + (idx + 1) + ' / ' + totalSlides + '</div>';
    // Insert at the very top of the slide section
    slide.insertBefore(headbar, slide.firstChild);
  });
}


