// ========================================================
// FAB v4 — Simple, reliable, drag+click with expand panel
// ========================================================
(function() {
  'use strict';
  var wrapper, mainBtn, menu;
  var dragStartX, dragStartY, wrapperStartX, wrapperStartY;
  var dragging = false, moved = false;
  var MOVE_THRESHOLD = 6; // px before considered a drag

  function init() {
    wrapper = document.getElementById('fabWrapper');
    mainBtn = document.getElementById('fabMainBtn');
    menu = document.getElementById('fabMenu');
    if (!wrapper || !mainBtn || !menu) {
      // Retry
      setTimeout(init, 200);
      return;
    }

    // Build chrome grid
    buildGrid();

    // Inject expand button at top of menu
    if (!menu.querySelector('.fab-expand-btn')) {
      var expBtn = document.createElement('button');
      expBtn.type = 'button';
      expBtn.className = 'fab-expand-btn';
      expBtn.innerHTML = '<svg width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>&nbsp;Lihat Semua Fitur';
      expBtn.addEventListener('click', function(e) {
        e.stopPropagation();
        bukaGrid();
      });
      menu.insertBefore(expBtn, menu.firstChild);
    }

    // Load saved drag position
    try {
      var pos = JSON.parse(localStorage.getItem('fab-pos') || 'null');
      if (pos) setPos(pos.l, pos.t);
    } catch(e) {}

    // Attach events — Pointer Events for true 2D free drag (mouse + touch unified)
    mainBtn.addEventListener('pointerdown', onDown);

    // ESC closes everything
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') { close(); closeGrid(); }
    });
  }

  function onDown(e) {
    dragStartX = e.clientX;
    dragStartY = e.clientY;
    var r = wrapper.getBoundingClientRect();
    wrapperStartX = r.left;
    wrapperStartY = r.top;
    moved = false;
    dragging = false;
    mainBtn.setPointerCapture(e.pointerId);
    mainBtn.addEventListener('pointermove', onMove);
    mainBtn.addEventListener('pointerup', onUp);
    mainBtn.addEventListener('pointercancel', onUp);
  }

  function onMove(e) {
    var dx = e.clientX - dragStartX;
    var dy = e.clientY - dragStartY;
    if (!dragging && (Math.abs(dx) > MOVE_THRESHOLD || Math.abs(dy) > MOVE_THRESHOLD)) {
      dragging = true;
      moved = true;
      window._fabMoved = true;
      wrapper.classList.add('dragging');
      close();
    }
    if (dragging) {
      setPos(wrapperStartX + dx, wrapperStartY + dy);
    }
  }

  function onUp(e) {
    mainBtn.removeEventListener('pointermove', onMove);
    mainBtn.removeEventListener('pointerup', onUp);
    mainBtn.removeEventListener('pointercancel', onUp);
    try { mainBtn.releasePointerCapture(e.pointerId); } catch(_) {}
    wrapper.classList.remove('dragging');
    if (dragging) {
      var r = wrapper.getBoundingClientRect();
      try { localStorage.setItem('fab-pos', JSON.stringify({ l: r.left, t: r.top })); } catch(e2) {}
    }
    dragging = false;
  }

  function setPos(l, t) {
    var vw = window.innerWidth, vh = window.innerHeight;
    var W = wrapper.offsetWidth || 60, H = wrapper.offsetHeight || 60;
    l = Math.max(8, Math.min(vw - W - 8, l));
    t = Math.max(60, Math.min(vh - H - 8, t));
    // Use setProperty('important') to override stylesheet !important rules
    wrapper.style.setProperty('left', l + 'px', 'important');
    wrapper.style.setProperty('top', t + 'px', 'important');
    wrapper.style.setProperty('right', 'auto', 'important');
    wrapper.style.setProperty('bottom', 'auto', 'important');
  }

  function open() {
    // Ensure menu is positioned correctly based on wrapper position
    var r = wrapper.getBoundingClientRect();
    var vh = window.innerHeight;
    // If FAB is in bottom half, menu goes up (already default via bottom: calc(100%+14px))
    // If FAB is in top half, menu goes down
    if (r.top < vh * 0.4) {
      menu.style.bottom = 'auto';
      menu.style.top = 'calc(100% + 14px)';
    } else {
      menu.style.top = 'auto';
      menu.style.bottom = 'calc(100% + 14px)';
    }
    // Horizontal: keep right-aligned (default), but if too close to left edge flip
    var vw = window.innerWidth;
    if (r.left < vw * 0.4) {
      menu.style.right = 'auto';
      menu.style.left = '0';
    } else {
      menu.style.left = 'auto';
      menu.style.right = '0';
    }
    wrapper.classList.add('fab-open');
  }

  function close() {
    wrapper.classList.remove('fab-open');
  }

  function buildGrid() {
    var grid = document.getElementById('gridPanelGrid');
    if (!grid || grid.children.length > 0) return; // already built
    var items = (wrapper || document.getElementById('fabWrapper')).querySelectorAll('.fab-item-wrap');
    items.forEach(function(item) {
      var title = item.getAttribute('title') || '';
      var short = title.split('(')[0].trim();
      if (short.length > 18) short = short.substring(0, 16) + '…';
      var iconEl = item.querySelector('.fab-item-icon');
      var iconHTML = iconEl ? iconEl.innerHTML : '⚙️';
      var onclick = item.getAttribute('onclick') || '';
      var cell = document.createElement('div');
      cell.className = 'grid-cell';
      cell.setAttribute('title', title);
      cell.innerHTML =
        '<div class="grid-cell-icon">' + iconHTML + '</div>' +
        '<div class="grid-cell-label">' + escapeHtml(short) + '</div>';
      cell.addEventListener('click', function() {
        closeGrid();
        close();
        // Execute the feature's function
        var fn = onclick.replace(/tutupSmartFab\(\);?/g, '').trim();
        if (fn) {
          try { eval(fn); } catch(err) { console.warn('FAB grid action error:', err); }
        }
      });
      grid.appendChild(cell);
    });
  }

  function bukaGrid() {
    var panel = document.getElementById('fabGridPanel');
    if (!panel) return;
    // Position panel near the FAB
    var r = wrapper.getBoundingClientRect();
    var vw = window.innerWidth, vh = window.innerHeight;
    var pw = 360, ph = 520;
    var left = r.left - pw / 2 + r.width / 2;
    var top = r.top - ph - 16;
    if (top < 64) top = r.bottom + 12;
    if (left + pw > vw - 12) left = vw - pw - 12;
    if (left < 8) left = 8;
    if (top + ph > vh - 12) top = Math.max(64, vh - ph - 12);
    panel.style.left = left + 'px';
    panel.style.top = top + 'px';
    panel.style.right = 'auto';
    panel.style.bottom = 'auto';
    panel.classList.add('show');
    close(); // close compact menu
  }

  function closeGrid() {
    var panel = document.getElementById('fabGridPanel');
    if (panel) panel.classList.remove('show');
  }

  // Expose globals
  window.tutupSmartFab = close;
  window.toggleFabMenu = function() {
    if (!wrapper) { wrapper = document.getElementById('fabWrapper'); }
    if (wrapper.classList.contains('fab-open')) close();
    else open();
  };
  window.bukaGridPanel = bukaGrid;
  window.tutupGridPanel = closeGrid;

  // Initialize
  if (document.readyState !== 'loading') setTimeout(init, 200);
  else document.addEventListener('DOMContentLoaded', function() { setTimeout(init, 200); });
})();





