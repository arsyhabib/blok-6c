l."},{"term":"Melanoma uvea","arti":"Tumor intraokular primer tersering dewasa","penjelasan":"Choroid > ciliary body > iris. Sel spindle (baik) atau epithelioid (buruk). COMS staging. Enucleation atau plaque radiotherapy."}],"terms":[{"term":"Nasolacrimal drainage","arti":"Sistem drainase air mata dari konjungtiva ke hidung","penjelasan":"Saluran pembuangan air mata ke hidung"},{"term":"Precorneal tear film","arti":"Lapisan air mata yang menutupi kornea","penjelasan":"Lapisan cairan pelindung di permukaan kornea"},{"term":"Prodrug","arti":"Obat tidak aktif yang dikonversi menjadi aktif di tubuh","penjelasan":"Obat yang baru aktif setelah diubah tubuh"},{"term":"Corneal penetration","arti":"Kemampuan obat menembus kornea","penjelasan":"Obat masuk ke dalam kornea"},{"term":"Intraocular pressure (IOP)","arti":"Tekanan di dalam mata, normal 10-21 mmHg","penjelasan":"Tekanan di dalam bola mata"},{"term":"Aqueous humor","arti":"Cairan bening yang mengisi bilik mata depan dan posterior","penjelasan":"Cairan pelumas di dalam mata"},{"term":"Trabecular meshwork","arti":"Jaringan pembuangan aqueous humor di sudut anterior","penjelasan":"Saringan pembuangan cairan mata"},{"term":"Lipogranuloma","arti":"Granuloma yang mengandung lemak, khas kalazion","penjelasan":"Benjolan radang yang berisi lemak"},{"term":"Rosette","arti":"Susunan sel tumor dalam pola melingkar","penjelasan":"Sel tumor tersusun melingkar"},{"term":"Leukokoria","arti":"Refleks pupil putih sebagai pengganti refleks merah normal","penjelasan":"Pupil terlihat putih"}],"media":[{"mediaId":"media-slide-16-1","caption":"Tabel obat glaukoma dan mekanisme kerja","placement":"card-body"},{"mediaId":"media-slide-16-2","caption":"MRI orbita: axial T1-weighted post-contrast","placement":"card-body"}],"crosslinks":[{"label":"Glaukoma → Obat-obatan","targetSlideId":"slide-14","reason":"Terapi glaukoma menggunakan obat-obatan autonomic agents"},{"label":"Retinopati DM → Anti-VEGF","targetSlideId":"slide-14","reason":"Anti-VE