/**
 * Escapes HTML special characters to prevent XSS.
 * @param {string} str
 * @returns {string}
 */
function escapeHtml(str) {
  if (typeof str !== 'string') return '';
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

/**
 * Helper: creates a DOM element with optional class, attributes, and innerHTML.
 * @param {string} tag
 * @param {string} [className]
 * @param {Object} [attrs] - Key-value pairs for attributes
 * @param {string} [innerHTML]
 * @returns {HTMLElement}
 */
function createElement(tag, className, attrs, innerHTML) {
  const el = document.createElement(tag);
  if (className) el.className = className;
  if (attrs) {
    Object.keys(attrs).forEach(k => {
      if (k === 'dataset') {
        Object.keys(attrs[k]).forEach(dk => { el.dataset[dk] = attrs[k][dk]; });
      } else if (k.startsWith('on') && typeof attrs[k] === 'string') {
        el.setAttribute(k, attrs[k]);
      } else {
        el.setAttribute(k, attrs[k]);
      }
    });
  }
  if (innerHTML !== undefined) el.innerHTML = innerHTML;
  return el;
}

/**
 * Pre-flight validation for slide data.
 * @param {Object} slideData
 * @returns {Array<string>} Array of error messages (empty = valid)
 */
function validateSlideData(slideData) {
  const errors = [];

  if (!slideData || typeof slideData !== 'object') {
    errors.push('slideData must be an object');
    return errors;
  }
  if (!Array.isArray(slideData.slides)) {
    errors.push('slideData.slides must be an array');
    return errors;
  }

  const ids = new Set();
  slideData.slides.forEach((slide, idx) => {
    const prefix = `slides[${idx}]`;

    // Required fields
    if (!slide.id) errors.push(`${prefix}: missing "id"`);
    if (!slide.title) errors.push(`${prefix}: missing "title"`);

    // ID uniqueness
    if (slide.id) {
      if (ids.has(slide.id)) errors.push(`${prefix}: duplicate id "${slide.id}"`);
      ids.add(slide.id);
    }

    // ID format
    if (slide.id && !/^slide-[0-9]+$/.test(slide.id)) {
      errors.push(`${prefix}: id "${slide.id}" must match pattern "slide-N"`);
    }

    // Quiz validation
    if (slide.quizzes) {
      if (!Array.isArray(slide.quizzes)) {
        errors.push(`${prefix}: quizzes must be an array`);
      } else {
        slide.quizzes.forEach((q, qIdx) => {
          const qPrefix = `${prefix}.quizzes[${qIdx}]`;
          if (!q.question) errors.push(`${qPrefix}: missing "question"`);
          if (!Array.isArray(q.options) || q.options.length !== 4) {
            errors.push(`${qPrefix}: options must be an array of length 4`);
          }
          if (typeof q.correct !== 'number' || q.correct < 0 || q.correct > 3) {
            errors.push(`${qPrefix}: correct must be an integer 0-3`);
          }
          if (!q.explanation) errors.push(`${qPrefix}: missing "explanation"`);
        });
      }
    }

    // Cards validation
    if (slide.cards) {
      if (!Array.isArray(slide.cards)) {
        errors.push(`${prefix}: cards must be an array`);
      } else {
        slide.cards.forEach((c, cIdx) => {
          const cPrefix = `${prefix}.cards[${cIdx}]`;
          if (!c.id) errors.push(`${cPrefix}: missing "id"`);
          if (!c.number) errors.push(`${cPrefix}: missing "number"`);
          if (!c.title) errors.push(`${cPrefix}: missing "title"`);
        });
      }
    }

    // Table validation
    if (slide.tables) {
      if (!Array.isArray(slide.tables)) {
        errors.push(`${prefix}: tables must be an array`);
      } else {
        slide.tables.forEach((t, tIdx) => {
          const tPrefix = `${prefix}.tables[${tIdx}]`;
          if (!Array.isArray(t.headers)) errors.push(`${tPrefix}: missing "headers" array`);
          if (!Array.isArray(t.rows)) errors.push(`${tPrefix}: missing "rows" array`);
        });
      }
    }
  });

  return errors;
}

