function lakukanPencarianOverlay(q) {
  const hasilEl = document.getElementById('cariHasil');
  const statsEl = document.getElementById('cariStats');
  if (!q || q.length < 2) { hasilEl.innerHTML = ''; statsEl.textContent = ''; return; }

  const qlower = q.toLowerCase();
  const hasil = [];

  indeksCari.forEach(item => {
    let skor = 0;
    if (item.heading.toLowerCase().includes(qlower)) skor += 10;
    if (item.body.toLowerCase().includes(qlower)) skor += 5;
    if (item.title.toLowerCase().includes(qlower)) skor += 3;
    if (skor > 0) {
      // Find preview context
      let preview = '';
      const idx = item.body.toLowerCase().indexOf(qlower);
      if (idx >= 0) {
        const start = Math.max(0, idx - 60);
        const end = Math.min(item.body.length, idx + q.length + 60);
        preview = item.body.substring(start, end);
      } else {
        preview = item.body.substring(0, 120);
      }
      hasil.push({ ...item, skor, preview });
    }
  });

  hasil.sort((a, b) => b.skor - a.skor);

  if (hasil.length === 0) {
    hasilEl.innerHTML = '<div class="cari-kosong">Tidak ada hasil untuk &quot;' + q + '&quot;</div>';
    statsEl.textContent = '0 hasil';
    return;
  }

  let html = '';
  hasil.forEach(h => {
    const highlight = h.preview.replace(new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi'), '<span class="cari-item-match">$1</span>');
    html += '<div class="cari-item" onclick="goToSlide(' + h.slide + ');bukaEkspansi(\'' + h.el + '\');tutupCari();">' +
      '<div class="cari-item-judul">' + h.title + ' &mdash; ' + h.heading + '</div>' +
      '<div class="cari-item-preview">' + highlight + '</div></div>';
  });
  hasilEl.innerHTML = html;
  statsEl.textContent = hasil.length + ' hasil ditemukan';
}

