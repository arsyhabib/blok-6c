/**
 * Builds the action bar: .slide-aksi-bar > .aksi-cell[]
 * @param {Array} actionsArray - Array of {icon, label, sub, target, url}
 * @returns {HTMLElement|null}
 */
function buildAksiBar(actionsArray, slideQuizzes) {
  if (!actionsArray || actionsArray.length === 0) return null;

  const bar = document.createElement('div');
  bar.className = 'slide-aksi-bar';

  actionsArray.forEach((action, idx) => {
    const cell = document.createElement('div');
    cell.className = 'aksi-cell';

    // Build onclick handler
    let handler = '';
    if (action.target === 'slide' && typeof action.targetIndex === 'number') {
      handler = `goToSlide(${action.targetIndex})`;
    } else if (action.target === 'flashcard') {
      handler = `bukaFlashcard()`;
    } else if (action.target === 'stress') {
      handler = `bukaStress()`;
    } else if (action.target === 'dashboard') {
      handler = `bukaDashboard()`;
    } else if (action.target === 'quiz') {
      handler = `bukaKuisSlide()`;
    } else if (action.url) {
      handler = `window.open('${escapeHtml(action.url)}','_blank')`;
    }
    if (handler) cell.setAttribute('onclick', handler);

    const icon = document.createElement('div');
    icon.className = 'aksi-icon';
    icon.textContent = action.icon;
    cell.appendChild(icon);

    const info = document.createElement('div');
    info.className = 'aksi-info';

    const lbl = document.createElement('div');
    lbl.className = 'aksi-lbl';
    lbl.textContent = action.label;
    info.appendChild(lbl);

    if (action.sub) {
      const sub = document.createElement('div');
      sub.className = 'aksi-sub';
      sub.textContent = action.sub;
      info.appendChild(sub);
    }
    cell.appendChild(info);
    bar.appendChild(cell);
  });

  return bar;
}

