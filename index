// AUTO-INIT: Listen for window.SLIDE_DATA
// ============================================================

// If SLIDE_DATA is already set, render immediately
if (typeof window !== 'undefined' && window.SLIDE_DATA) {
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => renderSlides(window.SLIDE_DATA));
  } else {
    renderSlides(window.SLIDE_DATA);
  }
}

// Also listen for late assignment (e.g., from async JSON load)
Object.defineProperty(window, 'SLIDE_DATA', {
  configurable: true,
  enumerable: true,
  get() { return this._SLIDE_DATA; },
  set(v) {
    this._SLIDE_DATA = v;
    if (v && document.getElementById('dynamicSlides')) {
      renderSlides(v);
    }
