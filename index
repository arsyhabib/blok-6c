function navKeyboard(e) {
  var target = e.target || {};
  if (/INPUT|TEXTAREA|SELECT/i.test(target.tagName || '') || target.isContentEditable) return;
  switch(e.key) {
    case 'ArrowRight': case 'PageDown':
      e.preventDefault(); if (typeof goToSlide === 'function') goToSlide(App.slideAktif + 1); break;
    case 'ArrowLeft': case 'PageUp':
      e.preventDefault(); if (typeof goToSlide === 'function') goToSlide(App.slideAktif - 1); break;
    case 'Home':
      e.preventDefault(); if (typeof goToSlide === 'function') goToSlide(0); break;
    case 'End':
      e.preventDefault(); if (typeof goToSlide === 'function') goToSlide(App.totalSlide - 1); break;
    case 'f': case 'F':
      if (typeof bukaCari === 'function') bukaCari(); break;
    case 'b': case 'B':
      if (typeof toggleBookmark === 'function') toggleBookmark(); break;
    case 'd': case 'D':
      if (typeof bukaDashboard === 'function') bukaDashboard(); break;
    case 's': case 'S':
      if (!e.ctrlKey && typeof toggleSimpel === 'function') toggleSimpel(); break;
    case 'Escape':
      if (typeof tutupSemuaOverlay === 'function') tutupSemuaOverlay(); break;
  }
}

