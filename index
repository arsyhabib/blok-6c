    var graph = window.SAPIENT_CONTENT_LINK_GRAPH || {};
    var assets = ["search","dashboard","flashcard","quiz","notes","bookmark","atlas","login","tutorial","device","mobile","desktop","tablet","auto","close","export","audit","crosslink"].filter(function(name){ return true; });
    add("dynamicSlides exists once", $all("#dynamicSlides").length === 1, $all("#dynamicSlides").length);
