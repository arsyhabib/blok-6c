<!-- B. DESIGN TOKENS + C. RESET & BASE are above. Legacy visual system follows, preserved from source. -->
<style>

:root {
  --sat: env(safe-area-inset-top);
  --sar: env(safe-area-inset-right);
  --sab: env(safe-area-inset-bottom);
  --sal: env(safe-area-inset-left);
}
/* ===== DESIGN SYSTEM ===== */
:root {
  --bg-void:#0a0e1a;--bg-card:#121a2e;--bg-elevated:#1a2540;
  --text-primary:#e8ecf1;--text-secondary:#94a3b8;--text-muted:#64748b;
  --accent-teal:#00c9ff;--accent-cyan:#00e5ff;--accent-blue:#4facfe;
  --accent-indigo:#00f2fe;--accent-violet:#a78bfa;--accent-rose:#fb7185;
  --accent-amber:#fbbf24;--accent-emerald:#34d399;--accent-lime:#a3e635;
  --glass-bg:rgba(18,26,46,0.85);--glass-border:rgba(255,255,255,0.08);
  --shadow-lg:0 25px 50px -12px rgba(0,0,0,0.5);
  --radius-sm:8px;--radius-md:12px;--radius-lg:16px;--radius-xl:20px;
  --transition:all 0.3s cubic-bezier(0.4,0,0.2,1);
  --font-sans:'Segoe UI',system-ui,-apple-system,sans-serif;
  --sidebar-width:320px;--header-height:64px;
}
[data-theme="light"] {
  --bg-void:#f0f4f8;--bg-card:#ffffff;--bg-elevated:#e8f0f8;
  --text-primary:#0c1220;--text-secondary:#1e3048;--text-muted:#4a5f78;
  --glass-bg:rgba(255,255,255,0.96);--glass-border:rgba(15,30,60,0.14);
  --accent-teal:#0077a8;--accent-cyan:#0091b5;--accent-blue:#2563eb;
  --accent-indigo:#3730a3;--accent-violet:#6d28d9;--accent-rose:#be123c;
  --accent-amber:#92400e;--accent-emerald:#065f46;--accent-lime:#365314;
  --shadow-lg:0 25px 50px -12px rgba(15,30,60,0.18);
}

/* ===== RESET & BASE ===== */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{
  font-family:var(--font-sans);background:var(--bg-void);color:var(--text-primary);
  line-height:1.7;overflow-x:hidden;transition:var(--transition);
  -webkit-font-smoothing:antialiased;
  overscroll-behavior-y:auto; /* Natural bouncy overscroll, no auto slide change */
}
/* Prevent any swipe-based slide navigation globally */
html, body, .main-content {
  overscroll-behavior-x: none;
  touch-action: pan-y pinch-zoom;
}
a{color:var(--accent-teal);text-decoration:none}
img{max-width:100%;height:auto;border-radius:var(--radius-sm)}

/* ===== LAYOUT ===== */
.app-shell{display:none;min-height:100vh}
.app-shell.app-active{display:flex}
.main-content{
  flex:1;margin-left:var(--sidebar-width);
  transition:var(--transition);min-height:100vh;
  position:relative;padding-bottom:56px;
}
.main-content.sidebar-collapsed{margin-left:0}

/* ===== SIDEBAR ===== */
.sidebar{
  position:fixed;top:0;left:0;width:var(--sidebar-width);height:100vh;
  background:var(--bg-card);border-right:1px solid var(--glass-border);
  z-index:100;overflow-y:auto;overflow-x:hidden;
  transition:var(--transition);display:flex;flex-direction:column;
}
.sidebar-collapsed .sidebar{transform:translateX(-100%)}
.sidebar-collapsed .main-content{margin-left:0}
.sidebar-header{
  padding:20px 16px;border-bottom:1px solid var(--glass-border);
  position:sticky;top:0;background:var(--bg-card);z-index:5;
}
.sidebar-logo{
  font-size:1.15rem;font-weight:800;background:linear-gradient(135deg,var(--accent-teal),var(--accent-cyan));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;display:flex;align-items:center;gap:10px;
}
.sidebar-logo svg{width:28px;height:28px;flex-shrink:0}
.sidebar-subtitle{font-size:0.7rem;color:var(--text-muted);margin-top:4px;text-transform:uppercase;letter-spacing:1px}

/* Sidebar Search - Fixed positioning */
.sidebar-search{position:relative;margin:12px 16px;z-index:1}
.sidebar-search input{padding-right:14px}
.sidebar-search input{
  width:100%;padding:10px 14px 10px 38px;border-radius:var(--radius-sm);
  border:1px solid var(--glass-border);background:var(--bg-void);
  color:var(--text-primary);font-size:0.85rem;outline:none;transition:var(--transition);
}
.sidebar-search input:focus{border-color:var(--accent-teal);box-shadow:0 0 0 3px rgba(0,201,255,0.15)}
.sidebar-search svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-muted);width:16px;height:16px}

/* Nav Tree */
.nav-tree{flex:1;padding:8px 0}
.nav-item{position:relative}
.nav-link{
  display:flex;align-items:center;gap:10px;padding:10px 16px;
  color:var(--text-secondary);font-size:0.85rem;cursor:pointer;
  transition:var(--transition);border-left:3px solid transparent;
  text-decoration:none;
}
.nav-link:hover,.nav-link.active{
  background:rgba(0,201,255,0.06);color:var(--accent-teal);
  border-left-color:var(--accent-teal);
}
.nav-link .num{
  min-width:26px;height:26px;border-radius:6px;background:var(--bg-elevated);
  display:flex;align-items:center;justify-content:center;font-size:0.7rem;
  font-weight:700;color:var(--accent-teal);flex-shrink:0;
}
.nav-link.active .num{background:var(--accent-teal);color:#fff}
.nav-toggle{
  margin-left:auto;width:20px;height:20px;border-radius:4px;
  display:flex;align-items:center;justify-content:center;
  transition:var(--transition);flex-shrink:0;cursor:pointer;color:var(--text-muted);
}
.nav-toggle:hover{background:rgba(0,201,255,0.1);color:var(--accent-teal)}
.nav-toggle.collapsed svg{transform:rotate(-90deg)}
.nav-children{
  max-height:500px;overflow:hidden;transition:max-height 0.3s ease;
  padding-left:12px;
}
.nav-children.collapsed{max-height:0}
.nav-child-link{
  display:block;padding:7px 16px 7px 42px;font-size:0.78rem;
  color:var(--text-muted);cursor:pointer;transition:var(--transition);
  border-left:1px solid var(--glass-border);text-decoration:none;
}
.nav-child-link:hover,.nav-child-link.active{color:var(--accent-teal);background:rgba(0,201,255,0.04)}

/* Sidebar Footer */
.sidebar-footer{
  padding:12px 16px;border-top:1px solid var(--glass-border);
  font-size:0.7rem;color:var(--text-muted);text-align:center;
  background:var(--bg-card);position:relative;z-index:1;
  overflow-x:hidden;
}
.logout-btn { margin-top: 8px; width: 100%; max-width: 100%; box-sizing: border-box; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 8px; border-radius: var(--radius-sm); font-size: 0.82rem; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; position: relative; z-index: 1; overflow: hidden; }
.logout-btn:hover { background: rgba(239, 68, 68, 0.2); transform: scale(1.01); }
.user-badge { display: flex; align-items: center; gap: 6px; padding: 8px 10px; background: linear-gradient(135deg, rgba(94,234,212,0.1), rgba(6,182,212,0.1)); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); margin: 8px 0; font-size: 0.8rem; color: var(--accent-teal); position: relative; z-index: 1; overflow: hidden; white-space: nowrap; }

/* ===== HEADER ===== */
.topbar{
  position:sticky;top:0;z-index:500;background:var(--glass-bg);
  backdrop-filter:blur(20px) saturate(180%);border-bottom:1px solid var(--glass-border);
  padding:0 24px;height:var(--header-height);display:flex;align-items:center;gap:16px;
}
.topbar-btn{
  width:36px;height:36px;border-radius:var(--radius-sm);border:1px solid var(--glass-border);
  background:var(--bg-card);color:var(--text-secondary);display:flex;align-items:center;justify-content:center;
  cursor:pointer;transition:var(--transition);flex-shrink:0;
}
.topbar-btn:hover{background:rgba(0,201,255,0.1);color:var(--accent-teal);border-color:var(--accent-teal)}
.breadcrumb{font-size:0.82rem;color:var(--text-muted);flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.breadcrumb span{color:var(--accent-teal)}
.zoom-controls{display:flex;align-items:center;gap:8px}
.zoom-slider{-webkit-appearance:none;appearance:none;width:100px;height:4px;border-radius:2px;background:var(--bg-elevated);outline:none}
.zoom-slider::-webkit-slider-thumb{-webkit-appearance:none;width:14px;height:14px;border-radius:50%;background:var(--accent-teal);cursor:pointer}
.zoom-label{font-size:0.7rem;color:var(--text-muted);min-width:36px;text-align:center}

/* ===== SLIDES ===== */
.slide-section{
  display:none;padding:32px 40px 60px;max-width:960px;margin:0 auto;
  animation:fadeSlide 0.4s ease;
}
.slide-section.active{display:block}
@keyframes fadeSlide{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

/* ===== CONTENT COMPONENTS ===== */
.slide-title{
  font-size:1.8rem;font-weight:800;margin-bottom:8px;
  background:linear-gradient(135deg,var(--accent-teal),var(--accent-cyan));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.slide-subtitle{font-size:0.9rem;color:var(--text-secondary);margin-bottom:24px;font-style:italic}

/* Expandable Card System */
.ekspansi-kartu{
  background:var(--bg-card);border:1px solid var(--glass-border);
  border-radius:var(--radius-md);margin-bottom:12px;overflow:hidden;
  transition:var(--transition);
}
.ekspansi-kartu:hover{border-color:rgba(0,201,255,0.2)}
.ekspansi-header{
  display:flex;align-items:center;gap:12px;padding:14px 18px;
  cursor:pointer;transition:var(--transition);user-select:none;
}
.ekspansi-header:hover{background:rgba(0,201,255,0.04)}
.ekspansi-icon{
  width:32px;height:32px;border-radius:8px;background:linear-gradient(135deg,var(--accent-teal),var(--accent-blue));
  display:flex;align-items:center;justify-content:center;color:#fff;font-size:0.85rem;flex-shrink:0;
}
.ekspansi-title{flex:1;font-weight:600;font-size:0.92rem}
.ekspansi-badge{
  font-size:0.65rem;padding:3px 8px;border-radius:20px;background:rgba(0,201,255,0.1);
  color:var(--accent-teal);font-weight:600;
}
.ekspansi-toggle{
  width:24px;height:24px;border-radius:6px;display:flex;align-items:center;justify-content:center;
  transition:var(--transition);color:var(--text-muted);
}
.ekspansi-kartu.buka .ekspansi-toggle svg{transform:rotate(180deg)}
.ekspansi-body{
  max-height:0;overflow:hidden;transition:max-height 0.4s cubic-bezier(0.4,0,0.2,1);
}
.ekspansi-kartu.buka .ekspansi-body{max-height:2000px}
.ekspansi-konten{padding:0 18px 18px 62px;font-size:0.88rem;color:var(--text-secondary);line-height:1.8}
.ekspansi-konten ul,.ekspansi-konten ol{margin-left:20px;margin-bottom:12px}
.ekspansi-konten li{margin-bottom:6px}

/* Sub-expand inside content */
.sub-ekspansi{
  background:var(--bg-elevated);border-radius:var(--radius-sm);margin:10px 0;overflow:hidden;
}
.sub-header{
  display:flex;align-items:center;gap:10px;padding:10px 14px;cursor:pointer;font-size:0.85rem;font-weight:600;
  color:var(--text-primary);transition:var(--transition);
}
.sub-header:hover{background:rgba(0,201,255,0.04)}
.sub-body{max-height:0;overflow:hidden;transition:max-height 0.3s ease}
.sub-ekspansi.buka .sub-body{max-height:1500px}
.sub-konten{padding:0 14px 14px 40px;font-size:0.84rem;color:var(--text-secondary)}

/* ===== INFO BOXES ===== */
.kotak-info{
  padding:14px 18px;border-radius:var(--radius-sm);margin:14px 0;font-size:0.86rem;
  border-left:4px solid;display:flex;gap:12px;align-items:flex-start;
}
.kotak-info svg{flex-shrink:0;margin-top:2px}
.kotak-penting{background:rgba(251,113,133,0.08);border-left-color:var(--accent-rose);color:#fecdd3}
.kotak-tips{background:rgba(52,211,153,0.08);border-left-color:var(--accent-emerald);color:#a7f3d0}
.kotak-ingat{background:rgba(0,201,255,0.08);border-left-color:var(--accent-teal);color:#a5f3fc}
.kotak-data{background:rgba(167,139,250,0.08);border-left-color:var(--accent-violet);color:#ddd6fe}
[data-theme="light"] .kotak-penting{background:rgba(190,18,60,0.07);border-left-color:#be123c;color:#7f1d1d}
[data-theme="light"] .kotak-tips{background:rgba(6,95,70,0.07);border-left-color:#047857;color:#064e3b}
[data-theme="light"] .kotak-ingat{background:rgba(0,119,168,0.08);border-left-color:#0077a8;color:#0c4a6e}
[data-theme="light"] .kotak-data{background:rgba(109,40,217,0.07);border-left-color:#6d28d9;color:#4c1d95}

/* ===== MEDICAL TERM with Simple Language ===== */
.istilah-medis{
  display:inline;border-bottom:2px dotted var(--accent-teal);cursor:help;
  position:relative;font-weight:600;color:var(--accent-cyan);transition:var(--transition);
}
.istilah-medis:hover{background:rgba(0,201,255,0.1);border-bottom-style:solid;z-index:2147483646;position:relative}
.istilah-medis .tooltip-simple{
  position:absolute;bottom:calc(100% + 8px);left:50%;transform:translateX(-50%) scale(0.95);
  background:var(--bg-elevated);border:1px solid var(--accent-teal);border-radius:var(--radius-md);
  padding:12px 16px;width:320px;font-size:0.82rem;font-weight:normal;color:var(--text-secondary);
  line-height:1.6;opacity:0;pointer-events:none;transition:all 0.2s ease;z-index:99999;
  box-shadow:var(--shadow-lg);
}
.istilah-medis:hover .tooltip-simple,.istilah-medis:focus .tooltip-simple,.istilah-medis:active .tooltip-simple{opacity:1;transform:translateX(-50%) scale(1);pointer-events:auto;z-index:2147483647!important;overflow:visible}
.tooltip-simple { z-index: 2147483647 !important; }
.tooltip-simple .judul-simple{
  display:block;font-weight:700;color:var(--accent-teal);font-size:0.8rem;
  text-transform:uppercase;letter-spacing:0.5px;margin-bottom:6px;
}
.tooltip-simple .asli-medis{display:block;font-weight:700;color:var(--accent-cyan);font-size:0.95rem;margin-bottom:4px}
.tooltip-simple .arti-simple{color:var(--text-primary);font-weight:500}
.tooltip-simple .penjelasan-simple{font-size:0.78rem;color:var(--text-muted);margin-top:6px;padding-top:6px;border-top:1px solid var(--glass-border)}

/* ===== BAHASA SEDERHANA MODE ===== */
.mode-sederhana .istilah-medis{
  border-bottom:none;color:var(--text-primary);font-weight:normal;cursor:default;
}
.mode-sederhana .istilah-medis .arti-simple{display:inline}
.mode-sederhana .istilah-medis .asli-medis{display:none}
.mode-sederhana .istilah-medis .tooltip-simple{display:none!important}

/* ===== TABLES ===== */
.tabel-medis{width:100%;border-collapse:collapse;margin:14px 0;font-size:0.85rem}
.tabel-medis th{
  background:var(--bg-elevated);padding:10px 12px;text-align:left;font-weight:600;
  color:var(--accent-teal);border-bottom:2px solid var(--accent-teal);font-size:0.8rem;text-transform:uppercase;letter-spacing:0.5px;
}
.tabel-medis td{padding:10px 12px;border-bottom:1px solid var(--glass-border);color:var(--text-secondary)}
.tabel-medis tr:hover td{background:rgba(0,201,255,0.03)}

/* ===== SEARCH OVERLAY with PREVIEW ===== */
.cari-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:200;
  display:none;align-items:flex-start;justify-content:center;
  padding-top:80px;backdrop-filter:blur(8px);
}
.cari-overlay.buka{display:flex}
.cari-kotak{
  background:var(--bg-card);border:1px solid var(--glass-border);
  border-radius:var(--radius-xl);width:90%;max-width:720px;
  max-height:70vh;overflow:hidden;display:flex;flex-direction:column;
  box-shadow:var(--shadow-lg);
}
.cari-input-area{
  padding:18px 20px;border-bottom:1px solid var(--glass-border);
  display:flex;align-items:center;gap:12px;
}
.cari-input{
  flex:1;background:transparent;border:none;color:var(--text-primary);
  font-size:1.1rem;outline:none;font-family:inherit;
}
.cari-input::placeholder{color:var(--text-muted)}
.cari-hasil{flex:1;overflow-y:auto;padding:8px 0}
.cari-item{
  padding:12px 20px;cursor:pointer;transition:var(--transition);
  border-bottom:1px solid var(--glass-border);
}
.cari-item:hover{background:rgba(0,201,255,0.06)}
.cari-item-judul{font-weight:600;font-size:0.88rem;color:var(--accent-teal);margin-bottom:4px}
.cari-item-preview{
  font-size:0.82rem;color:var(--text-muted);line-height:1.5;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
}
.cari-item-match{background:rgba(0,201,255,0.2);color:var(--accent-cyan);padding:1px 4px;border-radius:3px;font-weight:600}
.cari-kosong{padding:40px;text-align:center;color:var(--text-muted);font-size:0.9rem}
.cari-stats{padding:10px 20px;font-size:0.75rem;color:var(--text-muted);border-top:1px solid var(--glass-border)}

/* ===== QUIZ ===== */
.kuis-kartu{
  background:var(--bg-card);border:1px solid var(--glass-border);
  border-radius:var(--radius-md);padding:18px;margin-bottom:14px;
}
.kuis-pertanyaan{font-weight:600;margin-bottom:12px;font-size:0.92rem}
.kuis-pilihan{display:block;width:100%;text-align:left;padding:10px 14px;
  margin-bottom:8px;border-radius:var(--radius-sm);border:1px solid var(--glass-border);
  background:var(--bg-elevated);color:var(--text-primary);cursor:pointer;
  transition:all 0.25s cubic-bezier(0.4,0,0.2,1);font-size:0.85rem;font-family:inherit;
  position:relative;
}
.kuis-pilihan:hover{border-color:var(--accent-teal);background:rgba(0,201,255,0.05)}
.kuis-pilihan.benar{border-color:var(--accent-emerald)!important;background:rgba(52,211,153,0.2)!important;color:#34d399!important;box-shadow:0 0 0 3px rgba(52,211,153,0.4)!important;opacity:1!important;transform:scale(1.02)}
.kuis-pilihan.benar::before{content:"✓ ";font-weight:800}
.kuis-pilihan.salah{border-color:var(--accent-rose)!important;background:rgba(251,113,133,0.2)!important;color:#fb7185!important;box-shadow:0 0 0 3px rgba(251,113,133,0.4)!important;opacity:1!important;transform:scale(0.98)}
.kuis-pilihan.salah::before{content:"✗ ";font-weight:800}
.kuis-pilihan.nonaktif{pointer-events:none}
.kuis-pilihan.nonaktif:not(.benar):not(.salah){opacity:0.45}
.kuis-jawaban{
  display:none;margin-top:10px;padding:12px;border-radius:var(--radius-sm);
  background:rgba(0,201,255,0.06);font-size:0.84rem;color:var(--text-secondary);
}
.kuis-jawaban.buka{display:block}

/* ===== FLASHCARD ===== */
.flash-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,0.8);z-index:200;
  display:none;align-items:center;justify-content:center;backdrop-filter:blur(8px);
}
.flash-overlay.buka{display:flex}
.flash-kartu{
  width:420px;height:280px;perspective:1000px;cursor:pointer;
}
.flash-inner{
  position:relative;width:100%;height:100%;transition:transform 0.6s;
  transform-style:preserve-3d;
}
.flash-kartu.balik .flash-inner{transform:rotateY(180deg)}
.flash-front,.flash-back{
  position:absolute;width:100%;height:100%;backface-hidden:hidden;
  -webkit-backface-visibility:hidden;border-radius:var(--radius-lg);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  padding:24px;border:1px solid var(--glass-border);box-shadow:var(--shadow-lg);
}
.flash-front{background:linear-gradient(135deg,var(--bg-card),var(--bg-elevated))}
.flash-back{background:linear-gradient(135deg,var(--bg-elevated),var(--bg-card));transform:rotateY(180deg)}
.flash-istilah{font-size:1.3rem;font-weight:700;color:var(--accent-teal);text-align:center;margin-bottom:8px}
.flash-arti{font-size:1rem;color:var(--text-primary);text-align:center;font-weight:600}
.flash-penjelasan{font-size:0.82rem;color:var(--text-secondary);text-align:center;margin-top:10px;line-height:1.6}
.flash-nav{display:flex;gap:12px;margin-top:20px;justify-content:center}
.flash-btn{
  padding:8px 16px;border-radius:var(--radius-sm);border:1px solid var(--glass-border);
  background:var(--bg-card);color:var(--text-primary);cursor:pointer;transition:var(--transition);
  font-size:0.82rem;font-family:inherit;
}
.flash-btn:hover{background:rgba(0,201,255,0.1);border-color:var(--accent-teal)}
.flash-counter{font-size:0.75rem;color:var(--text-muted);text-align:center;margin-top:12px}

/* ===== STRESS TEST ===== */
.stress-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:200;
  display:none;align-items:center;justify-content:center;backdrop-filter:blur(8px);
}
.stress-overlay.buka{display:flex}
.stress-kotak{
  background:var(--bg-card);border:1px solid var(--glass-border);
  border-radius:var(--radius-xl);width:92%;max-width:700px;
  max-height:85vh;overflow-y:auto;padding:28px;box-shadow:var(--shadow-lg);
}
.stress-timer{
  position:fixed;top:20px;right:20px;background:var(--bg-card);
  border:2px solid var(--accent-rose);color:var(--accent-rose);
  padding:10px 18px;border-radius:var(--radius-md);font-weight:700;
  font-size:1.2rem;z-index:210;font-variant-numeric:tabular-nums;
}

/* ===== OVERLAYS ===== */
.overlay-panel{
  position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:200;
  display:none;align-items:center;justify-content:center;backdrop-filter:blur(8px);
}
.overlay-panel.buka{display:flex}
.panel-kotak{
  background:var(--bg-card);border:1px solid var(--glass-border);
  border-radius:var(--radius-xl);width:92%;max-width:600px;
  max-height:80vh;overflow:hidden;box-shadow:var(--shadow-lg);
}
.panel-header{
  padding:16px 20px;border-bottom:1px solid var(--glass-border);
  display:flex;justify-content:space-between;align-items:center;
}
.panel-judul{font-weight:700;font-size:1.05rem}
.panel-body{padding:20px;max-height:60vh;overflow-y:auto;font-size:0.88rem}
.panel-footer{padding:12px 20px;border-top:1px solid var(--glass-border);display:flex;gap:8px;justify-content:flex-end}

/* ===== FAB ===== */
.fab-container{
  position:fixed;bottom:24px;right:24px;display:flex;flex-direction:column;gap:10px;z-index:80;
}
.fab-btn{
  width:48px;height:48px;border-radius:50%;border:none;
  background:linear-gradient(135deg,var(--accent-teal),var(--accent-blue));
  color:#fff;display:flex;align-items:center;justify-content:center;
  cursor:pointer;box-shadow:0 4px 16px rgba(0,201,255,0.3);
  transition:var(--transition);font-size:1.1rem;
}
.fab-btn:hover{transform:translateY(-2px) scale(1.05);box-shadow:0 8px 24px rgba(0,201,255,0.4)}

/* ===== PROGRESS BAR ===== */
.progress-ring{position:fixed;top:0;left:0;right:0;height:3px;z-index:95;background:var(--bg-elevated)}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--accent-teal),var(--accent-cyan));
  transition:width 0.3s ease;border-radius:0 2px 2px 0;
}

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar{width:6px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--bg-elevated);border-radius:3px}
::-webkit-scrollbar-thumb:hover{background:var(--text-muted)}



/* ===== COMPREHENSIVE ANIMATION SYSTEM (40+ components, 20+ aspects) ===== */

/* 1. Card entrance animations */
.ekspansi-kartu { animation: cardEntrance 0.45s cubic-bezier(0.4,0,0.2,1) backwards; }
.ekspansi-kartu:nth-child(1) { animation-delay: 0.05s; }
.ekspansi-kartu:nth-child(2) { animation-delay: 0.10s; }
.ekspansi-kartu:nth-child(3) { animation-delay: 0.15s; }
.ekspansi-kartu:nth-child(4) { animation-delay: 0.20s; }
.ekspansi-kartu:nth-child(5) { animation-delay: 0.25s; }
.ekspansi-kartu:nth-child(6) { animation-delay: 0.30s; }
.ekspansi-kartu:nth-child(7) { animation-delay: 0.35s; }
.ekspansi-kartu:nth-child(8) { animation-delay: 0.40s; }
@keyframes cardEntrance { from { opacity: 0; transform: translateY(24px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }

/* 2. Icon pulse on hover */
.ekspansi-icon { transition: all 0.3s cubic-bezier(0.4,0,0.2,1); }
.ekspansi-header:hover .ekspansi-icon { transform: scale(1.12) rotate(-5deg); box-shadow: 0 4px 16px rgba(0,201,255,0.3); }

/* 3. Badge shimmer */
.ekspansi-badge { position: relative; overflow: hidden; }
.ekspansi-badge::after {
  content: ''; position: absolute; top: 0; left: -100%; width: 50%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
  animation: shimmerBadge 3s ease-in-out infinite;
}
@keyframes shimmerBadge { 0%,100% { left: -100%; } 50% { left: 150%; } }

/* 4. Slide title glow */
.slide-title { animation: titleGlow 2s ease-in-out infinite alternate; }
@keyframes titleGlow { from { filter: brightness(1); } to { filter: brightness(1.15); } }

/* 5. Navigation item slide-in */
.nav-item { animation: navSlideIn 0.35s ease backwards; }
.nav-item:nth-child(1) { animation-delay: 0.05s; }
.nav-item:nth-child(2) { animation-delay: 0.10s; }
.nav-item:nth-child(3) { animation-delay: 0.15s; }
.nav-item:nth-child(4) { animation-delay: 0.20s; }
.nav-item:nth-child(5) { animation-delay: 0.25s; }
.nav-item:nth-child(6) { animation-delay: 0.30s; }
.nav-item:nth-child(7) { animation-delay: 0.35s; }
.nav-item:nth-child(8) { animation-delay: 0.40s; }
.nav-item:nth-child(9) { animation-delay: 0.45s; }
@keyframes navSlideIn { from { opacity: 0; transform: translateX(-20px); } to { opacity: 1; transform: translateX(0); } }

/* 6. Hover lift on nav links */
.nav-link { transition: all 0.25s cubic-bezier(0.4,0,0.2,1); }
.nav-link:hover { transform: translateX(4px); }

/* 7. Number badge bounce */
.nav-link .num { transition: all 0.3s ease; }
.nav-link:hover .num { transform: scale(1.15); }

/* 8. Topbar buttons hover */
.topbar-btn { transition: all 0.25s cubic-bezier(0.4,0,0.2,1); }
.topbar-btn:hover { transform: scale(1.1); box-shadow: 0 4px 12px rgba(0,201,255,0.2); }

/* 9. FAB main button pulse */

@keyframes fabPulse { 0%,100% { box-shadow: 0 4px 16px rgba(0,201,255,0.4); } 50% { box-shadow: 0 4px 28px rgba(0,201,255,0.6); } }

/* 10. FAB item hover spin */
.fab-item { transition: all 0.3s cubic-bezier(0.4,0,0.2,1); }
.fab-item:hover svg { transform: scale(1.15); }

/* 11. Quiz button ripple effect */
.kuis-pilihan { position: relative; overflow: hidden; }
.kuis-pilihan::after {
  content: ''; position: absolute; top: 50%; left: 50%; width: 0; height: 0;
  border-radius: 50%; background: rgba(0,201,255,0.15); transform: translate(-50%,-50%);
  transition: width 0.4s, height 0.4s;
}
.kuis-pilihan:active::after { width: 200px; height: 200px; }

/* 12. Correct answer celebration */
.kuis-pilihan.benar { animation: correctPop 0.5s ease; }
@keyframes correctPop { 0% { transform: scale(1); } 50% { transform: scale(1.05); } 100% { transform: scale(1.02); } }

/* 13. Wrong answer shake */
.kuis-pilihan.salah { animation: wrongShake 0.4s ease; }
@keyframes wrongShake { 0%,100% { transform: translateX(0) scale(0.98); } 25% { transform: translateX(-6px) scale(0.98); } 75% { transform: translateX(6px) scale(0.98); } }

/* 14. Table row hover glow */
.tabel-medis tr { transition: all 0.2s ease; }
.tabel-medis tr:hover td { background: rgba(0,201,255,0.06); transform: translateX(2px); }

/* 15. Info box border glow */
.kotak-info { transition: all 0.3s ease; }
.kotak-info:hover { transform: translateX(4px); box-shadow: 4px 0 16px rgba(0,201,255,0.1); }

/* 16. Medical term hover */
.istilah-medis { transition: all 0.2s ease; }

/* 17. Tooltip smooth appear */
.tooltip-simple { transition: all 0.25s cubic-bezier(0.4,0,0.2,1) !important; }

/* 18. Progress bar shimmer */
.progress-fill {
  background: linear-gradient(90deg, var(--accent-teal), var(--accent-cyan), var(--accent-teal));
  background-size: 200% 100%;
  animation: progressShimmer 2s linear infinite;
}
@keyframes progressShimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* 19. Flashcard flip smooth */
.flash-inner { transition: transform 0.6s cubic-bezier(0.4,0,0.2,1); }

/* 20. Overlay fade */
.cari-overlay, .flash-overlay, .stress-overlay, .overlay-panel { transition: opacity 0.3s ease; }

/* 21. Search result hover */
.cari-item { transition: all 0.2s ease; }
.cari-item:hover { transform: translateX(4px); }

/* 22. Dashboard card entrance */
.dashboard-card { animation: dashCardIn 0.4s ease backwards; transition: all 0.3s ease; }
.dashboard-card:nth-child(1) { animation-delay: 0.05s; }
.dashboard-card:nth-child(2) { animation-delay: 0.10s; }
.dashboard-card:nth-child(3) { animation-delay: 0.15s; }
.dashboard-card:nth-child(4) { animation-delay: 0.20s; }
@keyframes dashCardIn { from { opacity: 0; transform: scale(0.9); } to { opacity: 1; transform: scale(1); } }
.dashboard-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px rgba(0,0,0,0.15); }

/* 23. Sub-expansion smooth */
.sub-body { transition: max-height 0.35s cubic-bezier(0.4,0,0.2,1); }

/* 24. Welcome screen logo */
.welcome-logo { animation: welcomeLogo 1s ease; }
@keyframes welcomeLogo { from { opacity: 0; transform: scale(0.8) translateY(20px); } to { opacity: 1; transform: scale(1) translateY(0); } }

/* 25. Running text smooth */
/* 25. Running text — see canonical block */

/* 26. Zoom slider glow */
.zoom-slider::-webkit-slider-thumb { transition: all 0.2s ease; }
.zoom-slider::-webkit-slider-thumb:hover { transform: scale(1.3); box-shadow: 0 0 12px rgba(0,201,255,0.5); }

/* 27. Sidebar search focus */
.sidebar-search input { transition: all 0.25s ease; }

/* 28. Simple toggle animation */
.simpel-toggle { transition: all 0.3s ease; }
.simpel-toggle:hover { transform: scale(1.02); }

/* 29. Stress test dot animations */
.stress-dot { transition: all 0.2s ease; }
.stress-dot:hover { transform: scale(1.15); }

/* 30. Mark button pulse */
.mark-btn { transition: all 0.2s ease; }
.mark-btn:hover { transform: scale(1.05); }

/* 31. Toast slide up */
.toast { transition: all 0.35s cubic-bezier(0.4,0,0.2,1); }

/* 32. Panel header underline */
.panel-header { position: relative; }
.panel-header::after {
  content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 0; height: 2px; background: var(--accent-teal); transition: width 0.4s ease;
}
.panel-kotak:hover .panel-header::after { width: 80%; }

/* 33. Image hover zoom */
img { transition: transform 0.4s ease; }
img:hover { transform: scale(1.02); }

/* 34. Breadcrumb fade */
.breadcrumb { animation: breadcrumbFade 0.3s ease; }
@keyframes breadcrumbFade { from { opacity: 0; } to { opacity: 1; } }

/* 35. Surgical exit button pulse */
.surgical-exit { animation: exitPulse 2s ease-in-out infinite; transition: all 0.2s ease; }
@keyframes exitPulse { 0%,100% { box-shadow: 0 0 0 0 rgba(0,201,255,0.3); } 50% { box-shadow: 0 0 0 8px rgba(0,201,255,0); } }
.surgical-exit:hover { background: var(--accent-teal) !important; color: #fff !important; transform: scale(1.05); }

/* 36. Content list item entrance */
.ekspansi-konten li { animation: listItemIn 0.3s ease backwards; transition: all 0.2s ease; }
.ekspansi-konten li:nth-child(1) { animation-delay: 0.1s; }
.ekspansi-konten li:nth-child(2) { animation-delay: 0.15s; }
.ekspansi-konten li:nth-child(3) { animation-delay: 0.20s; }
.ekspansi-konten li:nth-child(4) { animation-delay: 0.25s; }
.ekspansi-konten li:nth-child(5) { animation-delay: 0.30s; }
@keyframes listItemIn { from { opacity: 0; transform: translateX(-10px); } to { opacity: 1; transform: translateX(0); } }
.ekspansi-konten li:hover { transform: translateX(4px); color: var(--accent-teal); }

/* 37. Nav children expand */
.nav-children { transition: max-height 0.35s cubic-bezier(0.4,0,0.2,1), opacity 0.3s ease; }

/* 38. Sidebar logo shimmer */
.sidebar-logo { position: relative; }
.sidebar-logo::after {
  content: ''; position: absolute; top: 0; left: -100%; width: 40%; height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
  animation: logoShimmer 4s ease-in-out infinite;
}
@keyframes logoShimmer { 0%,100% { left: -100%; } 50% { left: 200%; } }

/* 39. Quiz explanation reveal */
.kuis-jawaban { transition: all 0.35s cubic-bezier(0.4,0,0.2,1); }
.kuis-jawaban.buka { animation: explainReveal 0.4s ease; }
@keyframes explainReveal { from { opacity: 0; max-height: 0; transform: translateY(-8px); } to { opacity: 1; max-height: 500px; transform: translateY(0); } }

/* 40. Scrollbar custom glow */
::-webkit-scrollbar-thumb { transition: background 0.2s ease; }

/* 41. User badge glow */
.user-badge { animation: userBadgeGlow 3s ease-in-out infinite alternate; }
@keyframes userBadgeGlow { from { box-shadow: 0 0 0 0 rgba(94,234,212,0.1); } to { box-shadow: 0 0 12px rgba(94,234,212,0.2); } }

/* 42. FAB item wide (timer) glow */
.fab-item-wide { transition: all 0.25s ease; }
.fab-item-wide:hover { transform: scale(1.02); border-color: var(--accent-teal); }

/* 43. Onboarding slide animations */
.onboard-slide { animation: fadeInUp 0.5s ease; }

/* 44. Panduan item entrance */
.panduan-item { animation: cardEntrance 0.4s ease backwards; transition: all 0.2s ease; }
.panduan-item:hover { transform: translateX(4px); border-color: var(--accent-teal); }

/* 45. Fitur card hover */
.fitur-card { transition: all 0.3s ease; }
.fitur-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(0,0,0,0.1); }

/* ===== END COMPREHENSIVE ANIMATION SYSTEM ===== */

/* ===== KUIS RECALL PER SLIDE — Liquid Glass UI ===== */
.kuis-recall-overlay { display: none; }
.kuis-recall-overlay.buka { display: flex; align-items: center; justify-content: center; }
.kuis-recall-container {
  background: linear-gradient(135deg, rgba(18,26,46,0.95), rgba(26,42,78,0.95));
  background-blend-mode: luminosity;
  backdrop-filter: blur(40px) saturate(150%);
  -webkit-backdrop-filter: blur(40px) saturate(150%);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: var(--radius-xl);
  box-shadow:
    inset 0 1px 1px rgba(255,255,255,0.12),
    inset 0 -1px 1px rgba(0,0,0,0.05),
    0 25px 50px rgba(0,0,0,0.35),
    0 8px 24px rgba(0,0,0,0.2);
  width: 92%;
  max-width: 720px;
  max-height: 90vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  animation: kuisRecallIn 0.35s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes kuisRecallIn {
  from { opacity: 0; transform: scale(0.92) translateY(20px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}
.kuis-recall-container::before {
  content: '';
  position: absolute;
  inset: 0;
  border-radius: inherit;
  padding: 1.4px;
  background: linear-gradient(180deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0.1) 20%, transparent 40%, transparent 60%, rgba(255,255,255,0.1) 80%, rgba(255,255,255,0.4) 100%);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
  mix-blend-mode: screen;
  opacity: 0.2;
}
.kuis-recall-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 20px;
  border-bottom: 1px solid var(--glass-border);
  background: rgba(0,0,0,0.15);
  position: relative;
  z-index: 2;
}
.kuis-recall-title {
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--accent-teal);
  background: linear-gradient(135deg, var(--accent-teal), var(--accent-cyan));
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.kuis-recall-timer-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(0,0,0,0.3);
  border: 1px solid rgba(255,255,255,0.1);
  border-radius: var(--radius-sm);
  padding: 5px 12px;
  font-size: 0.82rem;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--text-primary);
  transition: all 0.3s ease;
}
.kuis-recall-timer-badge.kuis-timer-warn { border-color: var(--accent-amber); color: var(--accent-amber); animation: kuisTimerPulse 1s ease infinite; }
.kuis-recall-timer-badge.kuis-timer-danger { border-color: var(--accent-rose); color: var(--accent-rose); animation: kuisTimerPulse 0.5s ease infinite; }
@keyframes kuisTimerPulse { 0%,100% { opacity: 1; } 50% { opacity: 0.6; } }
.kuis-recall-close {
  width: 32px;
  height: 32px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--glass-border);
  background: rgba(239,68,68,0.1);
  color: #f87171;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.2s ease;
  touch-action: manipulation;
}
.kuis-recall-close:hover { background: rgba(239,68,68,0.25); transform: scale(1.05); }
.kuis-recall-close:active { transform: scale(0.95); }
.kuis-recall-body {
  padding: 20px;
  overflow-y: auto;
  flex: 1;
  position: relative;
  z-index: 1;
}
.kuis-recall-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 16px;
}
.kuis-recall-progress {
  font-size: 0.78rem;
  color: var(--text-muted);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.kuis-recall-progress-bar {
  height: 5px;
  background: rgba(255,255,255,0.06);
  border-radius: 10px;
  overflow: hidden;
}
.kuis-recall-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent-teal), var(--accent-cyan));
  border-radius: 10px;
  transition: width 0.4s cubic-bezier(0.4,0,0.2,1);
}
.kuis-recall-question {
  font-size: 1rem;
  font-weight: 600;
  line-height: 1.7;
  margin-bottom: 16px;
  padding: 14px 16px;
  background: rgba(0,0,0,0.15);
  border-radius: var(--radius-md);
  border-left: 3px solid var(--accent-teal);
  color: var(--text-primary);
}
.kuis-recall-option {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  text-align: left;
  padding: 12px 14px;
  margin-bottom: 8px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--glass-border);
  background: rgba(255,255,255,0.03);
  color: var(--text-primary);
  font-size: 0.88rem;
  font-family: inherit;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4,0,0.2,1);
  touch-action: manipulation;
  -webkit-tap-highlight-color: transparent;
