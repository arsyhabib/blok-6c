  var title = section.dataset.title || slideId;
  var md = '# ' + title + '\n\n';
  section.querySelectorAll('.ekspansi-kartu, .card').forEach(function(card) {
    var hdr = card.querySelector('.ekspansi-header, .card-header');
    if (hdr) md += '## ' + hdr.textContent.trim() + '\n\n';
    var body = card.querySelector('.ekspansi-isi, .card-body');
    if (body) {
      body.querySelectorAll('p, li').forEach(function(el) { md += el.tagName === 'LI' ? '- ' + el.textContent.trim() + '\n' : el.textContent.trim() + '\n\n'; });
    }
  });
  var blob = new Blob([md], {type: 'text/markdown'});
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a'); a.href = url; a.download = (title||'slide') + '.md'; a.click();
  if (typeof showToast === 'function') showToast('📝 Exported to Markdown!');
}

