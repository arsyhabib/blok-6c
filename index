function buildSlideTemplate(slide) {
  var idNum = parseInt(slide.id.replace('slide-', ''));
  if (idNum === 0) return; // Skip imunisasi (already styled)
  var meta = SLIDE_META[idNum];
  if (!meta) return;
  
  // Don't rebuild if already done
  if (slide.querySelector('.slide-stats-bar')) return;
  
  // ── 1. STAT BAR ──
  var statBar = document.createElement('div');
  statBar.className = 'slide-stats-bar';
  var statsHTML = meta.stats.map(function(s) {
    return '<div class="stat-cell"><div class="stat-val" style="color:' + s.color + '">' + s.val + '</div><div class="stat-lbl">' + s.lbl + '</div></div>';
  }).join('');
  statBar.innerHTML = '<div class="stat-emoji">' + meta.emoji + '</div>' + statsHTML;
  
  // ── 2. QUICK ACTIONS ROW ──
  var aksiBar = document.createElement('div');
  aksiBar.className = 'slide-aksi-bar';
  var aksiHTML = meta.aksi.map(function(a, i) {
    var clickCode = a.fn ? 'onclick="' + a.fn.replace(/"/g, '&quot;') + '"' : '';
    return '<div class="aksi-cell" ' + clickCode + '><div class="aksi-icon" style="background:' + meta.accent + '20;color:' + meta.accent + '">' + a.icon + '</div><div class="aksi-info"><div class="aksi-lbl">' + a.lbl + '</div><div class="aksi-sub">' + a.sub + '</div></div></div>';
  }).join('');
  aksiBar.innerHTML = aksiHTML;
  
  // ── 3. INSERT: after headbar (or at top if no headbar) ──
  var headbar = slide.querySelector('.slide-headbar');
  var ref = headbar ? headbar.nextSibling : slide.firstChild;
  slide.insertBefore(aksiBar, ref);
  slide.insertBefore(statBar, aksiBar);
  
  // ── 4. STYLE ACCORDION CARDS to match Imunisasi look ──
  var eksp = slide.querySelectorAll('.ekspansi-kartu');
  eksp.forEach(function(k, i) {
    k.classList.add('eksp-v3');
  });
  
  // ── 5. STYLE QUIZ CARDS ──
  var kuis = slide.querySelectorAll('.kuis-kartu');
  kuis.forEach(function(k) {
    k.classList.add('kuis-v3');
  });
}

function buildAllSlideTemplates() {
  var slides = document.querySelectorAll('.slide-section');
  slides.forEach(function(s) {
    buildSlideTemplate(s);
  });
}



