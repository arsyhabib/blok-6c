// ===== FEATURE NEW-16: SPACED REPETITION (SM-2) =====
function calculateNextReview(quizId, performance) {
  var data = JSON.parse(localStorage.getItem('spacedRep') || '{}');
  var card = data[quizId] || {easiness: 2.5, interval: 1, reps: 0};
  var e = card.easiness, n = card.interval;
  if (performance >= 4) {
    n = card.reps === 0 ? 1 : card.reps === 1 ? 6 : Math.round(n * e);
    e = Math.max(1.3, e + 0.1 - (5-performance)*(0.08+(5-performance)*0.02));
  } else {
    n = 1; e = Math.max(1.3, e - 0.2);
  }
  var nextDate = new Date(Date.now() + n * 86400000);
  data[quizId] = {easiness: e, interval: n, reps: (card.reps||0)+1, nextReview: nextDate.toISOString()};
  localStorage.setItem('spacedRep', JSON.stringify(data));
  return nextDate;
