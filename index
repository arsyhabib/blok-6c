  function processAssessmentAnalytics(evaluationQuizId, selectedOptionKey, trackingResponseDeltaTimeMs, clientConfidenceRatingValue) {
    var graph = window.SLIDE_DATA_SOURCE_GRAPH || { quizzes: [] };
    var datasetQuizNode = (graph.quizzes || []).find(function(item){ return item.id === evaluationQuizId; });
    if (!datasetQuizNode) return null;

    var isResponseAccurate = selectedOptionKey === datasetQuizNode.correctAnswerKey;
    var structuralVelocityModifier = trackingResponseDeltaTimeMs < 45000 ? 1.2 : 0.85;
    var evaluatedConfidenceWeightFactor = clientConfidenceRatingValue === 3 ? 1.35 : clientConfidenceRatingValue === 1 ? 0.65 : 1.0;
    var baseScoreDelta = isResponseAccurate ? 1.0 : 0.0;
    var calculatedWeightedCompetencyGain = baseScoreDelta * structuralVelocityModifier * evaluatedConfidenceWeightFactor * datasetQuizNode.itemDifficultyParameter;
    var analyticalTrackingPayload = {
      isCorrectAnswer: isResponseAccurate,
      executionTimeMs: trackingResponseDeltaTimeMs,
      confidenceTierSelected: clientConfidenceRatingValue,
      calculatedAbilityDelta: calculatedWeightedCompetencyGain,
      timestampEpoch: Date.now()
    };
    var activeScoresRepository = window.sapientEngineStore.state.quizScoresRepository;
    activeScoresRepository[evaluationQuizId] = analyticalTrackingPayload;
    window.sapientEngineStore.commitStateUpdate("quizScoresRepository", activeScoresRepository);
    updateConceptVectorsMatrix(datasetQuizNode.associatedConceptIdentifications, isResponseAccurate, calculatedWeightedCompetencyGain);
    return analyticalTrackingPayload;
  }

