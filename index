    var id = entry[0], data = entry[1];
    var topic = (data.slideId || '').replace('slide-', 'Slide ');
    if (!topicScores[topic]) topicScores[topic] = {correct: 0, total: 0};
    topicScores[topic].total++;
    if (data.correct) topicScores[topic].correct++;
  });
  return Object.entries(topicScores)
    .map(function(e) { return {topic: e[0], score: Math.round(e[1].correct/e[1].total*100)}; })
    .filter(function(t) { return t.score < 70; })
