,"penjelasan":""},{"istilah":"Croup (Laringotrakeitis)","arti":"","penjelasan":""},{"istilah":"Epiglotitis","arti":"","penjelasan":""},{"istilah":"Abses Peritonsil (Quincy)","arti":"","penjelasan":""},{"istilah":"Centor Criteria","arti":"","penjelasan":""},{"istilah":"Laryngopharyngeal Reflux (LPR)","arti":"","penjelasan":""},{"istilah":"Steeple Sign","arti":"","penjelasan":""},{"istilah":"Karsinoma Nasofaring (KNF)","arti":"","penjelasan":""},{"istilah":"EA-IgA (Early Antigen IgA)","arti":"","penjelasan":""},{"istilah":"Rinitis Vasomotor","arti":"","penjelasan":""},{"istilah":"Rinitis Medikamentosa","arti":"","penjelasan":""},{"istilah":"CT Temporal Bone","arti":"","penjelasan":""},{"istilah":"Lund-Mackay Score","arti":"","penjelasan":""},{"istilah":"Myopia","arti":"","penjelasan":""},{"istilah":"Hipermetropia","arti":"","penjelasan":""},{"istilah":"Astigmatisme","arti":"","penjelasan":""},{"istilah":"Presbiopia","arti":"","penjelasan":""},{"istilah":"Cycloplegic refraction","arti":"","penjelasan":""},{"istilah":"Pathologic myopia","arti":"","penjelasan":""},{"istilah":"Hordeolum","arti":"","penjelasan":""},{"istilah":"Kalazion","arti":"","penjelasan":""},{"istilah":"Pterigium","arti":"","penjelasan":""},{"istilah":"Trikhiasis","arti":"","penjelasan":""},{"istilah":"Lagofthalmos","arti":"","penjelasan":""},{"istilah":"Ektropion","arti":"","penjelasan":""},{"istilah":"Entropion","arti":"","penjelasan":""},{"istilah":"Konjungtivitis","arti":"","penjelasan":""},{"istilah":"Episkleritis","arti":"","penjelasan":""},{"istilah":"Skleritis","arti":"","penjelasan":""},{"istilah":"Trakoma","arti":"","penjelasan":""},{"istilah":"Konjungtivitis gonokokal","arti":"","penjelasan":""},{"istilah":"Folikel konjungtival","arti":"","penjelasan":""},{"istilah":"Trauma kimia mata","arti":"","penjelasan":""},{"istilah":"Keratitis","arti":"","penjelasan":""},{"istilah":"Ulkus kornea","arti":"","penjelasan":""},{"istilah":"Hiphema","arti":"","penjelasan":""},{"istilah":"Hipopion","arti":"","penjelasan":""},{"istilah":"Fenomena satelit","arti":"","penjelasan":""},{"istilah":"Double eversion","arti":"","penjelasan":""},{"istilah":"Katarak","arti":"","penjelasan":""},{"istilah":"Katarak nuklear","arti":"","penjelasan":""},{"istilah":"Katarak kortikal","arti":"","penjelasan":""},{"istilah":"Katarak posterior subcapsular","arti":"","penjelasan":""},{"istilah":"Phacoemulsifikasi","arti":"","penjelasan":""},{"istilah":"Second sight","arti":"","penjelasan":""},{"istilah":"Retinal detachment (RD)","arti":"","penjelasan":""},{"istilah":"Rhegmatogenous RD","arti":"","penjelasan":""},{"istilah":"Retinopati diabetik non-proliferatif (NPDR)","arti":"","penjelasan":""},{"istilah":"Retinopati diabetik proliferatif (PDR)","arti":"","penjelasan":""},{"istilah":"Diabetic Macular Edema (DME)","arti":"","penjelasan":""},{"istilah":"Malignant hypertension","arti":"","penjelasan":""},{"istilah":"Anti-VEGF intravitreal","arti":"","penjelasan":""},{"istilah":"CRAO","arti":"","penjelasan":""},{"istilah":"CRVO","arti":"","penjelasan":""},{"istilah":"AMD eksudatif (wet)","arti":"","penjelasan":""},{"istilah":"Drusen","arti":"","penjelasan":""},{"istilah":"Neuritis optik","arti":"","penjelasan":""},{"istilah":"Papiledema","arti":"","penjelasan":""},{"istilah":"Cherry red spot","arti":"","penjelasan":""},{"istilah":"IIH (idiopathic intracranial hypertension)","arti":"","penjelasan":""},{"istilah":"ADME (ocular)","arti":"","penjelasan":""},{"istilah":"Prostaglandin analogues","arti":"","penjelasan":""},{"istilah":"β-blocker topikal","arti":"","penjelasan":""},{"istilah":"CT scan orbita","arti":"","penjelasan":""},{"istilah":"MRI orbita","arti":"","penjelasan":""},{"istilah":"Kalazion","arti":"","penjelasan":""},{"istilah":"Retinoblastoma","arti":"","penjelasan":""},{"istilah":"Melanoma uvea","arti":"","penjelasan":""}];
  var EXAM_STRESS_BANK = [{"id":"exam-soal-A-1","pertanyaan":"Gejala katarak, kecuali...","pilihan":["Glare (silau)","Floaters (bayang-bayang melayang)","Fotopsia (kilatan cahaya)","Nyeri","Penglihatan ganda (diplopia monokular)"],"jawaban":"D","penjelasan":"Katarak adalah kekeruhan lensa intraokular yang menyebabkan penurunan penglihatan progresif. Katarak TIDAK menyebabkan nyeri karena lensa tidak memiliki inervasi sensorik. Gejala utama meliputi visi kabur, glare, floaters, fotopsia, dan diplopia monokular.","slide":12},{"id":"exam-soal-A-2","pertanyaan":"Tn F usia 23 tahun, pendengaran berkurang telinga kanan 3 hari, nyeri, keluar cairan nanah, demam (sudah tidak demam). Pemeriksaan otoskopi: perforasi membran timpani. Tatalaksana?","pilihan":["NaCl 3% dan antibiotik","Irigasi telinga dengan NaCl 0,9% dan antibiotik","Dekongestan nasal","Analgesik saja","Pemberian karbogliserin"],"jawaban":"B","penjelasan":"OMA (Otitis Media Akut) stadium perforasi ditatalaksani dengan irigasi telinga menggunakan NaCl 0,9% untuk membersihkan sekret/nanah dan pemberian antibiotik sistemik. NaCl 3% digunakan untuk serumen prop, bukan OMA. Dekongestan tidak mengatasi infeksi.","slide":2},{"id":"exam-soal-A-3","pertanyaan":"Gejala ablasio retina, kecuali...","pilihan":["Floater (bayang melayang)","Buram mendadak","Tirai/gorden gelap","Nyeri","Silau (photopsia)"],"jawaban":"D","penjelasan":"Ablasio retina adalah terlepasnya neurosensory retina dari retinal pigment epithelium (RPE). Gejalanya: floaters, penglihatan buram mendadak, bayangan gelap seperti tirai (shade), dan fotopsia (kilatan cahaya). Ablasio retina TIDAK menyebabkan nyeri karena retina tidak memiliki nociceptor.","slide":13},{"id":"exam-soal-A-4","pertanyaan":"Keadaan kelopak mata tertarik ke atas sehingga tidak bisa menutup sempurna dan bisa terjadi eksplorasi kornea disebut...","pilihan":["Lagoftalmos","Retraksi palpebra","Eksoftalmus","Ektropion","Trikiasis"],"jawaban":"A","penjelasan":"Lagoftalmos adalah ketidakmampuan menutup kelopak mata secara sempurna akibat kelumpuhan N. VII (facial nerve). Kelopak mata tertarik ke atas karena aksi unopposed m. levator palpebrae superioris (N. III). Konsekuensi: kornea terbuka → ekskoriasi, ulkus, dan infeksi kornea.","slide":9},{"id":"exam-soal-A-5","pertanyaan":"Yang termasuk emergency absolute pada mata adalah...","pilihan":["Trauma benda tajam","Trauma kimia asam","Trauma kimia basa","Trauma termal","Trauma radiasi"],"jawaban":"C","penjelasan":"Trauma kimia basa merupakan emergency absolute karena basa menyebabkan saponifikasi lipid membran, penetrasi mendalam ke jaringan, dan kerusakan berkelanjutan. Asam menyebabkan koagulasi protein superfisial yang justru membatasi penetrasi. IRIGASI MASIF segera adalah kunci tatalaksana.","slide":11},{"id":"exam-soal-A-6","pertanyaan":"Anak 6 tahun, benjolan leher kiri depan 3 cm di tepi atas m. sternocleidomastoideus, ada lubang di ujung yang keluar cairan mukoid, sejak lahir. Berasal dari...","pilihan":["Brachial cleft cyst","Kelenjar keringat","Cervical sinus","Kelenjar tiroid","Brachial apparatus"],"jawaban":"A","penjelasan":"Kista brankial (brachial cleft cyst) adalah kelainan kongenital akibat kegagalan regresi sinus brankial. Lokasi khas: tepi anterior m. sternocleidomastoideus (sekitar 1/3 dari klavikula ke mandibula). Dapat berkomunikasi dengan kulit (fistel) yang mengeluarkan cairan mukoid/saliva. Penatalaksanaan definitif: eksisi lengkap.","slide":5},{"id":"exam-soal-A-7","pertanyaan":"Pasien dengan lesi dome shape, claw hand, penebalan saraf, BTA +4. Diagnosis?","pilihan":["Kusta tuberkuloid","Kusta border tuberkuloid","Kusta lepramatosa","Kusta border lepramatosa","Kusta indeterminata"],"jawaban":"C","penjelasan":"Kusta lepramatosa (LL) adalah tipe multibasilari dengan BTA (Bacillus Tahan Asam) positif tinggi (+3 sampai +6). Tanda klinis: lesi infiltratif multipel (dome-shaped), penebalan saraf bilateral simetris (ulnaris, peroneus, medianus, great auricular), claw hand, facial palsy, madarosis, dan saddle nose. BTA +4 mengindikasikan multibacillary.","slide":5},{"id":"exam-soal-A-8","pertanyaan":"Wanita 36 tahun, bercak kemerahan 5 tahun, nyeri sendi, rambut rontok, photosensitivity, butterfly rash malar. Diagnosis?","pilihan":["Pemphigus vulgaris","Herpes genital","Erupsi obat morbiliformis","Lupus eritematosus sistemik","Iktiosis vulgaris"],"jawaban":"D","penjelasan":"Lupus eritematosus sistemik (LES/SLE) adalah penyakit autoimun multisistem dengan kriteria diagnosis ARA: malar rash (butterfly rash), photosensitivity, artritis non-erosif, oral ulcers, serositis, renal disorder, neurologic disorder, hematologic disorder, immunologic disorder, dan ANA positif. Pasien memenuhi >4 kriteria.","slide":5},{"id":"exam-soal-A-9","pertanyaan":"Pria 36 tahun, timbul lesi biru-biru setelah tetrasiklin, lokasi sama dengan 1 tahun lalu, sariawan, lecet kelamin. Diagnosis?","pilihan":["Fixed Drug Eruption (FDE)","Erupsi eksantematosa","Stevens-Johnson syndrome","Cutaneous lupus eritematosus","Toxic epidermal necrolysis"],"jawaban":"A","penjelasan":"Fixed Drug Eruption (FDE) adalah reaksi obat yang paling khas karena lesel muncul pada lokasi yang SAMA setiap kali terpapar obat yang sama. Lesi: plak eritematosa/violaseus berbatas tegas yang dapat melibatkan mukosa (sariawan, genital). Obat pemicu umum: tetrasiklin, TMP-SMX, NSAID, barbiturat.","slide":4},{"id":"exam-soal-A-10","pertanyaan":"Jenis erupsi obat yang paling sering terjadi adalah...","pilihan":["Stevens-Johnson syndrome","Erupsi obat tipe bulosa","Erupsi obat morbiliformis","Toxic epidermal necrolysis","Lupus drug induced"],"jawaban":"C","penjelasan":"Erupsi obat morbiliformis (exanthematous/morbiliform drug eruption) adalah reaksi obat kulit tersering, menyebabkan ~90% semua reaksi obat cutaneous. Berupa makulopapul eritematosa yang simetris di trunkus dan proksimal ekstremitas, muncul 7-14 hari pasca obat. Self-limiting setelah obat dihentikan.","slide":4},{"id":"exam-soal-A-11","pertanyaan":"Pria 54 tahun, papul multipel diskret coklat, batas tegas, pedunkulated, riwayat keluarga serupa. Diagnosis?","pilihan":["Kista epidermal","Hemangioma","Keratosis seboroik","Melanoma","Karsinoma sel basal"],"jawaban":"C","penjelasan":"Keratosis seboroik (seborrheic keratosis) adalah tumor epidermal benign yang sangat umum, terutama usia >50 tahun. Tanda khas: lesi papul/nodul berwarna coklat kehitaman, batas tegas, permukaan berminyak/verukosa seperti 'menempel' pada kulit (stuck-on appearance). Pedunkulated = berpucuk (daging tumbuh). Riwayat keluarga: common.","slide":5},{"id":"exam-soal-A-12","pertanyaan":"Pria 72 tahun, ulserasi pinna, sel tumor polygonal, sitoplasma eosinofilik, intercellular bridge, keratin pearl. Diagnosis?","pilihan":["Melanoma","Karsinoma sel skuamosa","Dermatofibrosarcoma protuberans","Cutaneous T-cell lymphoma","Karsinoma sel basal"],"jawaban":"B","penjelasan":"Karsinoma sel skuamosa (SCC/SCC cutaneous) adalah keganasan keratinosit kedua tersering setelah BCC. Tanda histologi: sel polygonal eosinofilik, intercellular bridges (desmosomes), dan keratin pearls. Lokasi: daerah terpapar UV (pinna, wajah, tangan). Faktor risiko: UV kronis, imunosupresi, HPV, dan arsenik.","slide":2},{"id":"exam-soal-A-13","pertanyaan":"Pria 21 tahun, hidung penuh 2 bulan, masa polipoid licin transluksan bilateral, IgE tinggi, histologi: stroma edematous, eosinofil. Diagnosis?","pilihan":["Polip nasi","Karsinoma sel skuamosa nasi","Rhinitis kronik","Rhinitis alergika","Papilloma inverting"],"jawaban":"A","penjelasan":"Polip nasi adalah edema submukosa sinus paranasal yang berprotrusi ke rongga hidung. Klasik: bilateral, licin, transluksan, berisi eosinofil. Terkait: rinitis alergi, asma bronkial, aspirin sensitivity (triad Samter: asma + polip + aspirin). Histologi: stroma edematous, pseudostratified respiratory epithelium, eosinophilic infiltrate.","slide":7},{"id":"exam-soal-A-14","pertanyaan":"Wanita 25 tahun, keputihan kehijauan 7 hari, gatal, perih, strawberry cervix. Pengobatan?","pilihan":["Metronidazol p.o 2 gram dosis tunggal","Sefiksim p.o 800 mg dosis tunggal","Doksisiklin p.o 2x100 mg 7 hari","Itrakonazol p.o 2x100 mg 2 hari","Asiklovir p.o 5x400 mg 5 hari"],"jawaban":"A","penjelasan":"Trichomoniasis adalah IMS paling sering di dunia, disebabkan oleh protozoa flagellate Trichomonas vaginalis. Tanda khas: keputihan kuning-kehijauan berbusa, pruritus, dyspareunia, dan STRAWBERRY CERVIX (punctate hemorrhages pada serviks). Terapi: metronidazol atau tinidazol PO. Pasien dan pasangan HARUS diobati bersama.","slide":4},{"id":"exam-soal-A-15","pertanyaan":"Anak balita, gatal seminggu, papul vesikel erosi krusta sela jari punggung perut, keluarga serupa, gatal malam. Organisme?","pilihan":["Sarcoptes scabiei","Pediculus humanus corporis","Phthirus pubis","Demodex folliculorum","Cimex lectularius"],"jawaban":"A","penjelasan":"Skabies (sarcoptiasis) adalah infestasi Sarcoptes scabiei var. hominis yang menyebabkan gatal hebat terutama malam hari. Lokasi: sela jari, pergelangan tangan, aksila, perut, gluteal. Gejala: papul, vesikel, linier burrows, erosi dari garukan, dan krusta. Epidemiologi: keluarga/kontak dekat. Tanda kardinal: burrow, vesikel di penis/gland, dan sela jari.","slide":5},{"id":"exam-soal-A-16","pertanyaan":"Yang bukan merupakan kompleks osteomeatal (KOM) adalah...","pilihan":["Infundibulum ethmoidale","Hiatus semilunaris","Bula ethmoidalis","Processus uncinatus","Sinus ethmoid posterior"],"jawaban":"E","penjelasan":"Kompleks osteomeatal (KOM) adalah unit fungsional di meatus nasi medius yang mencakup: hiatus semilunaris, infundibulum ethmoidale, bula ethmoidalis, dan processus uncinatus. Sinus ethmoid posterior BUKAN bagian KOM; sinus ini bermuara ke meatus nasi superior (bukan medius).","slide":0},{"id":"exam-soal-A-17","pertanyaan":"Kelenjar yang menghasilkan serumen adalah...","pilihan":["Kelenjar sebacea","Kelenjar seruminosa (apokrin)","Kelenjar minyak","Kelenjar ekrin/merokrin","Kelenjar lacrimalis"],"jawaban":"B","penjelasan":"Serumen (earwax) dihasilkan oleh kelenjar seruminosa (apokrin glands) dan kelenjar sebacea yang terdapat di daerah kartilago meatus akustikus eksternus (outer 1/3). Kelenjar seruminosa adalah modifikasi kelenjar apokrin yang terletak di submukosa. Serumen bersifat protektif: antimikroba, pelumas, dan barrier.","slide":0},{"id":"exam-soal-A-18","pertanyaan":"Sel melanosit berada pada lapisan epidermis...","pilihan":["Stratum korneum","Diantara stratum basal dan stratum spinosum","Stratum granulosum","Stratum spinosum","Stratum lusidum"],"jawaban":"B","penjelasan":"Melanosit terletak di stratum basal epidermis (basal layer), bersisian dengan keratinosit. Setiap melanosit melayani sekitar 36 keratinosit (epidermal melanin unit). Melanosit memiliki dendrit yang memanjang ke stratum spinosum untuk transfer melanin (pigment) ke keratinosit.","slide":5},{"id":"exam-soal-A-19","pertanyaan":"Petani 68 tahun, tahi lalat pipi kanan membesar, nodul soliter, ulkus rodent, telangiektasis. Diagnosis?","pilihan":["Karsinoma sel basal","Melanoma","Keratosis seboroik","Kista epidermal","Karsinoma sel skuamosa"],"jawaban":"A","penjelasan":"Karsinoma sel basal (BCC) adalah keganasan kulit tersering. Tanda khas: nodul pearly transluksan dengan telangiektasis dan rolled border, atau ulkus rodent dengan tepi menggulung. Faktor risiko: UV kronis (petani/nelayan), kulit terang, umur >60. Histologi: sel basaloid berjejer palisading. Jarang metastasis tapi locally invasive.","slide":2},{"id":"exam-soal-A-20","pertanyaan":"Wanita 50 tahun, mata kanan merah 3 hari, visus kabur, sakit kepala hebat, mual muntah, TIO tidak terukur, kornea edema, COA dangkal. Diagnosis?","pilihan":["Glaukoma akut sudut tertutup","Endoftalmitis","Panoftalmitis","Uveitis anterior","Ulkus kornea bakteri"],"jawaban":"A","penjelasan":"Glaukoma akut sudut tertutup (AACG) adalah emergency oftalmologi dengan trias: sakit kepala hebat, mual muntah, dan penurunan visus mendadak. Tanda: injeksi siliar, kornea edema steamy, COA dangkal, pupil middilated fixed oval. TIO sangat tinggi (>40-80 mmHg). Penyebab: pupillary block akibat contact iris-lens.","slide":10},{"id":"exam-soal-A-21","pertanyaan":"Side effect beta blocker yang berhubungan dengan asma adalah...","pilihan":["Bronkospasme","Takikardia","Hipertensi","Hipoglikemia","Diare"],"jawaban":"A","penjelasan":"Beta blocker non-selektif (propranolol) menghambat reseptor beta-2 di bronkus → bronkospasme. Kontraindikasi pada asma. Beta blocker kardioselektif (metoprolol, bisoprolol) lebih aman tapi tetap hati-hati. Beta-2 agonist (salbutamol) merupakan terapi utama asma.","slide":4},{"id":"exam-soal-A-22","pertanyaan":"Bayi 5 bulan, gerakan kepala terbatas, sulit berpaling, kepala datar satu sisi, bahu mengangkat. Diagnosis?","pilihan":["Tortikolis kongenital","Kista brankial","Kista tiroglossus","Abses leher","Skoliosis servikal"],"jawaban":"A","penjelasan":"Tortikolis kongenital adalah kependekan m. sternocleidomastoideus (fibrosis) yang menyebabkan kepala miring ke sisi lesio (ipsilateral) dan dagu ke sisi kontralateral. Penyebab: trauma kelahiran (breech), intrauterine malposition, atau fibrosis idiopatik. Plagiocephaly (kepala datar satu sisi) akibat posisi terus-menerus.","slide":5},{"id":"exam-soal-A-23","pertanyaan":"Luka bakar kemerahan tanpa bula, nyeri. Derajat? / Luka bakar tidak ada nyeri tekan. Derajat?","pilihan":["Derajat 1 / Derajat 3","Derajat 2a / Derajat 2b","Derajat 2b / Derajat 1","Derajat 3 / Derajat 1","Derajat 4 / Derajat 2a"],"jawaban":"A","penjelasan":"Luka bakar derajat 1: epidermis saja, kemerahan, nyeri, tanpa bulae (contoh: sunburn). Derajat 2: melibatkan dermis, ada bulae. Derajat 2a superficial = bulae + nyeri. Derajat 2b deep = bulae + nyeri BERKURANG. Derajat 3: full thickness (epidermis+dermis+subkutis), pucat/putih/karat, tidak nyeri karena destruksi nervus (tetapi nyeri di perifer). Derajat 4: melibatkan otot/tulang.","slide":5},{"id":"exam-soal-A-24","pertanyaan":"Laki-laki 62 tahun, vesikel multiple aurikularis sinistra, nyeri, pendengaran berkurang, pusing. Saraf terlibat?","pilihan":["N. VII dan N. VIII","N. I dan N. II","N. III dan N. IV","N. V dan N. VI","N. IX dan N. X"],"jawaban":"A","penjelasan":"Ramsay Hunt Syndrome (herpes zoster oticus) adalah reaktivasi VZV di ganglion geniculate (N. VII facial). Trias: (1) vesikel aurikular/external ear, (2) facial paralysis (Bell palsy-like), (3) auditory/vestibular symptoms (tinnitus, HL, vertigo) akibat N. VIII involvement. Tatalaksana: asiklovir + prednison dalam 72 jam.","slide":3},{"id":"exam-soal-A-25","pertanyaan":"Buruh 36 tahun, penurunan pendengaran bilateral, terbiasa suara mesin. Hasil audiometri?","pilihan":["Noise notch 4000 Hz bilateral","Penurunan air conduction saja","Penurunan bone conduction saja","Cookie-bite pattern","Rising curve"],"jawaban":"A","penjelasan":"Noise-induced hearing loss (NIHL) adalah sensorineural hearing loss akibat paparan noise kronis (>85 dB). Tanda audiometri khas: bilateral symmetrical sensorineural hearing loss dengan noise notch di 3000-6000 Hz (peak 4000 Hz). Mekanisme: stereocilia damage di basal turn cochlea (high frequency region).","slide":3},{"id":"exam-soal-A-26","pertanyaan":"Pemuda 24 tahun, perdarahan hidung, rasa asin tenggorokan, darah ke nasofaring-orofaring, hipertensi. Tatalaksana?","pilihan":["Tampon posterior","Tampon anterior","Kepala ditengadahkan","Darah ditelan","Kompresi digital hidung"],"jawaban":"A","penjelasan":"Epistaksis posterior: perdarahan dari plexus Woodruff/faring (posterior nasal cavity). Tanda: darah mengalir ke posterior faring (rasa asin, batuk, hematemesis), tidak terlihat dari anterior nares. Tampon anterior tidak efektif. Perlu tampon posterior (balloon catheter/posterior nasal packing) untuk menekan vessel bleeding.","slide":7},{"id":"exam-soal-A-27","pertanyaan":"Kelainan mata akibat defisiensi vitamin A adalah...","pilihan":["Hipopigmentasi retina","Age-related macular degeneration","Ablasio retina","Katarak senilis","Glaukoma primer"],"jawaban":"A","penjelasan":"Vitamin A (retinol) esensial untuk fototransduksi (rhodopsin di rod cells). Defisiensi menyebabkan: (1) night blindness (xerophthalmia stage 1), (2) conjunctival xerosis (dryness), (3) Bitot spots (foamy patches), (4) corneal xerosis/ulceration/melting, (5) hipopigmentasi retina. AMD, ablasio retina, katarak, dan glaukoma BUKAN akibat defisiensi vitamin A.","slide":13},{"id":"exam-soal-A-28","pertanyaan":"Pembengkakan dari post auricular sampai m. sternocleidomastoideus setelah otitis media akut. Diagnosis?","pilihan":["Abses Bezold","Mastoiditis akut","Abses subperiosteal","Lateral sinus thrombosis","Meningitis"],"jawaban":"A","penjelasan":"Abses Bezold adalah komplikasi otitis media akut/mastoiditis dimana infeksi menyebar melalui mastoid tip (processus mastoideus) yang pneumatized, masuk ke ruang di bawah m. sternocleidomastoideus. Tanda: pembengkakan post-auricular yang meluas ke leher (sulcus retro-mastoideus → SCM).","slide":2},{"id":"exam-soal-A-29","pertanyaan":"Hifema mengisi 1/2 anterior chamber. Grade berapa?","pilihan":["Grade 1","Grade 2","Grade 3","Grade 4","Grade 5"],"jawaban":"C","penjelasan":"Grading hifema: G1 = <1/3 anterior chamber (AC). G2 = 1/3 - 1/2 AC. G3 = >1/2 AC (total/8-ball hifema). G4 = total AC filled with dark/clotted blood. G3-G4 berisiko komplikasi: corneal blood staining, glaucoma sekunder, optic atrophy. Penatalaksanaan: bed rest, eye shield, cycloplegic, IOP control.","slide":11},{"id":"exam-soal-A-30","pertanyaan":"Faktor yang mempengaruhi absorbsi obat tetes mata adalah...","pilihan":["Lamanya obat di prekornea","pH asam saja","Irigasi ke saccus lacrimalis","Ikatan obat pada protein darah","Difusi ke palpebra saja"],"jawaban":"A","penjelasan":"Absorbsi obat tetes mata terjadi melalui kornea (transcorneal) dan konjungtiva. Faktor utama: waktu kontak prekorneal (prekorneal residence time). Hanya 1-5% obat yang masuk ke anterior chamber. Faktor lain: pH, lipophilicity, molecular weight, viscosity, dan nasolacrimal drainage. Nasolacrimal occlusion (menutup punctum) meningkatkan absorbsi dengan memperpanjang waktu kontak.","slide":4},{"id":"exam-soal-A-31","pertanyaan":"Trauma kimia mata: kornea stroma haze, detail iris terlihat, iskemik limbus <1/3. Grade?","pilihan":["Grade 1","Grade 2","Grade 3","Grade 4","Grade 5"],"jawaban":"B","penjelasan":"Grading trauma kimia mata menurut Dua (modifikasi Roper-Hall): G1 = epitelial damage saja, no limbal ischemia, prognosis baik. G2 = hazy cornea tapi iris details visible, limbal ischemia <1/3, prognosis baik. G3 = total epithelial loss, stromal haze (iris details obscured), limbal ischemia 1/3-1/2, prognosis ragu. G4 = opaque cornea (no iris view), limbal ischemia >1/2, prognosis buruk.","slide":11},{"id":"exam-soal-A-32","pertanyaan":"Bayi 5 bulan, ruam merah pipi setelah susu formula, riwayat atopi keluarga. Terapi topikal?","pilihan":["Kortikosteroid topikal rangkaian I-II","Kortikosteroid topikal rangkaian IV","Antibiotik topikal","Kalsipotriol","Retinoid topikal"],"jawaban":"A","penjelasan":"Dermatitis atopik (eksim) adalah dermatitis kronik relapsing dengan pruritus, riwayat atopi personal/keluarga, dan distribusi sesuia usia. Infant: ekstensor, wajah (pipi). Terapi: emolien + kortikosteroid topikal LOW potency (rangkaian I-II) untuk wajah dan infant. Rangkaian IV terlalu kuat untuk wajah/bayi.","slide":5},{"id":"exam-soal-A-33","pertanyaan":"Ny S 25 tahun, benjolan kemerahan pipi, pustul eritema, komedo. Diagnosis?","pilihan":["Acne vulgaris","Rosacea","Folikulitis","Perioral dermatitis","Seborrheic dermatitis"],"jawaban":"A","penjelasan":"Acne vulgaris adalah penyakit pilosebasea kronik dengan 4 patogenesis: hiperkeratinisasi folikel, seborrhea (sekret sebasea berlebih), kolonisasi C. acnes (dulu P. acnes), dan inflamasi. Lesi: komedo (buka/tutup), papul, pustul, nodul, kista. Distribusi: wajah, dada, punggung atas. Terapi: topikal (benzoyl peroxide, retinoid, antibiotik topikal) + sistemik (antibiotik, isotretinoin, hormonal) sesuai severity.","slide":5},{"id":"exam-soal-A-34","pertanyaan":"Faktor risiko paling tinggi untuk melanoma kulit adalah...","pilihan":["Fitzpatrick Skin Phototype I","Fitzpatrick Skin Phototype II","Fitzpatrick Skin Phototype III","Fitzpatrick Skin Phototype IV","Fitzpatrick Skin Phototype V"],"jawaban":"A","penjelasan":"Fitzpatrick Skin Type I (very fair, always burns, never tans) memiliki risiko melanoma tertinggi. Type II juga berisiko tinggi. Risk ratio: Type I-II 2-3x higher than Type III-IV. Melanoma: #5 cancer terbanyak, #1 cause of skin cancer death. UV exposure = primary risk factor.","slide":5},{"id":"exam-soal-A-35","pertanyaan":"Faktor prognostik yang dinilai pada SCORTEN, KECUALI...","pilihan":["Usia >40 tahun","Denyut jantung >120x/menit","Serum bikarbonat <20 mEq/L","Kolesterol total","Glukosa serum >252 mg/dL"],"jawaban":"D","penjelasan":"SCORTEN (Severity-of-Illness Score for TEN) adalah scoring system untuk memprediksi mortality SJS/TEN. 7 faktor: (1) age ≥40, (2) heart rate ≥120, (3) cancer/hematologic malignancy, (4) BSA detached >10%, (5) serum bicarbonate <20, (6) glucose >252, (7) BUN >28. Kolesterol BUKAN komponen SCORTEN. Score 0-1 = mortality 3.2%; 2 = 12.1%; 3 = 35.3%; 4 = 58.3%; ≥5 = >90%.","slide":5},{"id":"exam-soal-A-36","pertanyaan":"Luka robekan menembus 2 sisi karena pisau disebut...","pilihan":["Vulnus perforatum","Vulnus laceratum","Vulnus punctum","Vulnus scissum","Vulnus contusum"],"jawaban":"A","penjelasan":"Vulnus perforatum (perforating wound): luka tembus yang masuk dan keluar (through-and-through), menembus 2 sisi struktur. Vulnus laceratum: luka robek (tearing). Vulnus punctum: luka tusuk. Vulnus scissum: luka sayat (incised/cut). Vulnus contusum: luka tumpul (contused/abraded).","slide":5},{"id":"exam-soal-A-37","pertanyaan":"Laki-laki IMS, gram negatif diplococcus intraseluler. Pengobatan?","pilihan":["Seftriakson 250-500 mg IM dosis tunggal","Azitromisin 1 gram PO dosis tunggal","Doksiklin 100 mg PO BID 7 hari","Metronidazol 2 gram PO dosis tunggal","Asiklovir 400 mg PO 5x/hari 7 hari"],"jawaban":"A","penjelasan":"Gonore uretritis: Neisseria gonorrhoeae (gram negative diplococcus intraseluler di PMN). Terapi: ceftriaxone 250-500mg IM single dose (first-line per CDC 2021). Koinfeksi Chlamydia: add doxycycline 100mg BID x 7 hari. Resistance to fluoroquinolones widespread.","slide":4},{"id":"exam-soal-A-38","pertanyaan":"Spaghetti and meatballs pada mikroskop. Diagnosis?","pilihan":["Pitiriasis versikolor","Dermatofitosis","Kandidiasis kutis","Eritrasma","Pitiriasis rosea"],"jawaban":"A","penjelasan":"Pitiriasis versikolor (tinea versicolor) adalah infeksi superficial oleh Malassezia furfur (lipophilic yeast, normal flora). KOH: 'spaghetti and meatballs' = hifa pendek (spaghetti) + yeast cells spherical (meatballs). Lesi: hipopigmentasi/hiperpigmentasi dengan skuama halus. Terapi: selenium sulfide 2.5% lotion, ketoconazole shampoo, topical azoles.","slide":4},{"id":"exam-soal-A-39","pertanyaan":"Wanita 44 tahun, gatal vagina, duh encer, mikroskopi: blastospora. Diagnosis?","pilihan":["Kandidiasis vulvovaginitis","Bacterial vaginosis","Trichomoniasis","Atrophic vaginitis","Gonore"],"jawaban":"A","penjelasan":"Kandidiasis vulvovaginitis: infeksi Candida albicans (90%) atau C. glabrata. Tanda: pruritus vulvae intens, discharge putih kental seperti cottage cheese, vulvar erythema/edema. pH normal (<4.5). KOH/pap smear: pseudohyphae, blastospores, budding yeast. Terapi: azol topikal (klotrimazole, mikonazole) 1-7 hari atau fluconazole 150mg PO single dose.","slide":5},{"id":"exam-soal-A-40","pertanyaan":"Robekan iris mengenai sfingter → pendarahan anterior chamber. Diagnosis?","pilihan":["Hifema","Hipopion","Hemofthalm","Vitreous hemorrhage","Subkonjungtival hemorrhage"],"jawaban":"A","penjelasan":"Hifema adalah penumpukan darah di anterior chamber (AC) akibat trauma tumpul yang merobekkan vessel di iris root atau ciliary body. Sfingter iris injury → bleeding into AC. Grading berdasarkan volume: G1(<1/3), G2(1/3-1/2), G3(>1/2), G4(total/8-ball). Komplikasi: rebleed (day 2-5), corneal blood staining, secondary glaucoma.","slide":11}];
