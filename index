    reconcileSlideTotals();
    var checks = [];
    function add(name, ok, detail) { checks.push({ name: name, ok: !!ok, detail: String(detail == null ? "" : detail) }); }
    var buttons = $all("button, a[href], a[onclick], [role='button']");
    var noContract = buttons.filter(function(el){ return !el.dataset.sapientOutputContract; });
    var duplicateNav = $all('[data-pillar-nav="true"], [data-dynamic-nav="true"]').length;
    var dyn = $("#dynamicSlides");
