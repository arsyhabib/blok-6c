  var STORAGE_KEYS = { theme:"atlas-tema", visited:"atlas-slide", bookmarks:"atlas-penanda", notes:"atlas-catatan", identity:"atlas-identitas" };
  var Z_INDEX_MAP = { base:1, content:10, sidebar:320, topbar:360, slideHeadbar:220, fab:300, drawer:600, overlayBackdrop:900, overlayPanel:950, modal:1000, quizRecall:1100, quickReference:1120, splitScreenFullscreen:1130, toast:1200, tooltip:1300 };

