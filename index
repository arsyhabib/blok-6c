    add("buttons have output contract", noContract.length === 0, noContract.length + " missing of " + buttons.length);
    add("legacy goToSlide callable", typeof window.goToSlide === "function", typeof window.goToSlide);
    add("legacy jawabKuis callable", typeof window.jawabKuis === "function", typeof window.jawabKuis);
    add("legacy search callable", typeof window.bukaCari === "function" || typeof window.toggleCari === "function" || typeof window.lakukanPencarian === "function", "search hooks");
    add("legacy flashcard callable", typeof window.bukaFlashcard === "function" || typeof window.bukaFlash === "function", "flashcard hooks");
    add("SAPIENT store callable", !!window.sapientEngineStore && typeof window.processAssessmentAnalytics === "function", "store + analytics");
    add("action registry public", !!window.SAPIENT_ACTION_REGISTRY && typeof window.sapientDispatchAction === "function", Object.keys(window.SAPIENT_ACTION_REGISTRY || {}).length);
    add("content cross-link graph public", !!graph["slide-0"], Object.keys(graph).join(","));
    add("device controller public", !!window.SAPIENTDeviceModeController && !!document.body.getAttribute("data-sapient-effective-layout"), document.body.getAttribute("data-sapient-effective-layout"));
    add("welcome redesigned", !!$(".sapient-v2-entry"), "entry shell");
    add("login guest available", typeof window.sapientGuestLogin === "function", "guest login");
    add("local generated icons referenced", assets.length >= 18, assets.length);
    add("no horizontal overflow", document.documentElement.scrollWidth <= window.innerWidth + 2 || !realBrowserMode, document.documentElement.scrollWidth + "/" + window.innerWidth);
    add("minimum slide count reconciled", !window.App || App.totalSlide === Math.max(1, $all(".slide-section").length), window.App ? App.totalSlide : "no App");
    try { localStorage.setItem("_sapient_v2_test", "1"); localStorage.removeItem("_sapient_v2_test"); add("localStorage writable", true, "ok"); } catch (e) { add("localStorage writable", false, e.message); }
    var passed = checks.filter(function(item){ return item.ok; }).length;
    var pct = Math.round((passed / checks.length) * 1000) / 10;
    var report = { generatedAt: new Date().toISOString(), compliancePercent: pct, pass: passed, total: checks.length, status: pct >= 95 ? "PASS" : "REVIEW", checks: checks, viewport: buildDeviceSnapshot() };
    localStorage.setItem(AUDIT_STORAGE_KEY, JSON.stringify(report));
    if (window.sapientEngineStore && typeof window.sapientEngineStore.writeStateToLocalStorageCache === "function") window.sapientEngineStore.writeStateToLocalStorageCache();
    return report;
  }

  function showAudit() {
    var report = auditAll(true);
