  function buildFallbackQuizForSlide(slide){
    var body = (slide && (slide.text || strip(slide.html)) || "").split(".").map(function(x){return x.trim();}).filter(function(x){return x.length > 28;});
    var title = slide ? slide.title : "Materi aktif";
    var seed = body[0] || ("Konsep utama pada " + title + " perlu dipahami secara runtut.");
    return [{
      index:0,
      question:"[Fallback] Apa fokus utama dari slide \"" + title + "\"?",
      options:["Mengenali konsep inti dan hubungan klinis pada materi aktif","Menghafal tanpa memahami konteks klinis","Mengabaikan istilah medis yang muncul","Membuka fitur lain tanpa membaca materi"],
      correct:0,
      explanation:"Fallback quiz dibuat dari konten slide aktif karena bank kuis JSON untuk slide ini kosong. Cuplikan materi: " + seed.slice(0,220),
      slide: slide ? slide.index : 0,
      fallback:true
    },{
      index:1,
      question:"[Fallback] Strategi belajar paling tepat untuk slide ini adalah...",
      options:["Membaca ringkasan, menandai istilah penting, lalu menguji recall","Langsung menutup slide setelah melihat judul","Mengandalkan timer tanpa membaca isi","Menghapus progress agar materi terlihat baru"],
      correct:0,
      explanation:"Slide aktif tetap bisa diuji dengan active recall walau belum punya quiz asli. Tambahkan quiz JSON eksternal nanti tanpa mengubah UI controller.",
      slide: slide ? slide.index : 0,
      fallback:true
    }];
  }

  function installQuizRecallFallback(){
    var legacyOpen = window.bukaKuisSlide;
    window.bukaKuisSlide = function(){
      var slides = normalizeSlides(window.SLIDE_DATA || null);
      var idx = window.App && typeof App.slideAktif === "number" ? App.slideAktif : 0;
      var slide = slides[idx] || slides[0] || { id:"slide-0", index:0, title:"Home & Ringkasan", text:text(qs("#slide-0")) };
      var hasReal = slide.quizzes && slide.quizzes.length;
      if (hasReal && typeof legacyOpen === "function") return legacyOpen.apply(this, arguments);
      if (typeof window.tutupSemuaOverlay === "function") window.tutupSemuaOverlay();
      window.kuisSlideState = window.kuisSlideState || {};
      kuisSlideState.soal = buildFallbackQuizForSlide(slide);
      kuisSlideState.slideId = slide.id;
      kuisSlideState.slideIndex = slide.index || idx;
      kuisSlideState.aktif = 0;
      kuisSlideState.jawaban = {};
      kuisSlideState.marked = {};
      kuisSlideState.sedangBerjalan = false;
      var titleEl = qs("#kuisSlideJudul");
      if (titleEl) titleEl.textContent = "📝 Kuis: " + slide.title + " (Fallback)";
      var body = qs("#kuisSlideBody");
      if (body) body.innerHTML = '<div style="text-align:center;padding:30px 16px"><div style="font-size:3rem;margin-bottom:8px">📝</div><h2 style="font-size:1.15rem;margin-bottom:8px;color:var(--accent-teal)">Kuis Recall Slide</h2><p style="color:var(--text-muted);margin:12px 0 18px;font-size:0.85rem">Bank kuis asli belum tersedia untuk slide ini. Fallback quiz nyata dibuat dari konten slide aktif.</p><button class="welcome-btn" onclick="mulaiKuisSlide()" style="padding:12px 36px;font-size:0.95rem">▶ Mulai Kuis</button></div>';
      var timer = qs("#kuisSlideTimer");
      if (timer) timer.style.display = "none";
      var overlay = qs("#kuisSlideOverlay");
      if (overlay) overlay.classList.add("buka");
    };
  }

  function renderFlashcardPanel(){
    if(!window.App || !App.flashcards || !App.flashcards.length) return;
    var f = App.flashcards[App.flashAktif || 0];
