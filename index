    if (warnings.length) console.warn("[Sapient Canonical selfCheck]", report, warnings);
    else console.info("[Sapient Canonical selfCheck]", report);
    return report;
  }

  function startApp(){
    cleanOnboardingChrome();
    normalizeFabLabels();
    ensureRunningTextSpeed();
    installQuizRecallFallback();
    installAccessibility();
    window.safeStorage = safeStorage;
    window.APP_CONFIG = APP_CONFIG;
    window.STORAGE_KEYS = STORAGE_KEYS;
    window.Z_INDEX_MAP = Z_INDEX_MAP;
    window.normalizeSlides = normalizeSlides;
    window.normalizeQuizzes = normalizeQuizzes;
