function renderSlides(slideData) {
  const container = document.getElementById('dynamicSlides');
  if (!container) { console.error('[RENDER] dynamicSlides not found'); return; }

  // PRODUCTION VACCINE: idempotent render. Re-rendering SLIDE_DATA must not duplicate slides/nav.
  container.innerHTML = '';
  const navTreeForCleanup = document.getElementById('navTree');
  if (navTreeForCleanup) {
    navTreeForCleanup.querySelectorAll('[data-dynamic-nav="true"], [data-pillar-nav="true"]').forEach(function(el){ el.remove(); });
  }

  // Validate input data first
  const errors = validateSlideData(slideData);
  if (errors.length > 0) {
    console.error('[RENDER] Validation failed:', errors);
    return;
  }

  slideData.slides.forEach((slide, index) => {
    const section = buildSlideSection(slide, index, slideData.slides.length);
    container.appendChild(section);
  });

  // Post-render hooks
  buildSearchIndex(slideData);
  updateNavTree(slideData);
  buildProgressData(slideData);

  console.log(`[RENDER] ${slideData.slides.length} slides injected successfully`);
}

// ============================================================
// B. SLIDE-LEVEL BUILDERS
// ============================================================

/**
 * Builds a complete <section> element for a single slide.
 * @param {Object} slide - Slide data object
 * @param {number} index - Zero-based index of this slide in the array
 * @param {number} total - Total number of slides
 * @returns {HTMLElement} The <section> DOM node
 */
function buildSlideSection(slide, index, total) {
  const section = document.createElement('section');
  section.className = 'slide-section' + (slide.isMain ? ' slide-utama active' : '');
  section.id = slide.id;
  section.dataset.title = slide.title;

  // Child builders in exact order
  const headbar = buildHeadbar(slide, index, total);
  if (headbar) section.appendChild(headbar);

  const statsBar = buildStatsBar(slide.stats);
  if (statsBar) section.appendChild(statsBar);

  const aksiBar = buildAksiBar(slide.actions, slide.quizzes);
  if (aksiBar) section.appendChild(aksiBar);

  // Auto-add quiz button if slide has quizzes
  if (slide.quizzes && slide.quizzes.length > 0) {
    const quizBar = document.createElement('div');
    quizBar.className = 'slide-aksi-bar';
    quizBar.style.marginTop = '10px';
    const quizCell = document.createElement('div');
    quizCell.className = 'aksi-cell';
    quizCell.setAttribute('onclick', 'bukaKuisSlide()');
    quizCell.style.cssText = 'background:linear-gradient(135deg, rgba(0,201,255,0.12), rgba(167,139,250,0.08)); border-color:rgba(0,201,255,0.3);';
    quizCell.innerHTML = '<div class="aksi-icon" style="background:linear-gradient(135deg, var(--accent-teal), var(--accent-cyan)); display:flex; align-items:center; justify-content:center; color:#fff; font-size:1.35rem; width:42px; height:42px; border-radius:12px; flex-shrink:0;">📝</div><div class="aksi-info" style="flex:1; min-width:0;"><div class="aksi-lbl" style="font-size:0.85rem; font-weight:800; color:var(--text-primary); line-height:1.2;">Kuis Slide (' + slide.quizzes.length + ' soal)</div><div class="aksi-sub" style="font-size:0.7rem; color:var(--text-muted); margin-top:1px; line-height:1.3; font-weight:500;">Latihan soal pada materi ini</div></div>';
    quizBar.appendChild(quizCell);
    section.appendChild(quizBar);
  }

  const cards = buildCards(slide.cards, slide.id);
  if (cards) cards.forEach(c => section.appendChild(c));

  const tables = buildTables(slide.tables);
  if (tables) tables.forEach(t => section.appendChild(t));

  // KUIS INLINE DIHAPUS - Kuis tetap tersedia melalui tombol "KUIS SLIDE"
  // const quizzes = buildQuizzes(slide.quizzes, slide.id);
  // if (quizzes) quizzes.forEach(q => section.appendChild(q));

  if (slide.flashcards && slide.flashcards.length > 0) {
    window.ATLAS_FLASHCARDS = window.ATLAS_FLASHCARDS || [];
    slide.flashcards.forEach(fc => {
      window.ATLAS_FLASHCARDS.push(buildFlashcard(fc, slide.id));
    });
  }

  if (slide.terms && slide.terms.length > 0) {
    // Terms are rendered inline within cards; this collects them for indexing
    section._terms = slide.terms;
  }

  return section;
}

/**
 * Builds the slide headbar: .slide-headbar > .slide-headbar-num + .slide-headbar-text + .slide-headbar-progress
 * @param {Object} slide - Slide data
 * @param {number} index - Slide index
 * @param {number} total - Total slides
 * @returns {HTMLElement|null}
 */
function buildHeadbar(slide, index, total) {
  if (!slide.number && !slide.title) return null;

  const hb = document.createElement('div');
  hb.className = 'slide-headbar';

  // Number / Home icon
  const num = document.createElement('div');
  num.className = 'slide-headbar-num' + (slide.isMain ? ' home' : '');
  num.textContent = slide.isMain ? (slide.emoji || '\u{1F3E0}') : slide.number;
  hb.appendChild(num);

  // Text container
  const textWrap = document.createElement('div');
  textWrap.className = 'slide-headbar-text';

  const title = document.createElement('div');
  title.className = 'slide-headbar-title';
  title.textContent = slide.title;
  textWrap.appendChild(title);

  if (slide.subtitle) {
    const desc = document.createElement('div');
    desc.className = 'slide-headbar-desc';
    desc.textContent = slide.subtitle;
    textWrap.appendChild(desc);
  }
  hb.appendChild(textWrap);

  // Progress
  if (slide.number && !slide.isMain) {
    const prog = document.createElement('div');
    prog.className = 'slide-headbar-progress';
    prog.textContent = `${slide.number}/${total}`;
    hb.appendChild(prog);
