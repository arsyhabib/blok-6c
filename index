// FIX 68: Quiz Performance by Topic
function getQuizPerformanceByTopic() {
  try {
    var quizData = JSON.parse(localStorage.getItem('atlas-quiz') || '{}');
    var topicPerformance = {};
    // Map quiz IDs to slide topics
    var topicMap = {};
    for (var i = 0; i < TOTAL_SLIDES; i++) {
      topicMap[i] = SLIDE_NAMES[i] || 'Slide ' + (i+1);
    }
    for (var qid in quizData) {
      var parts = qid.split('-');
      var slideIdx = parseInt(parts[1]) || 0;
      var topic = topicMap[slideIdx] || 'Umum';
      if (!topicPerformance[topic]) topicPerformance[topic] = { total: 0, correct: 0 };
      topicPerformance[topic].total++;
      if (quizData[qid].benar) topicPerformance[topic].correct++;
    }
    return topicPerformance;
  } catch(e) { return {}; }
}

// FIX 69: Identify Weak Topics
function getWeakTopics() {
  var perf = getQuizPerformanceByTopic();
  var weak = [];
  for (var topic in perf) {
    var pct = perf[topic].total > 0 ? (perf[topic].correct / perf[topic].total) * 100 : 0;
    if (pct < 70 && perf[topic].total >= 2) weak.push({ topic: topic, pct: Math.round(pct) });
  }
  weak.sort(function(a, b) { return a.pct - b.pct; });
  return weak.slice(0, 5);
}

