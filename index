/**
 * Builds inverted search index from all slide content.
 * @param {Object} slideData
 */
function buildSearchIndex(slideData) {
  const index = {};

  slideData.slides.forEach(slide => {
    // Index slide title
    addToIndex(index, slide.title, { slideId: slide.id, type: 'title', context: slide.title });
    if (slide.subtitle) addToIndex(index, slide.subtitle, { slideId: slide.id, type: 'subtitle', context: slide.subtitle });

    // Index cards
    if (slide.cards) {
      slide.cards.forEach(card => {
        addToIndex(index, card.title, { slideId: slide.id, type: 'card', context: card.title });
        if (card.content) {
          // Strip HTML tags for indexing
          const text = card.content.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
          const words = text.split(/\s+/).filter(w => w.length > 2);
          words.forEach(w => addToIndex(index, w, { slideId: slide.id, type: 'content', context: text.substring(0, 150) }));
        }
      });
    }

    // Index terms
    if (slide.terms) {
      slide.terms.forEach(term => {
        addToIndex(index, term.term, { slideId: slide.id, type: 'term', context: term.arti });
        addToIndex(index, term.arti, { slideId: slide.id, type: 'term', context: term.term });
      });
    }

    // Index quizzes
    if (slide.quizzes) {
      slide.quizzes.forEach(qz => {
        addToIndex(index, qz.question.replace(/<[^>]*>/g, ''), { slideId: slide.id, type: 'quiz', context: qz.question.substring(0, 150) });
      });
    }

    // Index tables
    if (slide.tables) {
      slide.tables.forEach((tbl, ti) => {
        tbl.headers.forEach(h => addToIndex(index, h, { slideId: slide.id, type: 'table', context: `Tabel: ${h}` }));
      });
    }
  });

  window.SEARCH_INDEX = index;
  console.log(`[SEARCH] Index built: ${Object.keys(index).length} unique terms`);
}

/**
 * Helper: adds a term to the inverted index.
 */
function addToIndex(index, text, entry) {
  if (!text) return;
  const normalized = text.toLowerCase().trim();
  if (normalized.length < 2) return;
  if (!index[normalized]) index[normalized] = [];
  // Avoid duplicates for same slide+type
  const exists = index[normalized].some(e => e.slideId === entry.slideId && e.type === entry.type);
  if (!exists) index[normalized].push(entry);
}

/**
 * Dynamically appends nav-items to #navTree for Slide-1 to Slide-N.
 * @param {Object} slideData
 */
function updateNavTree(slideData) {
  const navTree = document.getElementById('navTree');
  if (!navTree) { console.error('[NAV] navTree not found'); return; }

  slideData.slides.forEach((slide, idx) => {
    // Skip if already exists (slide-00 is static)
    if (document.querySelector(`#${CSS.escape(slide.id)}`)) {
      // Actually the slide section exists, but nav item might not
    }

    const item = document.createElement('div');
    item.className = 'nav-item';
    item.setAttribute('data-dynamic-nav', 'true');

    const link = document.createElement('a');
    link.className = 'nav-link';
    link.setAttribute('onclick', `goToSlide(${idx + 1})`);

    const num = document.createElement('span');
    num.className = 'num';
    num.textContent = String(idx + 1).padStart(2, '0');
    link.appendChild(num);

    const label = document.createElement('span');
    label.textContent = slide.title;
    link.appendChild(label);

    item.appendChild(link);

    // Optional nav-children for card anchors
    if (slide.cards && slide.cards.length > 0) {
      const toggle = document.createElement('span');
      toggle.className = 'nav-toggle collapsed';
      toggle.setAttribute('onclick', 'event.preventDefault();toggleNavChildren(this)');
      toggle.innerHTML = '<svg aria-hidden="true" fill="none" focusable="false" height="12" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="12"><path d="m6 9 6 6 6-6"/></svg>';
      link.appendChild(toggle);

      const children = document.createElement('div');
      children.className = 'nav-children collapsed';
      slide.cards.forEach(card => {
        const child = document.createElement('a');
        child.className = 'nav-child-link';
        child.setAttribute('onclick', `goToSlide(${idx + 1});bukaEkspansi('${card.id}')`);
        child.textContent = card.title;
        children.appendChild(child);
      });
      item.appendChild(children);
    }

    navTree.appendChild(item);
  });

  console.log(`[NAV] ${slideData.slides.length} nav items appended`);
}

