// State kuis slide
var kuisSlideState = {
  soal: [],
  aktif: 0,
  jawaban: {},
  marked: {},
  timer: null,
  detikSisa: 0,
  sedangBerjalan: false,
  slideId: null,
  slideIndex: 0
};

function bukaKuisSlide() {
  tutupSemuaOverlay();
  // Ambil soal dari slide aktif
  var slideIdx = App.slideAktif;
  var slideId = 'slide-' + slideIdx;
  var slideData = null;

  if (window.SLIDE_DATA && window.SLIDE_DATA.slides) {
    slideData = window.SLIDE_DATA.slides.find(function(s) { return s.id === slideId; });
  }

  if (!slideData || !slideData.quizzes || slideData.quizzes.length === 0) {
    showToast('📭 Slide ini belum memiliki soal kuis');
    return;
  }

  kuisSlideState.soal = slideData.quizzes.map(function(q, i) {
    return {
      index: i,
      question: q.question,
      options: q.options,
      correct: q.correct,
      explanation: q.explanation,
      slide: slideIdx
    };
  });
  kuisSlideState.slideId = slideId;
  kuisSlideState.slideIndex = slideIdx;
  kuisSlideState.aktif = 0;
  kuisSlideState.jawaban = {};
  kuisSlideState.marked = {};
  kuisSlideState.sedangBerjalan = false;

  // Update judul
  var judulEl = document.getElementById('kuisSlideJudul');
  if (judulEl) {
    judulEl.textContent = '📝 Kuis: ' + (slideData.title || ('Slide ' + slideIdx));
  }

  // Reset tampilan
  var body = document.getElementById('kuisSlideBody');
  if (body) {
    body.innerHTML = '<div style="text-align:center;padding:30px 16px">' +
      '<div style="font-size:3rem;margin-bottom:8px">📝</div>' +
      '<h2 style="font-size:1.15rem;margin-bottom:8px;color:var(--accent-teal)">Kuis Recall Slide</h2>' +
      '<p style="color:var(--text-muted);margin:12px 0 18px;font-size:0.85rem">' + kuisSlideState.soal.length + ' soal pada slide ini.<br>Timer: <strong style="color:var(--accent-amber)">1.5 menit per soal</strong></p>' +
      '<button class="welcome-btn" onclick="mulaiKuisSlide()" style="padding:12px 36px;font-size:0.95rem">▶ Mulai Kuis</button>' +
      '</div>';
  }

  // Hide timer
  var timerEl = document.getElementById('kuisSlideTimer');
  if (timerEl) timerEl.style.display = 'none';

  document.getElementById('kuisSlideOverlay').classList.add('buka');
}

function tutupKuisSlide() {
  stopKuisSlideTimer();
  document.getElementById('kuisSlideOverlay').classList.remove('buka');
}

function mulaiKuisSlide() {
  kuisSlideState.sedangBerjalan = true;
  kuisSlideState.aktif = 0;
  kuisSlideState.jawaban = {};
  kuisSlideState.marked = {};

  // Timer: 1.5 menit per soal = 90 detik per soal
  var totalDetik = kuisSlideState.soal.length * 90;
  kuisSlideState.detikSisa = totalDetik;

  // Show timer
  var timerEl = document.getElementById('kuisSlideTimer');
  if (timerEl) timerEl.style.display = 'inline-flex';

  startKuisSlideTimer();
  renderKuisSlideSoal();
}

function startKuisSlideTimer() {
  stopKuisSlideTimer();
  updateKuisSlideTimerDisplay();
  kuisSlideState.timer = setInterval(function() {
    kuisSlideState.detikSisa--;
    updateKuisSlideTimerDisplay();
    if (kuisSlideState.detikSisa <= 0) {
      stopKuisSlideTimer();
      selesaiKuisSlide();
    }
  }, 1000);
}

function stopKuisSlideTimer() {
  if (kuisSlideState.timer) {
    clearInterval(kuisSlideState.timer);
    kuisSlideState.timer = null;
  }
}

function updateKuisSlideTimerDisplay() {
  var m = Math.floor(kuisSlideState.detikSisa / 60);
  var s = kuisSlideState.detikSisa % 60;
  var display = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
  var el = document.getElementById('kuisSlideTimerDisplay');
  if (el) el.textContent = display;

  var timerEl = document.getElementById('kuisSlideTimer');
  if (timerEl) {
    timerEl.classList.remove('warning', 'danger');
    if (kuisSlideState.detikSisa <= 30) {
      timerEl.classList.add('danger');
    } else if (kuisSlideState.detikSisa <= 120) {
      timerEl.classList.add('warning');
    }
  }
}

function renderKuisSlideSoal() {
  var soal = kuisSlideState.soal[kuisSlideState.aktif];
  if (!soal) return;

  var total = kuisSlideState.soal.length;
  var current = kuisSlideState.aktif;
  var sudahDijawab = kuisSlideState.jawaban[current] !== undefined;
  var jawabanUser = kuisSlideState.jawaban[current];

  var html = '<div style="padding:8px 0">';

  // Progress bar
  html += '<div style="margin-bottom:16px">' +
    '<div style="display:flex;justify-content:space-between;font-size:0.75rem;color:var(--text-muted);margin-bottom:6px">' +
    '<span>Soal ' + (current + 1) + ' dari ' + total + '</span>' +
    '<span>' + Object.keys(kuisSlideState.jawaban).length + '/' + total + ' dijawab</span>' +
    '</div>' +
    '<div style="height:6px;background:var(--bg-elevated);border-radius:3px;overflow:hidden">' +
    '<div style="height:100%;background:linear-gradient(90deg,var(--accent-teal),var(--accent-cyan));border-radius:3px;transition:width 0.3s;width:' + ((current + 1) / total * 100) + '%"></div>' +
    '</div>' +
    '</div>';

  // Question
  html += '<div style="font-size:1.05rem;font-weight:700;line-height:1.6;margin-bottom:20px;padding:16px;background:var(--bg-elevated);border-radius:12px;border-left:4px solid var(--accent-teal)">' +
    soal.question + '</div>';

  // Options
  var letters = ['A', 'B', 'C', 'D', 'E'];
  soal.options.forEach(function(opt, idx) {
    var letter = letters[idx] || String.fromCharCode(65 + idx);
    var isCorrect = idx === soal.correct;
    var isSelected = jawabanUser === idx;
    var btnClass = 'kuis-pilihan';
    var style = '';

    if (sudahDijawab) {
      if (isCorrect) {
        btnClass += ' benar';
      } else if (isSelected && !isCorrect) {
        btnClass += ' salah';
      } else {
        btnClass += ' nonaktif';
      }
    }

    html += '<button class="' + btnClass + '" ' + (sudahDijawab ? 'disabled' : 'onclick="jawabKuisSlide(' + idx + ')"') + ' style="margin-bottom:10px;display:flex;align-items:flex-start;gap:12px;text-align:left;width:100%;padding:14px 16px;border-radius:12px;border:2px solid var(--glass-border);background:var(--bg-elevated);color:var(--text-primary);font-family:inherit;font-size:0.92rem;cursor:pointer;transition:all 0.25s ease;line-height:1.5">' +
      '<span style="flex-shrink:0;width:32px;height:32px;border-radius:50%;background:' + (sudahDijawab && isCorrect ? 'var(--accent-emerald)' : (sudahDijawab && isSelected ? 'var(--accent-rose)' : 'var(--bg-card)')) + ';color:' + (sudahDijawab && (isCorrect || isSelected) ? '#fff' : 'var(--text-muted)') + ';display:flex;align-items:center;justify-content:center;font-weight:800;font-size:0.85rem;border:2px solid ' + (sudahDijawab && isCorrect ? 'var(--accent-emerald)' : (sudahDijawab && isSelected ? 'var(--accent-rose)' : 'var(--glass-border)')) + '">' + letter + '</span>' +
      '<span style="flex:1;padding-top:4px">' + opt + '</span>' +
      '</button>';
  });

  // Explanation (show after answering)
  if (sudahDijawab && soal.explanation) {
    var isCorrect = jawabanUser === soal.correct;
    html += '<div style="margin-top:16px;padding:16px;background:' + (isCorrect ? 'rgba(52,211,153,0.08)' : 'rgba(251,113,133,0.08)') + ';border:2px solid ' + (isCorrect ? 'var(--accent-emerald)' : 'var(--accent-rose)') + ';border-radius:12px;animation:fadeInUp 0.4s ease">' +
      '<div style="font-weight:800;font-size:0.8rem;text-transform:uppercase;letter-spacing:1px;color:' + (isCorrect ? 'var(--accent-emerald)' : 'var(--accent-rose)') + ';margin-bottom:8px">' + (isCorrect ? '✓ Penjelasan' : '✗ Penjelasan') + '</div>' +
      '<div style="font-size:0.9rem;line-height:1.7;color:var(--text-secondary)">' + soal.explanation + '</div>' +
      '</div>';
  }

  // Navigation dots
  html += '<div class="stress-nav-dots" style="margin-top:20px">';
  for (var i = 0; i < total; i++) {
    var dotClass = 'stress-dot';
    if (i === current) dotClass += ' current';
    else if (kuisSlideState.jawaban[i] !== undefined) {
      var q = kuisSlideState.soal[i];
      if (kuisSlideState.jawaban[i] === q.correct) dotClass += ' answered';
      else dotClass += ' wrong';
    }
    if (kuisSlideState.marked[i]) dotClass += ' marked';
    html += '<button class="' + dotClass + '" onclick="navKuisSlide(' + i + ')" title="Soal ' + (i + 1) + '">' + (i + 1) + '</button>';
  }
  html += '</div>';

  // Action buttons
  html += '<div style="display:flex;gap:10px;justify-content:center;margin-top:16px;flex-wrap:wrap">';

  // Mark button
  var isMarked = !!kuisSlideState.marked[current];
  html += '<button class="mark-btn' + (isMarked ? ' marked' : '') + '" onclick="toggleMarkKuisSlide()">' + (isMarked ? '🔖 Ditandai' : '🏷️ Tandai') + '</button>';

