  statsArray.forEach(stat => {
    if (stat.emoji) {
      const emoji = document.createElement('div');
      emoji.className = 'stat-emoji';
      emoji.textContent = stat.emoji;
      bar.appendChild(emoji);
    }

    const cell = document.createElement('div');
