function goOnboard(n) {
  // Hide all slides
  for (var i = 1; i <= 5; i++) {
    document.getElementById('onboard-' + i).classList.remove('active');
  }
  // Show target slide
  document.getElementById('onboard-' + n).classList.add('active');
  App.onboardSlide = n;

  // Update global dots indicator
  var dots = document.querySelectorAll('#globalOnboardDots .dot');
  dots.forEach(function(dot) {
    dot.classList.toggle('active', parseInt(dot.getAttribute('data-slide')) === n);
  });

  // Sembunyikan tombol skip saat di slide 4 (login) dan slide 5 (info)
  var skipBtn = document.querySelector('.skip-btn');
  if (skipBtn) {
    skipBtn.style.display = (n === 4 || n === 5) ? 'none' : 'block';
  }
}
