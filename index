// ===== FIX 77: Search Highlight in Content =====
function highlightInContent(keyword) {
  if (!keyword || keyword.length < 2) return;
  var active = document.querySelector('.slide-section.active');
  if (!active) return;
  var regex = new RegExp('(' + keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
  // Only highlight in text nodes, not in scripts or styles
  var walker = document.createTreeWalker(active, NodeFilter.SHOW_TEXT, null, false);
  var nodes = [];
  while (walker.nextNode()) nodes.push(walker.currentNode);
  nodes.forEach(function(node) {
    if (node.parentNode.tagName === 'SCRIPT' || node.parentNode.tagName === 'STYLE') return;
    if (regex.test(node.textContent)) {
      var span = document.createElement('span');
      span.innerHTML = node.textContent.replace(regex, '<mark style="background:rgba(0,201,255,0.3);color:inherit;border-radius:2px;">$1</mark>');
      node.parentNode.replaceChild(span, node);
    }
  });
}

// ===== FIX 78: Remove Search Highlights =====
function removeHighlights() {
  document.querySelectorAll('mark').forEach(function(mark) {
    var parent = mark.parentNode;
    parent.replaceChild(document.createTextNode(mark.textContent), mark);
    parent.normalize();
  });
}

