  position:fixed;bottom:80px;left:50%;transform:translateX(-50%) translateY(100px);
  background:var(--bg-elevated);border:1px solid var(--accent-teal);color:var(--accent-teal);
  padding:10px 20px;border-radius:var(--radius-md);font-size:0.85rem;z-index:250;
  opacity:0;transition:all 0.3s ease;pointer-events:none;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ===== DASHBOARD ===== */
.dashboard-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin:16px 0}
.dashboard-card{
  background:var(--bg-elevated);border-radius:var(--radius-md);padding:16px;
  text-align:center;border:1px solid var(--glass-border);
}
.dashboard-card .nilai{font-size:1.6rem;font-weight:800;color:var(--accent-teal)}
.dashboard-card .label{font-size:0.72rem;color:var(--text-muted);margin-top:4px;text-transform:uppercase;letter-spacing:0.5px}

/* ===== PRINT ===== */
@media print{
  .sidebar,.topbar,.fab-container,.progress-ring{display:none!important}
  .main-content{margin-left:0!important}
  .slide-section{display:block!important;page-break-after:always}
  .ekspansi-body{max-height:none!important}
  .sub-body{max-height:none!important}
}

/* ===== SIMPLESPEAK TOGGLE ===== */
.simpel-toggle{
  display:flex;align-items:center;gap:8px;padding:6px 12px;
  border-radius:20px;border:1px solid var(--glass-border);
  background:var(--bg-elevated);cursor:pointer;transition:var(--transition);
  font-size:0.78rem;color:var(--text-secondary);
}
.simpel-toggle:hover{border-color:var(--accent-emerald);color:var(--accent-emerald)}
.simpel-toggle.aktif{background:rgba(52,211,153,0.1);border-color:var(--accent-emerald);color:var(--accent-emerald)}

/* ===== WELCOME ===== */
.welcome-screen{
  position:fixed;inset:0;background:var(--bg-void);z-index:300;
  display:flex;align-items:center;justify-content:center;flex-direction:column;
  transition:opacity 0.6s ease;
  overflow-y:auto;
  padding:60px 20px 80px 20px;
  min-height:100vh;
  box-sizing:border-box;
}
.welcome-screen.selesai{opacity:0;pointer-events:none}
.welcome-logo{
  font-size:2.5rem;font-weight:800;
  background:linear-gradient(135deg,var(--accent-teal),var(--accent-cyan),var(--accent-blue));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;margin-bottom:12px;
}
.welcome-sub{font-size:1rem;color:var(--text-secondary);margin-bottom:32px;text-align:center;max-width:500px;padding:0 20px}
.welcome-btn{
  padding:14px 40px;border-radius:var(--radius-lg);border:none;
  background:linear-gradient(135deg,var(--accent-teal),var(--accent-blue));
  color:#fff;font-size:1rem;font-weight:600;cursor:pointer;
  box-shadow:0 8px 32px rgba(0,201,255,0.3);transition:var(--transition);
  font-family:inherit;
}
.welcome-btn:hover{transform:translateY(-2px);box-shadow:0 12px 40px rgba(0,201,255,0.4)}
.welcome-fitur{display:flex;gap:24px;margin-top:32px;flex-wrap:wrap;justify-content:center}
.welcome-fitur-item{text-align:center;color:var(--text-muted);font-size:0.78rem}
.welcome-fitur-item svg{color:var(--accent-teal);margin-bottom:6px}

/* Smooth content transitions */
.ekspansi-konten,.sub-konten{transition:opacity 0.3s ease}

/* === ZOOM FONT-SIZE REFLOW === */
html { transition: font-size 0.2s ease; }
body { min-width: 320px; overflow-x: auto; }
#slideContainer { transform-origin: top left; width: 100%; }
/* Pastikan layout tetap proporsional saat zoom */
@media (max-width: 768px) {
  html { font-size: 90%; }
}


/* ===== ONBOARDING SLIDES ===== */
.onboard-slide { display: none; flex-direction: column; align-items: center; justify-content: flex-start; padding: 20px 20px 60px 20px; animation: fadeInUp 0.5s ease; width: 100%; max-width: 720px; margin: 0 auto; overflow-y: auto; max-height: calc(100vh - 140px); }
.onboard-slide.active { display: flex; }
@media (max-height: 700px) {
  .onboard-slide { justify-content: flex-start; padding-top: 10px; padding-bottom: 80px; }
}
@keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
.onboard-judul { font-size: 1.3rem; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 10px; color: var(--text-primary); }
.onboard-konten { width: 100%; margin-bottom: 16px; }
.onboard-badge { display: inline-block; background: var(--accent-teal); color: #fff; padding: 4px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; margin: 8px 0 16px; }
.onboard-nav { display: flex; gap: 10px; margin-top: 8px; }
.onboard-dots { display: flex; gap: 8px; margin-top: 16px; }
.onboard-dots .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--text-muted); cursor: pointer; transition: all 0.3s; opacity: 0.4; }
.onboard-dots .dot.active { background: var(--accent-teal); opacity: 1; transform: scale(1.2); }

/* Skip button */
.skip-btn { position: fixed; top: 16px; right: 16px; background: var(--glass-bg); border: 1px solid var(--glass-border); color: var(--text-muted); padding: 6px 14px; border-radius: 20px; font-size: 0.78rem; cursor: pointer; transition: all 0.2s; backdrop-filter: blur(10px); z-index: 10001; }
.skip-btn:hover { background: var(--accent-teal); color: #fff; border-color: var(--accent-teal); }

/* Panduan items */
.panduan-item { display: flex; align-items: flex-start; gap: 12px; padding: 10px; background: var(--bg-elevated); border-radius: var(--radius-sm); margin-bottom: 8px; border: 1px solid var(--glass-border); flex-shrink: 0; }
.panduan-icon { width: 36px; height: 36px; min-width: 36px; border-radius: 10px; background: linear-gradient(135deg, var(--accent-teal), var(--accent-cyan)); display: flex; align-items: center; justify-content: center; color: #fff; }

/* Fitur cards */
.fitur-card { background: var(--bg-elevated); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); padding: 12px; }
.fitur-card-icon { width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #fff; margin-bottom: 8px; }

/* Info boxes */
.info-box { transition: transform 0.2s; }
.info-box:hover { transform: translateY(-2px); }

/* WhatsApp link */

/* ===== LOGIN OVERLAY ===== */
.login-overlay { display: none; position: fixed; inset: 0; background: var(--bg-void); z-index: 9000; align-items: center; justify-content: center; padding: 20px; }
.login-overlay.buka { display: flex; }
.login-box { background: var(--bg-card); border: 1px solid var(--glass-border); border-radius: var(--radius-lg); padding: 32px; width: 100%; max-width: 400px; box-shadow: var(--shadow-lg); }
.login-field { margin-bottom: 14px; }
.login-field label { display: block; font-size: 0.82rem; font-weight: 500; margin-bottom: 6px; color: var(--text-secondary); }
.login-field input { width: 100%; padding: 10px 14px; background: var(--bg-elevated); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); color: var(--text-primary); font-family: inherit; font-size: 0.9rem; transition: border-color 0.2s; }
.login-field input:focus { outline: none; border-color: var(--accent-teal); box-shadow: 0 0 0 2px rgba(94, 234, 212, 0.15); }

/* ===== STRESS TEST NAV DOTS ===== */
.stress-nav-dots { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin: 14px 0; padding: 10px; background: var(--bg-elevated); border-radius: var(--radius-sm); }
.stress-dot { width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--glass-border); background: var(--bg-elevated); color: var(--text-muted); font-size: 0.7rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.2s; }
.stress-dot:hover { border-color: var(--accent-teal); color: var(--accent-teal); }
.stress-dot.answered { background: var(--accent-teal); border-color: var(--accent-teal); color: #fff; }
.stress-dot.current { box-shadow: 0 0 0 3px rgba(94, 234, 212, 0.3); border-color: var(--accent-cyan); color: var(--accent-cyan); }
.stress-dot.marked { border-color: var(--accent-amber); color: var(--accent-amber); }
.stress-dot.wrong { background: var(--accent-rose); border-color: var(--accent-rose); color: #fff; }

/* Mark question button */
.mark-btn { background: var(--bg-elevated); border: 1px solid var(--glass-border); color: var(--text-muted); padding: 6px 12px; border-radius: var(--radius-sm); font-size: 0.78rem; cursor: pointer; transition: all 0.2s; margin-left: 8px; }
.mark-btn:hover { border-color: var(--accent-amber); color: var(--accent-amber); }
.mark-btn.marked { background: var(--accent-amber); color: #fff; border-color: var(--accent-amber); }

/* Running text improvements */
.running-text { font-weight: 500; letter-spacing: 0.02em; }

/* Hide content when not logged in */
body.not-logged-in .app-shell { display: none; }
body.not-logged-in .progress-ring { display: none; }

/* User list toggle */
#userListPanel::-webkit-scrollbar { width: 6px; }
#userListPanel::-webkit-scrollbar-thumb { background: var(--glass-border); border-radius: 3px; }

/* Logout button in sidebar */
.logout-btn { margin-top: 8px; width: 100%; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3); color: #f87171; padding: 8px; border-radius: var(--radius-sm); font-size: 0.82rem; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center; gap: 6px; }
.logout-btn:hover { background: rgba(239, 68, 68, 0.2); }

/* Current user display */
.user-badge { display: flex; align-items: center; gap: 6px; padding: 8px 10px; background: linear-gradient(135deg, rgba(94,234,212,0.1), rgba(6,182,212,0.1)); border: 1px solid var(--glass-border); border-radius: var(--radius-sm); margin: 8px 0; font-size: 0.8rem; color: var(--accent-teal); }

/* ===== SIDEBAR TOGGLE BUTTON ===== */

/* Sidebar Toggle Fix */
.sidebar-toggle-btn{display:flex!important;align-items:center;justify-content:center;background:var(--glass-bg);border:1px solid var(--glass-border);color:var(--text-secondary);padding:8px;border-radius:var(--radius-sm);cursor:pointer;transition:all 0.2s;margin-right:12px;min-width:36px;height:36px;backdrop-filter:blur(10px)}
.sidebar-toggle-btn:hover{background:var(--accent-teal);color:#fff;border-color:var(--accent-teal)}

.sidebar-toggle-btn{
  background:var(--glass-bg);border:1px solid var(--glass-border);color:var(--text-secondary);
  padding:6px 10px;border-radius:var(--radius-sm);cursor:pointer;
  transition:all 0.2s;display:flex;align-items:center;justify-content:center;
  margin-right:10px;backdrop-filter:blur(10px);
}
.sidebar-toggle-btn:hover{background:var(--accent-teal);color:#fff;border-color:var(--accent-teal);}

/* ===== UNIFIED SVG ICON SYSTEM ===== */
.topbar-btn svg,.layout-switcher-btn svg,.layout-switcher-dropdown button svg,
.nav-toggle svg,.fab-btn svg,.panel-header button svg,
