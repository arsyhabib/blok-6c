    var navTree = document.getElementById("navTree");
    if (!navTree) return;
    var html = '<div class="nav-section-title">MATERI FINAL THT &amp; OFTALMOLOGI</div>';
    html += '<div class="nav-item" data-codex-nav="true"><a class="nav-link active" data-codex-slide-index="0" onclick="goToSlide(0)"><span class="num">00</span><span>Home &amp; Ringkasan</span></a></div>';
    CONTENT_MASTER.slides.forEach(function(slide, idx) {
      var n = idx + 1;
      html += '<div class="nav-item" data-codex-nav="true"><a class="nav-link" data-codex-slide-index="' + n + '" onclick="goToSlide(' + n + ')"><span class="num">' + String(n).padStart(2, "0") + '</span><span>' + escapeHtml(slide.title || ("Slide " + n)) + '</span></a>';
      if (slide.cards && slide.cards.length) {
        html += '<div class="nav-children collapsed">';
        slide.cards.forEach(function(card) {
          html += '<a class="nav-child-link" onclick="goToSlide(' + n + ');bukaEkspansi(\'' + escapeHtml(card.id || "") + '\')">' + escapeHtml(card.title || "Kartu Materi") + '</a>';
        });
        html += '</div>';
      }
      html += '</div>';
    });
    navTree.innerHTML = html;
  }

  window.goToSlide = function(index) {
    var slides = getCanonicalSlides();
    var n = Math.max(0, Math.min(slides.length - 1, parseInt(index, 10) || 0));
    markLegacySlides();
    slides.forEach(function(slide) {
      slide.classList.remove("active");
      slide.style.display = "none";
      slide.setAttribute("aria-hidden", "true");
    });
    var active = slides[n];
    if (!active) return;
    active.classList.add("active");
    active.style.display = "";
    active.removeAttribute("aria-hidden");
    if (window.App) {
      App.slideAktif = n;
      App.totalSlide = CONTENT_MASTER.slides.length + 1;
      App.slideDilihat = App.slideDilihat || [];
      if (App.slideDilihat.indexOf(active.id) === -1) App.slideDilihat.push(active.id);
    }
    var pct = ((n + 1) / (CONTENT_MASTER.slides.length + 1) * 100).toFixed(0);
    var progress = document.getElementById("progressFill");
    if (progress) progress.style.width = pct + "%";
    var breadcrumb = document.getElementById("breadcrumb");
    if (breadcrumb) breadcrumb.textContent = n === 0 ? "Home & Ringkasan" : (active.dataset.title || "Slide " + n);
    setActiveNav(n);
    var main = document.getElementById("mainContent");
    if (main) main.scrollTo({ top: 0, behavior: "smooth" });
    else window.scrollTo({ top: 0, behavior: "smooth" });
  };

  function resolveMediaSource(m) {
    var src = m.renderSource || m.source || "";
    if (!src) return "";
    if (/commons\.wikimedia\.org\/wiki\/File:/i.test(src)) {
      return "https://commons.wikimedia.org/wiki/Special:Redirect/file/" + src.split("/wiki/File:")[1].split("#")[0].split("?")[0];
    }
    return src;
  }

  function isRenderableMedia(m) {
    var src = resolveMediaSource(m);
    return m.renderMode === "image" || /\.(png|jpg|jpeg|gif|svg|webp|avif)(\?|#|$)/i.test(src) || /Special:Redirect\/file\//i.test(src);
  }

  function mediaFigureHTML(m) {
    var cite = m.citation || {};
    var src = resolveMediaSource(m);
    var title = escapeHtml(m.title || m.mediaId || "Media");
    var alt = escapeHtml(m.alt || m.title || "Media");
    var credit = escapeHtml((cite.authorOrInstitution || "") + " · " + (m.license || ""));
    if (isRenderableMedia(m)) {
      return '<figure class="codex-media-card"><img src="' + src + '" alt="' + alt + '" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest(\'figure\').classList.add(\'image-load-failed\')"><figcaption><strong>' + title + '</strong><br><span>' + credit + '</span></figcaption></figure>';
    }
    return '<figure class="codex-media-card codex-media-source-card"><div class="codex-source-preview"><strong>Media sumber internet</strong><span>URL ini adalah halaman sumber, bukan file gambar langsung.</span></div><figcaption><strong>' + title + '</strong><br><span>' + credit + '</span><br><a href="' + escapeHtml(m.source || src) + '" target="_blank" rel="noopener">Buka sumber gambar</a></figcaption></figure>';
  }

  function openCanonicalAtlas(slideNumber) {
    var idx = Math.max(1, Math.min(CONTENT_MASTER.slides.length, parseInt(slideNumber, 10) || ((window.App && App.slideAktif) || 1)));
    var slide = CONTENT_MASTER.slides[idx - 1] || CONTENT_MASTER.slides[0];
    var mediaById = {};
    (MEDIA_MANIFEST_FINAL.manifest || []).forEach(function(m){ mediaById[m.mediaId] = m; });
    var refs = (slide.media || []).map(function(ref){ return mediaById[ref.mediaId]; }).filter(Boolean);
    if (!refs.length) refs = (MEDIA_MANIFEST_FINAL.manifest || []).slice(0, 4);
    var overlay = document.getElementById("codexAtlasOverlay");
    if (!overlay) {
      overlay = document.createElement("div");
      overlay.id = "codexAtlasOverlay";
      overlay.className = "overlay-panel buka";
      overlay.style.cssText = "position:fixed;inset:0;z-index:1130;background:rgba(2,6,23,.86);display:flex;align-items:center;justify-content:center;padding:24px;overflow:auto";
      document.body.appendChild(overlay);
    }
    overlay.classList.add("buka");
    overlay.style.display = "flex";
    overlay.innerHTML = '<div style="width:min(1080px,96vw);max-height:92vh;overflow:auto;background:var(--bg-card);border:1px solid var(--glass-border);border-radius:22px;padding:22px;box-shadow:var(--shadow-xl)">' +
      '<div style="display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px"><div><h2 style="margin:0;color:var(--text-primary)">Atlas Media THT &amp; Oftalmologi</h2><p style="margin:6px 0 0;color:var(--text-secondary)">' + escapeHtml(slide.title || "Slide") + '</p></div><button class="modal-close" type="button" onclick="document.getElementById(\'codexAtlasOverlay\').style.display=\'none\'">Tutup</button></div>' +
      '<div class="codex-media-citation-grid" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px">' + refs.map(mediaFigureHTML).join("") + '</div></div>';
  }

  window.openAtlasDemo = openCanonicalAtlas;
  window.navImg = openCanonicalAtlas;
  window.injectInlineAtlasPreviews = function(){};
  window.sapientDispatchAction = function(action) {
    if (action === "open-atlas" || action === "crosslink-map") return openCanonicalAtlas((window.App && App.slideAktif) || 1);
    if (action === "open-quiz" && typeof bukaKuisSlide === "function") return bukaKuisSlide();
    if (action === "open-flashcard" && typeof bukaFlashcard === "function") return bukaFlashcard();
    if (action === "open-search" && typeof bukaCari === "function") return bukaCari();
    if (/layout-/.test(action || "")) return document.body.setAttribute("data-sapient-effective-layout", action.replace("layout-", ""));
    if (typeof showToast === "function") showToast("Aksi final aktif: " + action);
  };

  function renderCanonicalMediaCitations() {
    var mediaById = {};
    (MEDIA_MANIFEST_FINAL.manifest || []).forEach(function(m){ mediaById[m.mediaId] = m; });
    CONTENT_MASTER.slides.forEach(function(slide){
      var section = document.getElementById(slide.id);
      if (!section || section.querySelector(".codex-media-citation-grid")) return;
      var refs = (slide.media || []).map(function(ref){ return mediaById[ref.mediaId]; }).filter(Boolean);
      if (!refs.length) return;
      var grid = document.createElement("div");
      grid.className = "codex-media-citation-grid";
      grid.style.cssText = "display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px;margin:18px 0";
      refs.forEach(function(m){
        grid.insertAdjacentHTML("beforeend", mediaFigureHTML(m));
      });
      section.appendChild(grid);
    });
  }

  function enforceCanonicalRuntime() {
    markLegacySlides();
    renderCanonicalSidebar();
    if (window.App) App.totalSlide = CONTENT_MASTER.slides.length + 1;
    document.querySelectorAll("#navTree .nav-section-title").forEach(function(el) {
      if (/SAPIENT|IDAI|HB-0|GDrive/i.test(el.textContent || "")) el.remove();
    });
    document.querySelectorAll("#navTree .nav-item").forEach(function(item) {
      if (!item.hasAttribute("data-codex-nav") && /IDAI|HB-0|GDrive|Blueprint/i.test(item.textContent || "")) item.remove();
    });
    document.querySelectorAll(".v12-inline-atlas, [data-v12-inline-atlas]").forEach(function(el){ el.remove(); });
    document.querySelectorAll(".codex-media-card img").forEach(function(img) {
      if (!img.getAttribute("onerror")) img.setAttribute("onerror", "this.closest('figure').classList.add('image-load-failed')");
    });
  }

  function installCanonicalStyles() {
    if (document.getElementById("codex-runtime-final-fixes")) return;
    var style = document.createElement("style");
    style.id = "codex-runtime-final-fixes";
    style.textContent = '.slide-section[data-codex-legacy-slide="true"],.v12-inline-atlas,[data-v12-inline-atlas]{display:none!important}.codex-media-card.image-load-failed img{display:none!important}.codex-media-card.image-load-failed:before{content:"Gambar tidak dapat dimuat langsung. Gunakan tautan sumber pada caption.";display:grid;place-items:center;min-height:160px;padding:18px;color:var(--text-secondary);background:linear-gradient(135deg,rgba(0,201,255,.08),rgba(52,211,153,.08))}.codex-source-preview{min-height:170px;display:grid;gap:8px;place-items:center;text-align:center;padding:18px;color:var(--text-secondary);background:linear-gradient(135deg,rgba(0,201,255,.10),rgba(52,211,153,.08))}.codex-source-preview strong{color:var(--accent-cyan);font-size:1rem}.codex-source-preview span{max-width:34ch;line-height:1.45}.codex-media-card a{color:var(--accent-cyan);font-weight:800;text-decoration:none}#codexAtlasOverlay .codex-media-card{background:var(--bg-elevated)}';
    document.head.appendChild(style);
  }

  function renderNow() {
    installCanonicalStyles();
    applyIdentityText();
    applyAuth();
    applyRuntimeData();
    if (typeof renderSlides === "function") renderSlides(CONTENT_MASTER);
    renderCanonicalMediaCitations();
    enforceCanonicalRuntime();
    window.goToSlide((window.App && App.slideAktif) || 0);
    [50, 250, 800, 1600].forEach(function(ms){ setTimeout(enforceCanonicalRuntime, ms); });
    if (typeof bangunIndeksCari === "function") bangunIndeksCari();
    if (typeof updateDashboard === "function") updateDashboard();
    if (typeof initTooltipIstilah === "function") initTooltipIstilah();
    var stressIntro = document.querySelector("#stressBody p");
    if (stressIntro) stressIntro.innerHTML = "40 soal pilihan ganda dari exam bank final.<br>Waktu pengerjaan: <strong style='color:var(--accent-amber)'>60 menit</strong>.";
  }

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", renderNow);
  else renderNow();
  window.CodexLangkah6SelfCheck = function() {
    return {
      slides: CONTENT_MASTER.slides.length,
      renderedSlides: document.querySelectorAll("#dynamicSlides .slide-section").length,
      cbtQuestions: EXAM_STRESS_BANK.length,
      soalMaster: SOAL_MASTER.soal.length,
      media: (MEDIA_MANIFEST_FINAL.manifest || []).length,
      flashcards: FLASHCARD_MASTER.length,
      namespace: STORAGE_NAMESPACE
    };
  };
})();
</script>

