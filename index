  const nama = document.getElementById('identitasNama').value.trim();
  const nim = document.getElementById('identitasNIM').value.trim();
  const prodi = document.getElementById('identitasProdi').value.trim();
  if (nama) {
    App.identitas = { nama, nim, prodi, tanggal: new Date().toLocaleDateString('id-ID') };
    localStorage.setItem('atlas-identitas', JSON.stringify(App.identitas));
    document.getElementById('identitasOverlay').classList.remove('buka');
    showToast('Identitas tersimpan: ' + nama);
    tampilkanIdentitas();
  } else {
    showToast('Nama tidak boleh kosong');
  }
}
function muatIdentitas() {
  const saved = localStorage.getItem('atlas-identitas');
  if (saved) { App.identitas = JSON.parse(saved); tampilkanIdentitas(); }
}
function tampilkanIdentitas() {
  const el = document.getElementById('identitasDisplay');
  if (el && App.identitas && App.identitas.nama) {
    el.innerHTML = '<div style="display:flex;align-items:center;gap:8px;padding:6px 10px;background:linear-gradient(135deg,rgba(0,201,255,0.08),rgba(167,139,250,0.08));border:1px solid var(--glass-border);border-radius:var(--radius-sm);font-size:0.78rem;color:var(--accent-teal)">👤 <strong>' + App.identitas.nama + '</strong>' + (App.identitas.nim ? ' | ' + App.identitas.nim : '') + (App.identitas.prodi ? ' | ' + App.identitas.prodi : '') + '</div>';
  }
}
function bukaIdentitas() {
  tutupSemuaOverlay();
  document.getElementById('identitasOverlay').classList.add('buka');
  if (App.identitas) {
    if (App.identitas.nama) document.getElementById('identitasNama').value = App.identitas.nama;
    if (App.identitas.nim) document.getElementById('identitasNIM').value = App.identitas.nim;
    if (App.identitas.prodi) document.getElementById('identitasProdi').value = App.identitas.prodi;
  }
}
function tutupIdentitas() {
  document.getElementById('identitasOverlay').classList.remove('buka');
}

// ===== STRESS TEST MAP (PETA PEMAHAMAN) =====
function hitungPetaPemahaman() {
  const peta = {};
  for (let i = 0; i < TOTAL_SLIDES; i++) { peta[i] = { total: 0, benar: 0 }; }

  // Count from stress test
  if (App.stressSoal) {
    App.stressSoal.forEach((s, idx) => {
      if (peta[s.slide]) {
        peta[s.slide].total++;
        if (isStressAnswerCorrect(idx)) peta[s.slide].benar++;
      }
    });
  }

  // Count from regular quiz
  Object.keys(App.skorKuis).forEach(key => {
    const slideIdx = parseInt(key.split('-')[0]);
    if (!isNaN(slideIdx) && peta[slideIdx]) {
      peta[slideIdx].total++;
      peta[slideIdx].benar += App.skorKuis[key];
    }
  });

  return peta;
}

function renderPetaPemahaman() {
  const peta = hitungPetaPemahaman();
  let html_map = '<div style="margin-top:16px"><h4 style="color:var(--accent-teal);margin-bottom:10px">📊 Peta Pemahaman per Slide</h4><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:8px">';

  const namaSlides = ['Jadwal Imunisasi','Cedera Anak','Cerebral Palsy','Demam','Diare','Gizi Buruk','ISPA','Penyakit Kulit','Malaria','Penyakit Menular','Tumbuh Kembang','Tali Pusat','Ikterus','BBLR','Sepsis','Tetanus','Tuberkulosis'];

  for (let i = 0; i < TOTAL_SLIDES; i++) {
    const data = peta[i];
    const pct = data.total > 0 ? Math.round(data.benar / data.total * 100) : 0;
    let warna = 'var(--accent-rose)';
    if (pct >= 80) warna = 'var(--accent-emerald)';
    else if (pct >= 60) warna = 'var(--accent-amber)';
    else if (pct >= 40) warna = 'var(--accent-orange, #f97316)';

    html_map += '<div style="background:var(--bg-elevated);border-radius:var(--radius-sm);padding:10px;border-left:4px solid ' + warna + '">';
    html_map += '<div style="font-size:0.75rem;font-weight:600;color:var(--text-primary)">' + (namaSlides[i] || 'Slide ' + (i+1)) + '</div>';
    html_map += '<div style="display:flex;align-items:center;gap:8px;margin-top:6px">';
    html_map += '<div style="flex:1;height:6px;background:var(--bg-card);border-radius:3px;overflow:hidden">';
    html_map += '<div style="height:100%;width:' + pct + '%;background:' + warna + ';border-radius:3px;transition:width 0.5s ease"></div></div>';
    html_map += '<span style="font-size:0.7rem;color:' + warna + ';font-weight:700;min-width:32px;text-align:right">' + pct + '%</span>';
    html_map += '</div></div>';
  }
  html_map += '</div></div>';
  return html_map;
}

