// ===== FEATURE NEW-21: TF-IDF SEMANTIC SEARCH =====
function buildSearchIndex() {
  var slides = document.querySelectorAll('.slide-section');
  var docs = [];
  slides.forEach(function(slide) {
    docs.push({ id: slide.id, text: (slide.textContent || '').toLowerCase() });
  });
  window.MegaAtlasV11.searchIndex = docs;
}
function semanticSearch(query) {
  var index = window.MegaAtlasV11.searchIndex;
  if (!index || !index.length) buildSearchIndex();
  index = window.MegaAtlasV11.searchIndex || [];
  var terms = query.toLowerCase().split(/\s+/).filter(Boolean);
  var results = index.map(function(doc) {
    var score = terms.reduce(function(s, term) {
      var freq = (doc.text.match(new RegExp(term, 'g')) || []).length;
      return s + freq * (1 / (index.filter(function(d) { return d.text.includes(term); }).length + 1));
    }, 0);
    return { id: doc.id, score: score };
  }).filter(function(r) { return r.score > 0; })
    .sort(function(a, b) { return b.score - a.score; });
  return results;
}

