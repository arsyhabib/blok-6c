// ===== EXPORT PDF (safe structural runtime) =====
function exportEscape(value) {
  if (typeof escapeHtml === 'function') return escapeHtml(value || '');
  return String(value || '').replace(/[&<>"']/g, function(ch) {
    return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[ch];
  });
}

function buildExportPayload(type) {
  var dateStr = new Date().toLocaleString('id-ID');
  var userId = (window.App && App.currentUser) ? App.currentUser : 'Guest';
  var title = 'Export Mega Atlas Blok';
  var rows = [];
  if (type === 'bookmarks') {
    title = 'Bookmark Saya - Mega Atlas Blok';
    var marks = [];
    try { marks = JSON.parse(localStorage.getItem('atlas-bookmarks') || '[]'); } catch(e) { marks = []; }
    if (!marks.length && window.App && Array.isArray(App.penanda)) {
      marks = App.penanda.map(function(id) {
        var n = parseInt(String(id).replace('slide-',''), 10);
        var s = document.getElementById('slide-' + n);
        return { slide: n, judul: s ? s.getAttribute('data-title') : 'Slide ' + (n + 1), waktu: dateStr };
      });
    }
    rows = marks.map(function(b, i) {
      return '<p><strong>' + (i + 1) + '. Slide ' + exportEscape((b.slide || 0) + 1) + '</strong><br>' + exportEscape(b.judul || '') + '<br><small>' + exportEscape(b.waktu || '') + '</small></p>';
    });
  } else if (type === 'notes') {
    title = 'Catatan Belajar - Mega Atlas Blok';
    var notes = [];
    try { notes = JSON.parse(localStorage.getItem('atlas-catatan') || '[]'); } catch(e) { notes = []; }
    if (!Array.isArray(notes)) notes = [];
    if (!notes.length && window.App && App.catatan) notes = [{ slide: App.slideAktif || 0, teks: App.catatan, waktu: dateStr }];
    rows = notes.map(function(n, i) {
      return '<p><strong>' + (i + 1) + '. Slide ' + exportEscape((n.slide || 0) + 1) + '</strong> <small>' + exportEscape(n.waktu || '') + '</small><br>' + exportEscape(n.teks || '') + '</p>';
    });
  } else {
    title = 'Laporan Progress Belajar - Mega Atlas Blok';
    var visited = (window.App && Array.isArray(App.slideDilihat)) ? App.slideDilihat.length : 0;
    var total = (window.App && App.totalSlide) ? App.totalSlide : document.querySelectorAll('.slide-section').length;
    var bookmarks = (window.App && Array.isArray(App.penanda)) ? App.penanda.length : 0;
    rows = [
      '<p>Pengguna: <strong>' + exportEscape(userId) + '</strong></p>',
      '<p>Slide dikunjungi: <strong>' + exportEscape(visited + '/' + total) + '</strong></p>',
      '<p>Bookmark: <strong>' + exportEscape(bookmarks) + '</strong></p>',
      '<p>Tanggal cetak: <strong>' + exportEscape(dateStr) + '</strong></p>'
    ];
  }
  return {
    title: title,
    emptyMessage: type === 'bookmarks' ? 'Tidak ada bookmark untuk diekspor' : type === 'notes' ? 'Tidak ada catatan untuk diekspor' : '',
    body: rows.join('') || ''
  };
}

function exportToPDF(type) {
  var payload = buildExportPayload(type || 'progress');
  if (!payload.body && payload.emptyMessage) {
    if (typeof showToast === 'function') showToast(payload.emptyMessage);
    return;
  }
  var printWindow = window.open('', '_blank');
  if (!printWindow) {
    if (typeof showToast === 'function') showToast('Popup diblokir. Izinkan popup untuk mencetak.');
    return;
  }
  var doc = printWindow.document;
  doc.open();
  doc.write('<!DOCTYPE html><html lang="id"><head><meta charset="UTF-8"><title></title></head><body>' + '</' + 'body></' + 'html>');
  doc.close();
  doc.title = payload.title;
  var style = doc.createElement('style');
  style.textContent = 'body{font-family:Arial,sans-serif;padding:40px;max-width:820px;margin:0 auto;color:#263142;line-height:1.6}h1{color:#0f78a8;border-bottom:2px solid #0ea5e9;padding-bottom:10px}p{break-inside:avoid}small{color:#64748b}.identity{padding:12px 16px;background:#eef9ff;border-left:4px solid #0ea5e9;margin-bottom:18px;border-radius:8px}';
  doc.head.appendChild(style);
  var identity = doc.createElement('div');
  identity.className = 'identity';
  identity.innerHTML = '<strong>MEGA ATLAS BLOK</strong><br>Export dibuat dari shell final proyek aktif.';
  var heading = doc.createElement('h1');
  heading.textContent = payload.title;
  var content = doc.createElement('main');
  content.innerHTML = payload.body;
  doc.body.appendChild(heading);
  doc.body.appendChild(identity);
  doc.body.appendChild(content);
  setTimeout(function() { printWindow.print(); }, 350);
  if (typeof showToast === 'function') showToast('Mencetak ' + (type || 'progress') + '...');
}

