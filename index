// --- Word-Selection Bookmark Feature (selectionchange-based, touchscreen-friendly) ---
(function() {
  var popup = null;
  var lastSelection = '';
  var lastRange = null;
  var selDebounceTimer = null;
  function getPopup() { return popup || (popup = document.getElementById('wordBookmarkPopup')); }
  function showBookmarkPopup() {
    var sel = window.getSelection();
    var txt = sel ? sel.toString().trim() : '';
    var pop = getPopup();
    if (!pop) return;
    if (txt && txt.length >= 3 && txt.length <= 1000) {
      // Skip if selection is inside unwanted elements
      try {
        var anchor = sel.anchorNode && sel.anchorNode.parentElement;
        if (anchor && anchor.closest('input, textarea, .baby-modal, #wordBookmarkPopup, .overlay-panel, button')) return;
      } catch(e) {}
      var range = sel.getRangeAt(0);
      var rect = range.getBoundingClientRect();
      lastSelection = txt;
      lastRange = range;
      pop.classList.add('show');
      var px = Math.min(Math.max(rect.left + rect.width / 2 - 60, 10), window.innerWidth - 130);
      var py = Math.max(rect.top - 54, 10);
      pop.style.left = px + 'px';
      pop.style.top = py + 'px';
    } else {
      pop.classList.remove('show');
    }
  }
  // selectionchange fires reliably on both mouse AND touchscreen after text is selected
  document.addEventListener('selectionchange', function() {
    clearTimeout(selDebounceTimer);
    selDebounceTimer = setTimeout(showBookmarkPopup, 200);
  });
  // Also handle mouseup for immediate response on desktop
  document.addEventListener('mouseup', function() {
    clearTimeout(selDebounceTimer);
    setTimeout(showBookmarkPopup, 10);
  });
  // Close popup when clicking/tapping outside
  document.addEventListener('mousedown', function(e) {
    var pop = getPopup();
    if (pop && !e.target.closest('#wordBookmarkPopup')) pop.classList.remove('show');
  });
  document.addEventListener('touchstart', function(e) {
    var pop = getPopup();
    if (pop && !e.target.closest('#wordBookmarkPopup')) pop.classList.remove('show');
  }, { passive: true });
  window.bookmarkKataTerpilih = function() {
    if (!lastSelection) return;
    var stored = JSON.parse(localStorage.getItem('atlas-kata-bookmark') || '[]');
    if (stored.some(function(s) { return s.text === lastSelection; })) {
      showToast('✓ Sudah ada di bookmark');
    } else {
      var ctx = '';
      try {
        var slideEl = lastRange.startContainer.parentElement ? lastRange.startContainer.parentElement.closest('.slide-section') : null;
        ctx = slideEl ? (slideEl.getAttribute('data-title') || '') : '';
      } catch(e) {}
      stored.unshift({
        text: lastSelection,
        context: ctx ? 'dari ' + ctx : '',
        slide: App.slideAktif || 0,
        tanggal: new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'short' })
      });
      if (stored.length > 100) stored = stored.slice(0, 100);
      localStorage.setItem('atlas-kata-bookmark', JSON.stringify(stored));
      showToast('🔖 Kata tersimpan ke Bookmark');
    }
    var pop = getPopup();
    if (pop) pop.classList.remove('show');
    window.getSelection().removeAllRanges();
  };
})();

