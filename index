/* ===== TOUCHSCREEN FALLBACK (minimal, non-breaking) ===== */
// Ensures .fab-item-wrap onclick works reliably on all touch devices.
// This does NOT interfere with mouse — touchend only fires on touchscreens.
(function() {
  'use strict';
  var TOUCH_MAX_MOVE = 10; // px — tap vs. swipe threshold

  function initTouchFallback() {
    var items = document.querySelectorAll('.fab-item-wrap');
    items.forEach(function(item) {
      if (item._touchFixed) return;
      item._touchFixed = true;

      var startX, startY;
      item.addEventListener('touchstart', function(e) {
        var t = e.changedTouches[0];
        startX = t.clientX;
        startY = t.clientY;
      }, { passive: true });

      item.addEventListener('touchend', function(e) {
        var t = e.changedTouches[0];
        var dx = Math.abs(t.clientX - startX);
        var dy = Math.abs(t.clientY - startY);
        // Only trigger if it was a tap (minimal movement)
        if (dx <= TOUCH_MAX_MOVE && dy <= TOUCH_MAX_MOVE) {
          e.preventDefault();
          e.stopPropagation();
          // Manually trigger the onclick handler
          var onclk = item.getAttribute('onclick');
          if (onclk) {
            try { eval(onclk); } catch(err) { console.warn('FAB touch error:', err); }
          }
        }
      }, { passive: false });
    });
  }

  // Run after DOM is ready
  if (document.readyState !== 'loading') {
    setTimeout(initTouchFallback, 500);
  } else {
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(initTouchFallback, 500);
    });
  }

  // Re-apply when DOM changes (new items added)
  var observer = new MutationObserver(function() {
    clearTimeout(window._touchFixTimer);
    window._touchFixTimer = setTimeout(initTouchFallback, 200);
  });
  if (document.body) {
    observer.observe(document.body, { childList: true, subtree: true });
  } else {
    document.addEventListener('DOMContentLoaded', function() {
      observer.observe(document.body, { childList: true, subtree: true });
    });
  }
})();
</script>


