  --text-primary:#e8ecf1; --text-secondary:#94a3b8; --text-muted:#64748b;
  --accent:#00c9ff; --success:#34d399; --warning:#fbbf24; --danger:#fb7185; --info:#4facfe;
  --space-1:4px; --space-2:8px; --space-3:12px; --space-4:16px; --space-5:20px; --space-6:24px;
  --radius-sm:8px; --radius-md:12px; --radius-lg:16px; --radius-xl:20px;
  --shadow-soft:0 16px 40px rgba(0,0,0,.24); --shadow-strong:0 28px 70px rgba(0,0,0,.42);
  --motion-fast:160ms; --motion-med:260ms; --motion-slow:420ms;
  --sidebar-width:320px; --topbar-height:56px; --headbar-height:72px;
  --safe-top:env(safe-area-inset-top); --safe-right:env(safe-area-inset-right);
  --safe-bottom:env(safe-area-inset-bottom); --safe-left:env(safe-area-inset-left);
  --z-base:1; --z-content:10; --z-sidebar:320; --z-topbar:360; --z-slide-headbar:220;
  --z-fab:300; --z-drawer:600; --z-overlay-backdrop:900; --z-overlay-panel:950;
  --z-modal:1000; --z-quiz-recall:1100; --z-quick-reference:1120;
  --z-split-screen-fullscreen:1130; --z-toast:1200; --z-tooltip:1300;
}
[data-theme="light"] {
  --bg:#eef2f8; --surface:#ffffff; --elevated:#dce8f5; --border:#9ab0cc;
  --text-primary:#0c1220; --text-secondary:#1e3048; --text-muted:#4a5f78;
  --accent:#005f82; --success:#044d38; --warning:#7a4800; --danger:#9b1b10; --info:#1447b3;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text-primary)}
button,[role="button"],a,input,textarea,select{font:inherit}
button,[role="button"],a{touch-action:manipulation}
:focus-visible{outline:3px solid color-mix(in srgb,var(--accent),transparent 35%);outline-offset:3px}
@media (prefers-reduced-motion: reduce) {
  *,*::before,*::after { animation-duration:.01ms!important; animation-iteration-count:1!important; transition-duration:.01ms!important; scroll-behavior:auto!important; }
