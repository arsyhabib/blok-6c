function doResetProgres() {
  // Remove modal
  var m = document.getElementById('resetProgressModal');
  if (m) m.remove();
  // Clear all atlas localStorage keys
  var keysToDelete = [];
  for (var i = 0; i < localStorage.length; i++) {
    var k = localStorage.key(i);
    if (k && (k.startsWith('atlas-') || k.startsWith('fab') || k.startsWith('mega-atlas'))) {
      keysToDelete.push(k);
    }
  }
  keysToDelete.forEach(function(k) { localStorage.removeItem(k); });
  // Reset in-memory App state
  App.skorKuis = {};
  App.bookmarks = [];
  App.catatan = {};
  App.stressHistory = [];
  App.stressSoal = [];
  App.stressJawaban = {};
  App.stressMarked = {};
  App.stressTimer = null;
  // Clear highlighted DOM (kuis answers, bookmarks)
  document.querySelectorAll('.kuis-pilihan.benar, .kuis-pilihan.salah, .kuis-pilihan.nonaktif').forEach(function(b) {
    b.classList.remove('benar', 'salah', 'nonaktif');
  });
  document.querySelectorAll('.kuis-jawaban.buka').forEach(function(j) {
    j.classList.remove('buka');
  });
  // Reload page for full clean state
  showToast('✅ Progres berhasil direset! Halaman akan dimuat ulang...');
  setTimeout(function() { location.reload(); }, 1800);
}

