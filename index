// ===== KUIS =====
function jawabKuis(btnEl, benarKey) {
  // benarKey = 'A', 'B', 'C', or 'D' (correct answer)
  var kartu = btnEl.closest('.kuis-kartu');
  if (!kartu || kartu.dataset.answered === '1') return; // already answered
  kartu.dataset.answered = '1';

  var semuaBtn = kartu.querySelectorAll('.kuis-pilihan');
  var jawabanEl = kartu.querySelector('.kuis-jawaban');

  // Normalize correct key
  var kunciBenar = (benarKey || '').toString().trim().charAt(0).toUpperCase();

  // Get clicked button's letter (first non-space char)
  var dipilih = (btnEl.textContent || '').trim().charAt(0).toUpperCase();
  var benar = (dipilih === kunciBenar);

  // Disable all, mark correct/wrong
  semuaBtn.forEach(function(b) {
    b.disabled = true;
    b.classList.add('nonaktif');
    var huruf = (b.textContent || '').trim().charAt(0).toUpperCase();
    if (huruf === kunciBenar) {
      b.classList.add('benar'); // always highlight the correct answer
    }
  });
  if (!benar) {
    btnEl.classList.add('salah'); // also mark wrong choice in red
  }

  // Show explanation
  if (jawabanEl) jawabanEl.classList.add('buka');

  // Show result badge
  var existingBadge = kartu.querySelector('.kuis-result-badge');
  if (existingBadge) existingBadge.remove();
  var badge = document.createElement('div');
  badge.className = 'kuis-result-badge ' + (benar ? 'badge-benar' : 'badge-salah');
  badge.textContent = benar ? '✓ Benar' : '✗ Salah — kunci: ' + kunciBenar;
  var pertanyaan = kartu.querySelector('.kuis-pertanyaan');
  if (pertanyaan) {
    kartu.insertBefore(badge, pertanyaan.nextSibling);
  } else {
    kartu.insertBefore(badge, kartu.firstChild);
  }

  // Toast
  if (benar) showToast('✓ Jawaban benar!');
  else showToast('✗ Salah. Kunci jawaban: ' + kunciBenar);

  // Save score
  var qid = (App.slideAktif || 0) + '-' + Array.from((kartu.parentNode || kartu).children).indexOf(kartu);
  App.skorKuis[qid] = benar ? 1 : 0;
  try { localStorage.setItem('atlas-kuis', JSON.stringify(App.skorKuis)); } catch(e){}

  // Update progress counter
  _updateKuisProgress(kartu);
  updateDashboard();
}

function _updateKuisProgress(kartu) {
  var slide = kartu.closest('.slide-section');
  if (!slide) return;
  var allKartu = slide.querySelectorAll('.kuis-kartu');
  var answered = Array.from(allKartu).filter(function(k) { return k.dataset.answered === '1'; }).length;
  var correct = Array.from(allKartu).filter(function(k) {
    return k.dataset.answered === '1' && k.querySelector('.kuis-pilihan.benar:not(.salah)');
  }).length;
  var total = allKartu.length;

  var progressEl = slide.querySelector('.kuis-slide-progress');
  if (!progressEl) {
    progressEl = document.createElement('div');
    progressEl.className = 'kuis-slide-progress';
    var firstKartu = slide.querySelector('.kuis-kartu');
    if (firstKartu && firstKartu.parentNode) {
      firstKartu.parentNode.insertBefore(progressEl, firstKartu);
    }
  }
  var pct = total > 0 ? Math.round(answered / total * 100) : 0;
  progressEl.innerHTML =
    '<div class="kuis-prog-label">' +
      '<span>📝 Kuis Slide</span>' +
      '<span>' + answered + '/' + total + ' dijawab &bull; ' + correct + ' benar</span>' +
    '</div>' +
    '<div class="kuis-prog-bar"><div class="kuis-prog-fill" style="width:' + pct + '%"></div></div>';
}


