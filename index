function initSortableTables() {
  document.querySelectorAll('table').forEach(function(table) {
    if (table.classList.contains('table-enhanced')) return;
    table.classList.add('table-enhanced');
    var ths = table.querySelectorAll('th');
    ths.forEach(function(th, col) {
      th.style.cursor = 'pointer';
      th.innerHTML += '<span class="sort-icon"></span>';
      th.addEventListener('click', function() {
        var asc = !th.classList.contains('sort-asc');
        ths.forEach(function(h) { h.classList.remove('sort-asc','sort-desc'); });
        th.classList.add(asc ? 'sort-asc' : 'sort-desc');
        var tbody = table.querySelector('tbody') || table;
        var rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort(function(a,b) {
          var va = (a.cells[col]||{}).textContent || '';
          var vb = (b.cells[col]||{}).textContent || '';
          return asc ? va.localeCompare(vb) : vb.localeCompare(va);
        });
        rows.forEach(function(r) { tbody.appendChild(r); });
      });
    });
  });
}

// ===== FEATURE NEW-49: PINCH ZOOM =====
function initPinchZoom(target) {
  if (!target) return;
  var scale = 1, startDist = 0;
  target.classList.add('pinch-zoom-target');
  target.addEventListener('touchstart', function(e) {
    if (e.touches.length === 2) {
      startDist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
    }
  }, {passive:true});
  target.addEventListener('touchmove', function(e) {
    if (e.touches.length === 2) {
      var dist = Math.hypot(e.touches[0].clientX - e.touches[1].clientX, e.touches[0].clientY - e.touches[1].clientY);
      scale = Math.max(0.5, Math.min(4, scale * (dist / startDist)));
      target.style.transform = 'scale(' + scale + ')';
      startDist = dist;
    }
  }, {passive:true});
  target.addEventListener('dblclick', function() {
    scale = scale > 1 ? 1 : 2;
    target.style.transform = 'scale(' + scale + ')';
    target.classList.toggle('zoomed', scale > 1);
  });
}

