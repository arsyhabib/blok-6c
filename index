// Prev button handler
document.addEventListener('click', function(e){
  var btn = e.target.closest('button[data-prev-btn]');
  if(!btn) return;
  var cur = 1;
  for(var i=1;i<=5;i++){
    var el = document.getElementById('onboard-'+i);
    if(el && el.classList.contains('active')){cur=i;break;}
  }
  for(var i=1;i<=5;i++){
    var el = document.getElementById('onboard-'+i);
    if(el) el.classList.remove('active');
  }
  var prev = Math.max(cur-1,1);
  var pel = document.getElementById('onboard-'+prev);
  if(pel) pel.classList.add('active');
  var dots = document.querySelectorAll('#globalOnboardDots .dot');
  for(var i=0;i<dots.length;i++){
    dots[i].classList.toggle('active', parseInt(dots[i].getAttribute('data-slide'))===prev);
  }
  var skip = document.querySelector('.skip-btn');
  if(skip) skip.style.display = (prev===4||prev===5) ? 'none' : 'block';
});
</script>
