/* ===== SURGICAL MODE ENHANCEMENTS ===== */
body.surgical-mode .sidebar { display: none !important; }
body.surgical-mode .topbar { display: none !important; }
body.surgical-mode .fab-container { display: none !important; }
body.surgical-mode .breadcrumb { display: none !important; }
