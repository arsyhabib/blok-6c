}

/**
 * Builds a single expandable card: .ekspansi-kartu.eksp-v3
 * @param {Object} card - Card data {id, number, title, badge, iconGradient, content, infoBoxes[], subExpansions[]}
 * @param {string} slideId - Parent slide id
 * @returns {HTMLElement}
 */
function buildCard(card, slideId) {
  const cardEl = document.createElement('div');
  cardEl.className = 'ekspansi-kartu eksp-v3';
  cardEl.id = card.id;

  // ── Header ──
  const header = document.createElement('div');
  header.className = 'ekspansi-header';
  header.setAttribute('onclick', 'toggleEkspansi(this)');

  // Icon
  const icon = document.createElement('div');
  icon.className = 'ekspansi-icon';
  if (card.iconGradient && card.iconGradient.length === 2) {
    icon.style.background = `linear-gradient(135deg, ${card.iconGradient[0]}, ${card.iconGradient[1]})`;
  }
  icon.textContent = card.number;
  header.appendChild(icon);

  // Title
  const title = document.createElement('div');
  title.className = 'ekspansi-title';
  title.textContent = card.title;
  header.appendChild(title);

  // Badge
  if (card.badge) {
    const badge = document.createElement('div');
    badge.className = 'ekspansi-badge';
    badge.textContent = card.badge;
    header.appendChild(badge);
  }

  // Toggle chevron
  const toggle = document.createElement('div');
  toggle.className = 'ekspansi-toggle';
  toggle.innerHTML = '<svg aria-hidden="true" fill="none" focusable="false" height="16" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" width="16"><path d="m6 9 6 6 6-6"/></svg>';
  header.appendChild(toggle);

  cardEl.appendChild(header);

  // ── Body ──
  const body = document.createElement('div');
  body.className = 'ekspansi-body';

  const konten = document.createElement('div');
  konten.className = 'ekspansi-konten';

  // Content HTML (escaped, inserted as HTML since it's trusted generated content)
  if (card.content) {
    konten.innerHTML = card.content;
  }

  // Info boxes
  if (card.infoBoxes && card.infoBoxes.length > 0) {
    card.infoBoxes.forEach(box => {
      konten.appendChild(buildInfoBox(box));
    });
  }

  // Sub-expansions
  if (card.subExpansions && card.subExpansions.length > 0) {
    card.subExpansions.forEach(sub => {
      konten.appendChild(buildSubExpansion(sub));
    });
  }

  // Medical terms within card content
  if (card.terms && card.terms.length > 0) {
    card.terms.forEach(term => {
      const termEl = buildMedicalTerm(term);
      // Append as inline element after content
      konten.appendChild(document.createElement('br'));
      const termLabel = document.createElement('span');
      termLabel.style.fontSize = '0.78rem';
      termLabel.style.color = 'var(--text-muted)';
      termLabel.textContent = 'Istilah: ';
      konten.appendChild(termLabel);
      konten.appendChild(termEl);
    });
  }

  body.appendChild(konten);
  cardEl.appendChild(body);

  return cardEl;
}

/**
 * Builds a sub-expansion: .sub-ekspansi > .sub-header + .sub-body
 * @param {Object} sub - {title, content}
