        terms:Array.isArray(s.terms) ? s.terms : [],
        flashcards:Array.isArray(s.flashcards) ? s.flashcards : []
      }; });
    }
    return qsa(".slide-section").map(function(el,i){
      return {
        id:el.id || ("slide-" + i),
        index:i,
        title:el.getAttribute("data-title") || ("Slide " + i),
        html:el.innerHTML,
        text:text(el),
        quizzes:qsa(".kuis-kartu,.kuis-v3", el).map(function(card, qi){
          var opts = qsa(".kuis-pilihan", card).map(text);
          var answerText = text(qs(".kuis-jawaban", card));
          var m = answerText.match(/Jawaban:\s*([A-E])/i);
          return { id:(el.id || "slide") + "-domq-" + qi, question:text(qs(".kuis-pertanyaan", card)) || text(card).slice(0,180), options:opts, correct:m ? "ABCDE".indexOf(m[1].toUpperCase()) : 0, explanation:answerText };
        })
      };
    });
  }
  function normalizeQuizzes(raw){
    var slides = normalizeSlides(raw);
    var bySlide = {};
    slides.forEach(function(s){ bySlide[s.id] = s.quizzes || []; });
    return bySlide;
  }
  function normalizeFeatures(raw){
    var base = Array.isArray(raw) ? raw : [];
    if (!base.length) base = qsa("#fabMenu .fab-item-wrap").map(function(el,i){
      return { id:el.id || ("fab-" + i), label:text(qs(".fab-item-label", el)) || text(el), action:el.getAttribute("onclick") || "", description:el.getAttribute("title") || "" };
    });
    return base.map(function(f,i){ return { id:f.id || ("feature-" + i), label:f.label || f.title || ("Feature " + (i+1)), action:f.action || f.fn || "", description:f.description || f.desc || "" }; });
  }
  function buildSearchIndex(slides, terms, quizzes){
    if (!Array.isArray(slides)) {
      if (slides && Array.isArray(slides.slides)) slides = normalizeSlides(slides);
      else slides = normalizeSlides(window.SLIDE_DATA || null);
    }
    terms = Array.isArray(terms) ? terms : [];
    quizzes = quizzes || normalizeQuizzes(window.SLIDE_DATA || null);
    var out = [];
    slides.forEach(function(s){ out.push({ type:"slide", slideId:s.id, slideIndex:s.index, title:s.title, body:s.text || strip(s.html) }); });
    Object.keys(quizzes || {}).forEach(function(slideId){ (quizzes[slideId] || []).forEach(function(q,i){ out.push({ type:"quiz", slideId:slideId, title:"Quiz " + (i+1), body:[q.question].concat(q.options || []).join(" ") }); }); });
    (terms || []).forEach(function(t){ out.push({ type:"term", title:t.term || t.istilah || "", body:t.definition || t.arti || t.penjelasan || "" }); });
