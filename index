  showToast(document.body.classList.contains('pen-mode-active') ? '✏️ Mode Stabilo Aktif — pilih teks untuk highlight' : '✏️ Mode Stabilo dimatikan');
}
function applyStabilo() {
  if (!document.body.classList.contains('pen-mode-active')) return;
  var sel = window.getSelection();
  if (!sel || !sel.toString().trim()) return;
  // Skip unwanted elements by checking anchor node parent
  try {
    var anchor = sel.anchorNode && sel.anchorNode.parentElement;
    if (anchor && anchor.closest('input, textarea, button, .baby-modal, #wordBookmarkPopup, .overlay-panel')) return;
  } catch(e) {}
  try {
    var range = sel.getRangeAt(0);
    if (range.startContainer.parentElement.closest('.istilah-medis')) return;
    var span = document.createElement('span');
    span.className = 'highlight-pen';
    span.title = 'Klik 2x untuk hapus stabilo';
    span.ondblclick = function(ev) {
      var p = ev.target;
      var txt = document.createTextNode(p.textContent);
      p.parentNode.replaceChild(txt, p);
    };
    range.surroundContents(span);
    sel.removeAllRanges();
    showToast('✏️ Teks distabilo');
  } catch(e) { /* surround failed (cross-tag) */ }
}
// selectionchange works on BOTH mouse and touchscreen (hold-and-block)
var penDebounceTimer = null;
document.addEventListener('selectionchange', function() {
  if (!document.body.classList.contains('pen-mode-active')) return;
  clearTimeout(penDebounceTimer);
  penDebounceTimer = setTimeout(applyStabilo, 300);
});
// Also keep mouseup for desktop immediate response
document.addEventListener('mouseup', function() {
  if (!document.body.classList.contains('pen-mode-active')) return;
  clearTimeout(penDebounceTimer);
  setTimeout(applyStabilo, 10);
});

