    var topbarZ = Number(getComputedStyle(qs(".topbar") || document.body).zIndex) || Z_INDEX_MAP.topbar;
    var overlayChecks = [
      ["quick-reference", qs("#qrpOverlay"), Z_INDEX_MAP.quickReference],
