  stopStressTimer();
  let benar = 0;
  App.stressSoal.forEach((s, i) => { if (isStressAnswerCorrect(i)) benar++; });
  const pct = Math.round(benar / App.stressSoal.length * 100);

  // Generate understanding map
  const petaHtml = renderPetaPemahaman();

  const body = document.getElementById('stressBody');
  body.innerHTML = '<div style="text-align:center;padding:20px">' +
    '<div style="font-size:3rem;font-weight:800;background:linear-gradient(135deg,var(--accent-teal),var(--accent-cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent">' + pct + '%</div>' +
    '<div style="font-size:1rem;color:var(--text-secondary);margin-bottom:8px">' + benar + ' benar dari ' + App.stressSoal.length + ' soal</div>' +
    '<div style="font-size:0.85rem;color:' + (pct >= 70 ? 'var(--accent-emerald)' : pct >= 50 ? 'var(--accent-amber)' : 'var(--accent-rose)') + ';font-weight:600;margin-bottom:16px">' +
    (pct >= 80 ? '🌟 Luar biasa! Pemahaman sangat baik' : pct >= 60 ? '👍 Bagus, tingkatkan lagi!' : pct >= 40 ? '💪 Perlu latihan lebih' : '📚 Yuk belajar lagi!') + '</div>' +
    '<div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:16px">' +
    '<button class="flash-btn" onclick="reviewWrong()" style="background:var(--accent-rose);color:#fff">Review Salah</button>' +
    '<button class="flash-btn" onclick="mulaiStress()" style="background:linear-gradient(135deg,var(--accent-teal),var(--accent-blue));color:#fff">🔄 Ulangi</button>' +
