  renderTopicChart(data);
}
function renderScoreChart(data) {
  var canvas = document.getElementById('score-trend-chart');
  if (!canvas || !canvas.getContext) return;
  var ctx = canvas.getContext('2d');
  var scores = data.quizScores || [];
  if (!scores.length) { ctx.fillStyle = 'rgba(0,201,255,0.3)'; ctx.font = '13px sans-serif'; ctx.fillText('Belum ada data kuis', 20, 70); return; }
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  var w = canvas.width, h = canvas.height, pad = 20;
  var max = 100, min = 0;
  var pts = scores.slice(-10);
  var step = (w - 2*pad) / Math.max(pts.length - 1, 1);
  ctx.strokeStyle = '#00c9ff'; ctx.lineWidth = 2.5;
  ctx.shadowColor = '#00c9ff'; ctx.shadowBlur = 8;
  ctx.beginPath();
  pts.forEach(function(s, i) {
    var x = pad + i * step;
    var y = h - pad - ((s - min)/(max - min)) * (h - 2*pad);
    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
    ctx.shadowBlur = 0;
    ctx.fillStyle = '#00c9ff';
    ctx.beginPath(); ctx.arc(x, y, 4, 0, Math.PI*2); ctx.fill();
    ctx.beginPath();
    if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
  });
  ctx.stroke();
}
function renderTopicChart(data) {
  var canvas = document.getElementById('topic-chart');
  if (!canvas || !canvas.getContext) return;
  var ctx = canvas.getContext('2d');
  var topics = data.topicPerformance || {};
  var keys = Object.keys(topics).slice(0, 6);
  if (!keys.length) return;
  ctx.clearRect(0, 0, canvas.width, canvas.height);
  var w = canvas.width, h = canvas.height, pad = 20;
  var barW = (w - 2*pad) / keys.length - 4;
  keys.forEach(function(topic, i) {
    var val = topics[topic] || 0;
    var barH = ((val/100) * (h - 2*pad - 20));
    var x = pad + i * ((w - 2*pad)/keys.length) + 2;
    var y = h - pad - barH;
    var g = ctx.createLinearGradient(0, y, 0, h);
    g.addColorStop(0, '#00c9ff'); g.addColorStop(1, 'rgba(0,201,255,0.2)');
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.roundRect ? ctx.roundRect(x, y, barW, barH, 4) : ctx.rect(x, y, barW, barH);
    ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.font = '8px sans-serif'; ctx.textAlign = 'center';
    ctx.fillText((topic||'').substring(0,6), x + barW/2, h - 5);
  });
}

// ===== FEATURE NEW-18: WEAK TOPIC RECOMMENDATIONS =====
function getWeakTopics() {
  var progress = JSON.parse(localStorage.getItem('kuisProgress') || '{}');
