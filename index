function initTooltipIstilah() {
  var istilahList = document.querySelectorAll('.istilah-medis');
  istilahList.forEach(function(el) {
    // Avoid double-binding
    if (el.dataset.babyBound === '1') return;
    el.dataset.babyBound = '1';
    el.setAttribute('tabindex', '0');
    el.setAttribute('role', 'button');
    el.setAttribute('aria-label', 'Buka penjelasan istilah medis');
    // Click + keyboard accessible
    el.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      bukaBabyLang(el);
    });
    el.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        bukaBabyLang(el);
      }
    });
  });
}
function bukaBabyLang(el) {
  var arti = el.getAttribute('data-arti') || 'Belum ada terjemahan';
  var penjelasan = el.getAttribute('data-penjelasan') || 'Belum ada penjelasan lengkap untuk istilah ini.';
  var teksAsli = (el.textContent || '').replace(/🔍/g, '').trim();
  document.getElementById('babyIstilahText').textContent = teksAsli;
  document.getElementById('babyArtiText').textContent = arti;
  document.getElementById('babyPenjelasanText').textContent = penjelasan;
  var overlay = document.getElementById('babyLangOverlay');
  overlay.classList.add('open');
  // Store last opened term for bookmark button
  overlay.dataset.lastTerm = teksAsli;
  overlay.dataset.lastArti = arti;
  // Lock background scroll
  document.body.style.overflow = 'hidden';
}
function tutupBabyLang() {
  document.getElementById('babyLangOverlay').classList.remove('open');
  document.body.style.overflow = '';
}
function bookmarkIstilahDariBaby() {
  var overlay = document.getElementById('babyLangOverlay');
  var term = overlay.dataset.lastTerm;
  var arti = overlay.dataset.lastArti;
  if (!term) return;
  var stored = JSON.parse(localStorage.getItem('atlas-kata-bookmark') || '[]');
  // Dedupe
  if (stored.some(function(s) { return s.text === term; })) {
    showToast('✓ Sudah ada di bookmark');
    return;
  }
  stored.unshift({
    text: term,
    context: '→ ' + arti,
    slide: App.slideAktif || 0,
    tanggal: new Date().toLocaleDateString('id-ID', { day: '2-digit', month: 'short' })
  });
  if (stored.length > 100) stored = stored.slice(0, 100);
  localStorage.setItem('atlas-kata-bookmark', JSON.stringify(stored));
  showToast('🔖 Tersimpan ke Bookmark Kata');
}
