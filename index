.fab-menu.open .fab-item:nth-last-child(2) { transition-delay: 0.05s; }
.fab-menu.open .fab-item:nth-last-child(3) { transition-delay: 0.10s; }
.fab-menu.open .fab-item:nth-last-child(4) { transition-delay: 0.15s; }
.fab-menu.open .fab-item:nth-last-child(5) { transition-delay: 0.20s; }
.fab-menu.open .fab-item:nth-last-child(6) { transition-delay: 0.25s; }
.fab-menu.open .fab-item:nth-last-child(7) { transition-delay: 0.30s; }
.fab-menu.open .fab-item:nth-last-child(8) { transition-delay: 0.35s; }
.fab-menu.open .fab-item:nth-last-child(9) { transition-delay: 0.40s; }
.fab-menu.open .fab-item:nth-last-child(10) { transition-delay: 0.45s; }
.fab-menu.open .fab-item:nth-last-child(11) { transition-delay: 0.50s; }


