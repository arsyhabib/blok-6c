function bangunBankSoal() {
  // Extract all quiz questions from DOM
  const slides = document.querySelectorAll('.slide-section');
  App.bankSoal = [];
  var soalFallback = (typeof SOAL_STRESS_FALLBACK !== 'undefined') ? SOAL_STRESS_FALLBACK : [];
  slides.forEach((slide, si) => {
    const kuiss = slide.querySelectorAll('.kuis-kartu');
    kuiss.forEach(kuis => {
      const pertanyaan = (kuis.querySelector('.kuis-pertanyaan') ? kuis.querySelector('.kuis-pertanyaan').textContent : '').trim();
      const pilihanEls = kuis.querySelectorAll('.kuis-pilihan');
      const pilihan = Array.from(pilihanEls).map(p => p.textContent.trim());
      const jawabanEl = kuis.querySelector('.kuis-jawaban');
      const jawabanMatch = jawabanEl ? jawabanEl.textContent.match(/Jawaban:\s*([A-D])/) : null;
      const jawaban = jawabanMatch ? jawabanMatch[1] : 'A';
      const penjelasan = jawabanEl ? jawabanEl.textContent.trim() : '';
      if (pertanyaan && pilihan.length >= 2) {
        App.bankSoal.push(normalizeStressQuestion({ pertanyaan, pilihan, jawaban, penjelasan, slide: si }));
      }
    });
  });
  if (App.bankSoal.length < 20 && soalFallback.length > 0) {
    var needed = 20 - App.bankSoal.length;
    var shuf = soalFallback.sort(function(){return Math.random()-0.5;});
    for (var fi=0; fi<needed && fi<shuf.length; fi++) App.bankSoal.push(normalizeStressQuestion(shuf[fi]));
  }
}


// ===== STRESS TEST TIMER =====
var stressTimerInterval = null;
var stressTimeRemaining = 900; // 15 menit = 900 detik

function startStressTimer() {
  stressTimeRemaining = 900; // reset
  updateStressTimerDisplay();
  if (stressTimerInterval) clearInterval(stressTimerInterval);
  stressTimerInterval = setInterval(function() {
    stressTimeRemaining--;
    updateStressTimerDisplay();
    if (stressTimeRemaining <= 0) {
      clearInterval(stressTimerInterval);
      showToast('Waktu habis!');
      selesaiStressWithMap();
    }
  }, 1000);
}
function updateStressTimerDisplay() {
  var m = Math.floor(stressTimeRemaining / 60);
  var s = stressTimeRemaining % 60;
  var txt = (m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s;
  // Update BOTH timer displays (legacy + new visible one)
  var timerEl = document.getElementById('stressTimerDisplay');
  var stressTimerBox = document.getElementById('stressTimer');
  if (timerEl) timerEl.textContent = txt;
  if (stressTimerBox) {
    stressTimerBox.classList.remove('warning', 'danger');
    if (stressTimeRemaining <= 60) stressTimerBox.classList.add('danger');
    else if (stressTimeRemaining <= 300) stressTimerBox.classList.add('warning');
  }
}
function stopStressTimer() {
  if (stressTimerInterval) {
    clearInterval(stressTimerInterval);
    stressTimerInterval = null;
  }
}

var STRESS_OPTION_KEYS = ['A', 'B', 'C', 'D', 'E', 'F'];

function stressKeyFromIndex(index) {
  return STRESS_OPTION_KEYS[index] || String(index + 1);
}

function cleanStressChoiceText(choice) {
  return String(choice || '').replace(/^\s*[A-Z]\s*[\.\)\-:]\s*/i, '').trim();
}

function normalizeStressAnswer(value, pilihan) {
  if (value === undefined || value === null || value === '') return '';
  if (typeof value === 'number' && isFinite(value)) return stressKeyFromIndex(value);

  var raw = String(value).trim();
  var labeled = raw.match(/jawaban\s*:\s*([A-Z])/i);
  if (labeled) return labeled[1].toUpperCase();

  var letterOnly = raw.match(/^([A-Z])$/i);
  if (letterOnly) return letterOnly[1].toUpperCase();

  var prefixed = raw.match(/^([A-Z])\s*[\.\)\-:]\s+/i);
  if (prefixed) return prefixed[1].toUpperCase();

  var rawText = cleanStressChoiceText(raw).toLowerCase();
  if (Array.isArray(pilihan)) {
    for (var i = 0; i < pilihan.length; i++) {
      if (cleanStressChoiceText(pilihan[i]).toLowerCase() === rawText) {
        return stressKeyFromIndex(i);
      }
    }
  }

  return '';
}

function normalizeStressQuestion(soal) {
  var normalized = Object.assign({}, soal || {});
  normalized.pilihan = Array.isArray(normalized.pilihan) ? normalized.pilihan.map(function(choice, idx) {
    return cleanStressChoiceText(choice) || ('Pilihan ' + stressKeyFromIndex(idx));
  }) : [];
  normalized.jawaban = normalizeStressAnswer(normalized.jawaban, normalized.pilihan) || 'A';
  return normalized;
}

function stressCorrectKey(soal) {
  return normalizeStressAnswer(soal && soal.jawaban, soal && soal.pilihan) || 'A';
}

function isStressAnswerCorrect(index) {
  var soal = App.stressSoal && App.stressSoal[index];
  if (!soal || !App.stressJawaban || !App.stressJawaban[index]) return false;
  return normalizeStressAnswer(App.stressJawaban[index], soal.pilihan) === stressCorrectKey(soal);
}

function mulaiStress() {
  if (App.bankSoal.length === 0) { App.bankSoal = (typeof SOAL_STRESS_FALLBACK !== 'undefined') ? SOAL_STRESS_FALLBACK : []; }
  if (App.bankSoal.length === 0) { showToast('Bank soal kosong'); return; }
  // Shuffle and pick 20
  const shuffled = [...App.bankSoal].sort(() => Math.random() - 0.5).slice(0, 20).map(normalizeStressQuestion);
  App.stressSoal = shuffled;
  App.stressIndex = 0;
  App.stressJawaban = {};
  App.stressMarked = {};
  App.stressMenit = 15;

  // SHOW timer
  var stressTimerEl = document.getElementById('stressTimer');
  if (stressTimerEl) stressTimerEl.style.display = 'block';
  // Start countdown
  startStressTimer();
  renderStressSoal();
}

function renderStressSoal() {
  const body = document.getElementById('stressBody');
  const soal = App.stressSoal[App.stressIndex];
  const choices = Array.isArray(soal.pilihan) ? soal.pilihan : [];
  const correctKey = stressCorrectKey(soal);
  const storedAnswer = normalizeStressAnswer(App.stressJawaban[App.stressIndex], choices);

  let html = '<div style="margin-bottom:12px"><span style="font-size:0.8rem;color:var(--text-muted)">Soal ' + (App.stressIndex+1) + ' dari ' + App.stressSoal.length + '</span></div>';
  html += '<div style="font-weight:600;margin-bottom:16px;font-size:0.95rem">' + soal.pertanyaan + '</div>';

  choices.forEach((p, i) => {
    const huruf = stressKeyFromIndex(i);
    const sudahJawab = !!storedAnswer;
    let kelas = 'kuis-pilihan';
    if (sudahJawab) {
      kelas += ' nonaktif';
      if (huruf === correctKey) kelas += ' benar';
      if (huruf === storedAnswer && huruf !== correctKey) kelas += ' salah';
    }
    html += '<button class="' + kelas + '" onclick="jawabStress(' + i + ')" ' + (sudahJawab ? 'disabled' : '') + '>' +
      '<span style="display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:50%;margin-right:10px;background:var(--bg-card);font-weight:800;font-size:0.8rem">' + huruf + '</span>' +
      '<span>' + p + '</span></button>';
  });

  // Explanation if answered
  if (App.stressJawaban[App.stressIndex]) {
    html += '<div class="kuis-jawaban buka">' + soal.penjelasan + '</div>';
  }

  // Navigation dots for all questions
  html += '<div class="stress-nav-dots">';
  for (let i = 0; i < App.stressSoal.length; i++) {
    let dotClass = 'stress-dot';
    if (i === App.stressIndex) dotClass += ' current';
    else if (App.stressJawaban[i]) {
      dotClass += isStressAnswerCorrect(i) ? ' answered' : ' wrong';
    }
    if (App.stressMarked[i]) dotClass += ' marked';
    html += '<button class="' + dotClass + '" onclick="goToStressSoal(' + i + ')" title="Soal ' + (i+1) + '">' + (i+1) + '</button>';
  }
  html += '</div>';

  // Mark for review button
  const isMarked = App.stressMarked[App.stressIndex] || false;
  html += '<div style="text-align:center;margin-bottom:8px">';
  html += '<button class="mark-btn' + (isMarked ? ' marked' : '') + '" onclick="toggleMarkStress()">' + (isMarked ? '&#9733; Tandai Review' : '&#9734; Tandai Review') + '</button>';
  html += '</div>';

  // Navigation
  html += '<div style="display:flex;gap:8px;margin-top:12px;justify-content:center;flex-wrap:wrap">';
  if (App.stressIndex > 0) html += '<button class="flash-btn" onclick="prevStress()">&#9664; Sebelumnya</button>';
  html += '<button class="flash-btn" onclick="reviewMarked()" style="background:var(--accent-amber);color:#fff">Review Tandai</button>';
  html += '<button class="flash-btn" onclick="reviewWrong()" style="background:var(--accent-rose);color:#fff">Review Salah</button>';
  if (App.stressIndex < App.stressSoal.length - 1) html += '<button class="flash-btn" onclick="nextStress()">Berikutnya &#9654;</button>';
  else html += '<button class="flash-btn" onclick="selesaiStressWithMap()" style="background:linear-gradient(135deg,var(--accent-emerald),var(--accent-teal));color:#fff">Selesai</button>';
  html += '</div>';

  body.innerHTML = html;
}

function jawabStress(pilihanIdx) {
  const soal = App.stressSoal[App.stressIndex];
  if (!soal || !Array.isArray(soal.pilihan) || pilihanIdx < 0 || pilihanIdx >= soal.pilihan.length) return;
  const huruf = stressKeyFromIndex(pilihanIdx);
  App.stressJawaban[App.stressIndex] = huruf;
  renderStressSoal();
}
function nextStress() { if (App.stressIndex < App.stressSoal.length - 1) { App.stressIndex++; renderStressSoal(); } }
function prevStress() { if (App.stressIndex > 0) { App.stressIndex--; renderStressSoal(); } }

function goToStressSoal(idx) {
  if (idx >= 0 && idx < App.stressSoal.length) {
    App.stressIndex = idx;
    renderStressSoal();
  }
}
function toggleMarkStress() {
  App.stressMarked[App.stressIndex] = !App.stressMarked[App.stressIndex];
  renderStressSoal();
}
function reviewMarked() {
  const markedIdx = [];
  for (let i = 0; i < App.stressSoal.length; i++) {
    if (App.stressMarked[i]) markedIdx.push(i);
  }
  if (markedIdx.length === 0) { showToast('Tidak ada soal yang ditandai'); return; }
  // Go to first marked
  goToStressSoal(markedIdx[0]);
  showToast(markedIdx.length + ' soal ditandai');
}
function reviewWrong() {
  const wrongIdx = [];
  for (let i = 0; i < App.stressSoal.length; i++) {
    if (App.stressJawaban[i] && !isStressAnswerCorrect(i)) wrongIdx.push(i);
  }
  if (wrongIdx.length === 0) { showToast('Tidak ada soal yang salah'); return; }
  goToStressSoal(wrongIdx[0]);
  showToast(wrongIdx.length + ' soal salah');
}

function selesaiStress() {
  stopStressTimer();
  let benar = 0;
  App.stressSoal.forEach((s, i) => { if (isStressAnswerCorrect(i)) benar++; });
  const pct = Math.round(benar / App.stressSoal.length * 100);

  const body = document.getElementById('stressBody');
  body.innerHTML = '<div style="text-align:center;padding:20px">' +
    '<div style="font-size:3rem;font-weight:800;background:linear-gradient(135deg,var(--accent-teal),var(--accent-cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent">' + pct + '%</div>' +
    '<div style="font-size:1.1rem;margin:12px 0">' + benar + ' benar dari ' + App.stressSoal.length + ' soal</div>' +
    '<div style="color:var(--text-muted);font-size:0.85rem;margin-bottom:20px">' + (pct >= 80 ? 'Luar biasa! Kamu sudah menguasai materi ini.' : pct >= 60 ? 'Bagus! Tingkatkan lagi belajarnya.' : 'Jangan menyerah! Pelajari lagi materi-materinya.') + '</div>' +
    '<button class="welcome-btn" onclick="mulaiStress()" style="padding:10px 24px;font-size:0.85rem;margin-right:8px">Ulangi</button>' +
    '<button class="flash-btn" onclick="tutupStress()">Tutup</button></div>';
}


