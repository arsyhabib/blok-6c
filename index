var pomoState = { running: false, secs: 25 * 60, interval: null, isBreak: false };
function tampilPomodoro() {
  document.getElementById('pomodoroMini').classList.add('show');
  updatePomodoroDisplay();
}
function tutupPomodoro() {
  document.getElementById('pomodoroMini').classList.remove('show');
  if (pomoState.interval) { clearInterval(pomoState.interval); pomoState.interval = null; }
  pomoState.running = false;
}
function togglePomodoro() {
  if (pomoState.running) {
    clearInterval(pomoState.interval);
    pomoState.running = false;
    document.getElementById('pomoBtn').textContent = '▶';
  } else {
    pomoState.running = true;
    document.getElementById('pomoBtn').textContent = '⏸';
    pomoState.interval = setInterval(function() {
      pomoState.secs--;
      if (pomoState.secs <= 0) {
        clearInterval(pomoState.interval);
        pomoState.running = false;
        if (pomoState.isBreak) {
          pomoState.secs = 25 * 60;
          pomoState.isBreak = false;
          showToast('⏰ Sesi fokus selesai!');
        } else {
          pomoState.secs = 5 * 60;
          pomoState.isBreak = true;
          showToast('☕ Saatnya istirahat 5 menit');
        }
        document.getElementById('pomoBtn').textContent = '▶';
      }
      updatePomodoroDisplay();
    }, 1000);
  }
}
function resetPomodoro() {
  if (pomoState.interval) clearInterval(pomoState.interval);
  pomoState.running = false;
  pomoState.secs = pomoState.isBreak ? 5 * 60 : 25 * 60;
  document.getElementById('pomoBtn').textContent = '▶';
  updatePomodoroDisplay();
}
function updatePomodoroDisplay() {
  var m = Math.floor(pomoState.secs / 60);
  var s = pomoState.secs % 60;
  var el = document.getElementById('pomoTime');
  if (el) el.textContent = (m < 10 ? '0' + m : m) + ':' + (s < 10 ? '0' + s : s);
}

