    var report = {
      generatedAt:new Date().toISOString(),
      slides:slides.length,
      activeSlideValid:!!qs("#slide-" + ((window.App && App.slideAktif) || 0)),
      roots:{
        sidebar:!!qs("#sidebar"), topbar:!!qs(".topbar"), slideContainer:!!qs("#slideContainer"),
        quickReference:!!qs("#qrpOverlay"), splitScreen:true, quizRecall:!!qs("#kuisSlideOverlay"),
