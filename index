  function validateAppData(data){
    var warnings = [];
    var ids = {};
    data.slides.forEach(function(s){ if(!s.id) warnings.push("Slide tanpa ID"); ids[s.id]=(ids[s.id]||0)+1; });
    Object.keys(ids).forEach(function(id){ if(ids[id] > 1) warnings.push("Duplicate slide id: " + id); });
    if(!data.slides.length) warnings.push("Tidak ada slide");
    if(!data.features.length) warnings.push("Feature registry kosong");
    if(!data.searchIndex.length) warnings.push("Search index kosong");
    return { ok: warnings.length === 0, warnings:warnings };
  }

  function normalizeFabLabels(){
    var shortMap = {
      "Quick Reference Panel":"Quick Reference",
      "Dashboard Progress":"Dashboard",
      "Penanda / Bookmark":"Bookmark",
      "Catatan Belajar":"Catatan",
      "Export / Print PDF":"Export PDF",
      "Mode Fokus Penuh":"Mode Fokus",
      "Identitas Pengguna":"Identitas"
    };
    qsa("#fabMenu .fab-item-label").forEach(function(label){
      var old = text(label);
      if (shortMap[old]) label.textContent = shortMap[old];
