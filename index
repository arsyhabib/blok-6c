      if (!mappedMasteryVectors[conceptId]) {
        mappedMasteryVectors[conceptId] = { strengthScore: 50, verificationCounts: 0, epochLastUpdated: Date.now() };
      }
      var operationalVectorNode = mappedMasteryVectors[conceptId];
      operationalVectorNode.verificationCounts += 1;
      var modifierDirection = isCorrect ? 6.5 : -4.2;
      operationalVectorNode.strengthScore = Math.min(100, Math.max(0, operationalVectorNode.strengthScore + (modifierDirection * proficiencyScoreDelta)));
      operationalVectorNode.epochLastUpdated = Date.now();
      mappedMasteryVectors[conceptId] = operationalVectorNode;
