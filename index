      si.addEventListener('input', function(){ if(typeof lakukanPencarian==='function') lakukanPencarian(this.value); });
      si.addEventListener('keydown', function(e){ if(e.key==='Enter'&&typeof lakukanPencarian==='function') lakukanPencarian(this.value); });
      si._searchBound = true;
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function(){ setTimeout(ensureSearchWorks, 1500); });
  } else { setTimeout(ensureSearchWorks, 1500); }
})();
</script>


<script>
// ===== MOBILE LAYOUT VACCINE =====
(function mobileVaccine(){
  const isTouch = window.matchMedia('(pointer: coarse)').matches;
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
  const isAndroid = /Android/.test(navigator.userAgent);

  // 1. Dynamic viewport height fix
  function setVh() {
    const vh = window.innerHeight * 0.01;
    document.documentElement.style.setProperty('--vh', vh + 'px');
  }
  setVh();
  window.addEventListener('resize', setVh);
  window.addEventListener('orientationchange', () => setTimeout(setVh, 100));

  // 2. Keyboard detection for overlay
  if (isIOS) {
    const originalHeight = window.innerHeight;
    window.addEventListener('resize', () => {
      const currentHeight = window.innerHeight;
      const keyboardOpen = originalHeight - currentHeight > 150;
      document.body.classList.toggle('keyboard-open', keyboardOpen);
      const cariOverlay = document.querySelector('.cari-overlay');
      if (cariOverlay && keyboardOpen) {
        cariOverlay.style.alignItems = 'flex-start';
        cariOverlay.style.paddingTop = '20px';
      } else if (cariOverlay) {
        cariOverlay.style.alignItems = '';
        cariOverlay.style.paddingTop = '';
      }
    });
  }

  // 3. Double-tap to zoom prevention
  if (isTouch) {
    document.querySelectorAll('.ekspansi-header, .kuis-pilihan, .sub-header, .fab-item, .aksi-cell, .nav-link').forEach(el => {
      el.addEventListener('touchstart', function(){}, {passive: true});
    });
  }

  // 4. Swipe gesture for sidebar
  let touchStartX = 0;
  let touchEndX = 0;
  const sidebar = document.getElementById('sidebar');

  document.addEventListener('touchstart', e => {
    touchStartX = e.changedTouches[0].screenX;
  }, {passive: true});

  document.addEventListener('touchend', e => {
    touchEndX = e.changedTouches[0].screenX;
    const swipeThreshold = 80;
    const isMobile = window.innerWidth <= 1024;
    if (!isMobile || !sidebar) return;
    // Swipe right from edge to open
    if (touchEndX - touchStartX > swipeThreshold && touchStartX < 30) {
      sidebar.classList.add('mobile-buka');
      document.body.style.overflow = 'hidden';
    }
    // Swipe left to close
    if (touchStartX - touchEndX > swipeThreshold && sidebar.classList.contains('mobile-buka')) {
      sidebar.classList.remove('mobile-buka');
      document.body.style.overflow = '';
    }
  }, {passive: true});

  console.log('[MOBILE VACCINE] Applied. Touch:', isTouch, 'iOS:', isIOS, 'Android:', isAndroid);
})();
</script>


<script>
// ===== QUIZ FEEDBACK OVERRIDE (FIX #14A) =====
// Wrap existing jawabKuis to inject our visual feedback
(function(){
  const _origJawabKuis = window.jawabKuis;
  if (_origJawabKuis) {
    window.jawabKuis = function(soalIndex, opsiIndex, slideIndex) {
      // Call original
      const result = _origJawabKuis(soalIndex, opsiIndex, slideIndex);
      // Apply unified visual feedback
      setTimeout(function(){
        const container = document.querySelector('.kuis-recall-container');
        if (!container) return;
        // Find the option that was clicked
        const allOpts = container.querySelectorAll('.kuis-recall-option');
        // Remove old classes
        allOpts.forEach(opt => {
          opt.classList.remove('benar','salah','pilih');
          opt.style.pointerEvents = 'none';
        });
        // Get correct answer index
        const panelBenar = container.querySelector('.kuis-recall-panel-benar');
        const panelSalah = container.querySelector('.kuis-recall-panel-salah');
        const isBenar = panelBenar && panelBenar.style.display !== 'none';
        // Mark selected
        if (allOpts[opsiIndex]) allOpts[opsiIndex].classList.add(isBenar ? 'benar' : 'salah');
        // Find and mark correct answer
        if (!isBenar) {
          // Need to find which one is correct - check quiz data
          const slide = window.SLIDE_DATA && window.SLIDE_DATA.slides ? window.SLIDE_DATA.slides[slideIndex] : null;
          if (slide && slide.quizzes && slide.quizzes[soalIndex]) {
            const correctIdx = slide.quizzes[soalIndex].correct;
            if (allOpts[correctIdx]) allOpts[correctIdx].classList.add('benar');
          }
        }
        // Style panels
        if (panelBenar) {
          panelBenar.style.padding = '16px 20px';
          panelBenar.style.borderRadius = '12px';
          panelBenar.style.borderLeft = '4px solid var(--accent-emerald)';
          panelBenar.style.background = 'rgba(52,211,153,0.1)';
        }
        if (panelSalah) {
          panelSalah.style.padding = '16px 20px';
          panelSalah.style.borderRadius = '12px';
          panelSalah.style.borderLeft = '4px solid var(--accent-rose)';
          panelSalah.style.background = 'rgba(251,113,133,0.1)';
        }
      }, 100);
      return result;
    };
    console.log('[QUIZ] jawabKuis wrapped with visual feedback');
  } else {
    console.warn('[QUIZ] jawabKuis not found for wrapping');
  }
})();
</script>


